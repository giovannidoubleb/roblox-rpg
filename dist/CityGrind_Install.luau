			UI.label({ Text = vol[3], Font = UI.FONT_BOLD, TextSize = 14, Size = UDim2.new(1, -120, 1, 0), Parent = volCard })
			UI.label({
				Text = math.floor(value * 100 + 0.5) .. "%",

  <Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string></Properties></Item>
  <Item class="ReplicatedStorage" referent="RBX00000002"><Properties><string name="Name">ReplicatedStorage</string></Properties>
    <Item class="Folder" referent="RBX00000003">

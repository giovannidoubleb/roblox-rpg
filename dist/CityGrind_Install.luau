local pulsing = false
local function setPulse(on: boolean)
	if on == pulsing then
		return
	end
	pulsing = on
	for i, ring in rings do
		local tween = ringTweens[i]
		if on then
			ring.Visible = true
			tween:Play()
		else
			tween:Cancel()
			ring.Visible = false

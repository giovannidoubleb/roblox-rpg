	slot: number,
	lap: number,
	next: number,
	dist: number,
	finished: boolean,
	dnf: boolean,
	reason: string?,
	time: number,
	place: number,
	lastPos: Vector3,
	lastT: number,
	strikes: number,
	offSince: number?,
	lastWarn: number,
	lapStart: number,
	bestLap: number,
	reward: { [string]: any }?,
	grid: CFrame?, -- where freezeAt parked the car for the countdown
}
type Race = {
	id: string,
	kind: string,
	name: string,
	routeId: string?,
	laps: number,
	cps: { CP },
	list: { Racer },
	phase: string,
	goT: number,
	starters: number,

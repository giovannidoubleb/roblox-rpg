{
  "name": "city-grind",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "CityGrind": {
        "$className": "Folder",
        "Config": {
          "$path": "src/shared/Config.luau"
        }
      }
    },
    "ServerScriptService": {
      "CityGrindServer": {
        "$path": "src/server/Main.server.luau",
        "Basketball": {
          "$path": "src/server/Basketball.luau"
        },
        "CityBuilder": {
          "$path": "src/server/CityBuilder.luau"
        },
        "CourtGames": {
          "$path": "src/server/CourtGames.luau"
        },
        "Net": {
          "$path": "src/server/Net.luau"
        },
        "Places": {
          "$path": "src/server/Places.luau"
        },
        "PlayerData": {
          "$path": "src/server/PlayerData.luau"
        }
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "CityGrindClient": {
          "$path": "src/client/Client.client.luau",
          "Basketball": {
            "$path": "src/client/Basketball.luau"
          },
          "HUD": {
            "$path": "src/client/HUD.luau"
          },
          "Movement": {
            "$path": "src/client/Movement.luau"
          },
          "Phone": {
            "$path": "src/client/Phone.luau"
          },
          "UI": {
            "$path": "src/client/UI.luau"
          }
        }
      }
    }
  }
}

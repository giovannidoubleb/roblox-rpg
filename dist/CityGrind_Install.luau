	meter = UI.new("Frame", { Name = "Meter", BackgroundColor3 = Color3.fromRGB(40, 40, 50), ClipsDescendants = false, Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 30), Parent = panel }, { UI.corner(8) })

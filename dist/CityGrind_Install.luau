put(server, 'ModuleScript', 'CrewBattles', [=====[
-- CITY GRIND: crew battles (section 62). Server side.
--
-- A crew Leader / Officer challenges another crew to a format (Basketball,
-- Racing, Running, Treasure Hunt, City Challenge + metric). A Leader / Officer
-- of the other crew accepts within 2 minutes (on any server: challenges, accepts,
-- scores and results travel over MessagingService, best effort; without it
-- battles work between crews on this server). After a 30 s countdown the
-- battle window runs; every server scores its own online members of both
-- crews from real activity (see CrewBattlesConfig descriptions) and shares its
-- totals every 10 s. The challenger's server ("host") finalizes: Elo-like
-- crew rating change (start 1000, K 32) in DataStore "CityGrind_CrewRating_v1"
-- (each battle id applied once per crew), Leaderboards.submitCrew, weekly
-- City Crew Cup points (OrderedDataStore "CityGrind_CrewCup_v1_W<week>"), and
-- rewards for members who took part. Last week's top 3 cup crews' members who
-- battled for them that week collect a cup reward on their next visit.
--
-- Remotes: CrewBattleRequest (RemoteFunction): (action, args) -> { ok, msg }
--            actions "Challenge" {target, format, metric?}, "Accept" id, "Decline" id, "Cancel" id
--          CrewBattleGet (RemoteFunction): () -> snapshot for the phone app
--          CrewBattleEvent (RemoteEvent, server -> client): ("changed") ("live", chip | nil) ("result", card)
-- Player attribute: CrewBattle (battle id while their crew is in a countdown / live battle, else nil)
-- Saved section "crewBattles" = { played, wins, mvps, cupWeeks = { ["<week>"] = crewId }, cupClaimed, rewardDay, rewardCount }

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = require(script.Parent:WaitForChild("Net"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local AntiCheat = require(script.Parent:WaitForChild("AntiCheat"))
local shared = ReplicatedStorage:WaitForChild("CityGrind")
local CB = require(shared:WaitForChild("CrewBattlesConfig"))
local SPRINT_CREDIT = require(shared:WaitForChild("Config")).SPRINT_SPEED * 1.15 -- studs/s of distance credit

local CrewBattles = {}

local SERVER_ID = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)
local TOPIC = "CityGrindCrewBattles"
local IS_STUDIO = RunService:IsStudio()

local CrewBattleRequest = Net.remote("RemoteFunction", "CrewBattleRequest")
local CrewBattleGet = Net.remote("RemoteFunction", "CrewBattleGet")
local CrewBattleEvent = Net.remote("RemoteEvent", "CrewBattleEvent")

PlayerData.registerSection("crewBattles", function()
	return { played = 0, wins = 0, mvps = 0, cupWeeks = {}, cupClaimed = -1, rewardDay = 0, rewardCount = 0 }
end)

local function now(): number
	return os.time()
end

local function optional(name: string): any
	local m = script.Parent:FindFirstChild(name)
	if not m then
		return nil
	end
	local ok, mod = pcall(require, m)
	return if ok then mod else nil
end

---------------------------------------------------------------------------
-- Crew helpers
---------------------------------------------------------------------------
type Side = { id: string, name: string, tag: string, color: Color3 }

local function crewOf(player: Player): any
	local Crews = optional("Crews")
	if not Crews or type(Crews.crewOf) ~= "function" then
		return nil
	end
	local ok, c = pcall(Crews.crewOf, player)
	return if ok and type(c) == "table" then c else nil
end

local function isOfficer(c: any): boolean
	return c ~= nil and (c.role == "Leader" or c.role == "Officer")
end

local function membersHere(crewId: string): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("CrewId") == crewId then
			table.insert(list, p)
		end
	end
	return list
end

local crewNames: { [string]: string } = {}

---------------------------------------------------------------------------
-- DataStores (ratings, weekly cup)
---------------------------------------------------------------------------
local storesOk = true
local ratingStore: DataStore? = nil
local cupStores: { [number]: OrderedDataStore } = {}

local function noteFailure(err: any)
	local msg = tostring(err)
	if IS_STUDIO or msg:find("403") or msg:find("API") or msg:find("Studio") then
		if storesOk then
			warn("[CityGrind] CrewBattles: DataStores unavailable, ratings and the cup are kept for this server only.", msg)
		end
		storesOk = false
	end
end

do
	local ok, err = pcall(function()
		ratingStore = DataStoreService:GetDataStore("CityGrind_CrewRating_v1")
	end)
	if not ok then
		noteFailure(err)
	end
end

local function budget(kind: Enum.DataStoreRequestType): boolean
	local ok, n = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(kind)
	end)
	return ok and n > 4
end

local function cupStore(week: number): OrderedDataStore?
	if not storesOk then
		return nil
	end
	if cupStores[week] then
		return cupStores[week]
	end
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore("CityGrind_CrewCup_v1_W" .. week)
	end)
	if not ok then
		noteFailure(result)
		return nil
	end
	cupStores[week] = result
	return result
end

type RatingRec = { rating: number, wins: number, losses: number, draws: number, name: string?, vs: { any }? }
local ratings: { [string]: RatingRec } = {}
local ratingLoading: { [string]: boolean } = {}
local cupMem: { [number]: { [string]: number } } = {} -- week -> crewId -> points (this server's view / fallback)

local function blankRating(): RatingRec
	return { rating = CB.START_RATING, wins = 0, losses = 0, draws = 0 }
end

local function submitCrew(crewId: string, rec: RatingRec)
	local LB = optional("Leaderboards")
	if LB and type(LB.submitCrew) == "function" then
		pcall(LB.submitCrew, crewId, crewNames[crewId] or rec.name or "Crew", rec.rating)
	end
end

local function loadRating(crewId: string, fresh: boolean?): RatingRec
	if ratings[crewId] and not fresh then
		return ratings[crewId]
	end
	if ratingStore and storesOk and budget(Enum.DataStoreRequestType.GetAsync) then
		local ok, result = pcall(function()
			return (ratingStore :: DataStore):GetAsync("crew_" .. crewId)
		end)
		if ok then
			local rec = blankRating()
			if type(result) == "table" then
				rec.rating = tonumber(result.rating) or CB.START_RATING
				rec.wins = tonumber(result.wins) or 0
				rec.losses = tonumber(result.losses) or 0
				rec.draws = tonumber(result.draws) or 0
				rec.name = if type(result.name) == "string" then result.name else nil
				rec.vs = if type(result.vs) == "table" then result.vs else nil
				if rec.name and not crewNames[crewId] then
					crewNames[crewId] = rec.name
				end
			end
			ratings[crewId] = rec
			return rec
		end
		noteFailure(result)
	end
	ratings[crewId] = ratings[crewId] or blankRating()
	return ratings[crewId]
end

-- Public: a crew's rating (cached; loads in the background the first time).
function CrewBattles.ratingOf(crewId: string): number
	if type(crewId) ~= "string" or crewId == "" then
		return CB.START_RATING
	end
	local rec = ratings[crewId]
	if rec then
		return rec.rating
	end
	if not ratingLoading[crewId] then
		ratingLoading[crewId] = true
		task.spawn(function()
			local r = loadRating(crewId)
			ratingLoading[crewId] = nil
			submitCrew(crewId, r)
		end)
	end
	return CB.START_RATING
end

-- Applies one battle's result to a crew record once (battle id remembered). Returns the new record.
local function applyResult(crewId: string, battleId: string, delta: number, outcome: string, opponentId: string): (RatingRec, boolean)
	local applied = false
	local function bump(rec: any)
		rec.rating = math.max(100, math.floor((tonumber(rec.rating) or CB.START_RATING) + delta + 0.5))
		if outcome == "win" then
			rec.wins = (tonumber(rec.wins) or 0) + 1
		elseif outcome == "loss" then
			rec.losses = (tonumber(rec.losses) or 0) + 1
		else
			rec.draws = (tonumber(rec.draws) or 0) + 1
		end
	end
	if ratingStore and storesOk then
		local ok, result = pcall(function()
			return (ratingStore :: DataStore):UpdateAsync("crew_" .. crewId, function(old)
				local rec = if type(old) == "table" then old else { rating = CB.START_RATING, wins = 0, losses = 0, draws = 0 }
				rec.applied = if type(rec.applied) == "table" then rec.applied else {}
				if table.find(rec.applied, battleId) then
					applied = false
					return nil -- another server already applied this battle
				end
				applied = true
				bump(rec)
				rec.name = crewNames[crewId] or rec.name
				table.insert(rec.applied, battleId)
				while #rec.applied > 30 do
					table.remove(rec.applied, 1)
				end
				-- rated battles of the last 24 h by opponent (anti-farming pair limit)
				local vs = {}
				if type(rec.vs) == "table" then
					for _, e in rec.vs do
						if type(e) == "table" and type(e.t) == "number" and os.time() - e.t < 86400 then
							table.insert(vs, e)
						end
					end
				end
				table.insert(vs, { o = opponentId, t = os.time() })
				while #vs > 40 do
					table.remove(vs, 1)
				end
				rec.vs = vs
				return rec
			end)
		end)
		if ok then
			if type(result) == "table" then
				local rec = blankRating()
				rec.rating = tonumber(result.rating) or CB.START_RATING
				rec.wins = tonumber(result.wins) or 0
				rec.losses = tonumber(result.losses) or 0
				rec.draws = tonumber(result.draws) or 0
				rec.name = result.name
				rec.vs = if type(result.vs) == "table" then result.vs else nil
				ratings[crewId] = rec
			end
			return ratings[crewId] or blankRating(), applied
		end
		noteFailure(result)
	end
	-- in memory (Studio / DataStore down)
	local rec = ratings[crewId] or blankRating()
	ratings[crewId] = rec
	bump(rec)
	return rec, true
end

local function addCupPoints(crewId: string, points: number)
	if points <= 0 then
		return
	end
	local week = CB.week(now())
	cupMem[week] = cupMem[week] or {}
	cupMem[week][crewId] = (cupMem[week][crewId] or 0) + points
	local store = cupStore(week)
	if store then
		local ok, err = pcall(function()
			(store :: OrderedDataStore):IncrementAsync(crewId, points)
		end)
		if not ok then
			noteFailure(err)
		end
	end
end

-- Cup standings cache: week -> { {id, points} } (best first)
local cupTop: { [number]: { { id: string, points: number } } } = {}
local cupReadAt: { [number]: number } = {}
local cupFromStore: { [number]: boolean } = {}

-- Returns the standings and whether they came from the DataStore (false = this server's view only).
local function readCup(week: number, count: number): ({ { id: string, points: number } }, boolean)
	if os.clock() - (cupReadAt[week] or -math.huge) < 120 and cupTop[week] then
		return cupTop[week], cupFromStore[week] == true
	end
	local list = nil
	local fromStore = false
	local store = cupStore(week)
	if store and budget(Enum.DataStoreRequestType.GetSortedAsync) then
		local ok, page = pcall(function()
			return (store :: OrderedDataStore):GetSortedAsync(false, count, 1):GetCurrentPage()
		end)
		if ok then
			list = {}
			fromStore = true
			for _, item in page do
				table.insert(list, { id = tostring(item.key), points = tonumber(item.value) or 0 })
			end
		else
			noteFailure(page)
		end
	end
	if not list then
		list = {}
		local mem: { [string]: number } = cupMem[week] or {}
		for id, pts in mem do
			table.insert(list, { id = id, points = pts })
		end
		table.sort(list, function(a, b)
			return a.points > b.points
		end)
	end
	-- merge this server's freshest view (the store may lag)
	local byId = {}
	for _, e in list do
		byId[e.id] = e
	end
	local memNow: { [string]: number } = cupMem[week] or {}
	for id, pts in memNow do
		if not byId[id] then
			byId[id] = { id = id, points = pts }
			table.insert(list, byId[id])
		elseif byId[id].points < pts then
			byId[id].points = pts
		end
	end
	table.sort(list, function(a, b)
		return a.points > b.points
	end)
	cupTop[week] = list
	cupFromStore[week] = fromStore
	-- a failed read is retried sooner than a good one
	cupReadAt[week] = if fromStore or not storesOk then os.clock() else os.clock() - 90
	-- names for crews we haven't seen
	for i, e in list do
		if i > count then
			break
		end
		if not crewNames[e.id] then
			loadRating(e.id)
		end
	end
	return list, fromStore
end

---------------------------------------------------------------------------
-- Battles
---------------------------------------------------------------------------
type Top = { u: number, n: string, c: string, v: number }
type Battle = {
	id: string,
	format: string,
	metric: string?,
	a: Side,
	b: Side,
	by: string,
	host: string,
	state: string, -- pending | countdown | live | ending | done
	createdAt: number,
	acceptBy: number,
	startsAt: number?,
	endsAt: number?,
	scores: { [string]: { [string]: number } }, -- crewId -> serverId -> score
	tops: { [string]: Top }, -- serverId -> best local contributor
	contrib: { [number]: { name: string, crewId: string, score: number } }, -- this server's players
	lastSent: string,
	sentFinal: boolean,
	result: any?,
	rewarded: { [number]: boolean },
	doneAt: number?,
	finalizing: boolean?,
}

local battles: { [string]: Battle } = {}
local history: { any } = {} -- recent results (newest first)
local raceLog: { [string]: { { crewId: string, place: number, userId: number, at: number } } } = {}

local function isActive(b: Battle): boolean
	return b.state == "pending" or b.state == "countdown" or b.state == "live" or b.state == "ending"
end

local function activeBattleOf(crewId: string): Battle?
	for _, b in battles do
		if isActive(b) and (b.a.id == crewId or b.b.id == crewId) then
			return b
		end
	end
	return nil
end

local function liveBattleOf(crewId: string): Battle?
	local b = activeBattleOf(crewId)
	if b and b.state == "live" then
		return b
	end
	return nil
end

local function total(b: Battle, crewId: string): number
	local sum = 0
	local per: { [string]: number } = b.scores[crewId] or {}
	for _, v in per do
		sum += v
	end
	return sum
end

local function otherSide(b: Battle, crewId: string): Side
	return if b.a.id == crewId then b.b else b.a
end

local function audience(b: Battle): { Player }
	local list = membersHere(b.a.id)
	for _, p in membersHere(b.b.id) do
		table.insert(list, p)
	end
	return list
end

local function notifyCrew(crewId: string, title: string, body: string)
	for _, p in membersHere(crewId) do
		Net.notify(p, title, body)
	end
end

local function changed(b: Battle?)
	local list = if b then audience(b) else Players:GetPlayers()
	for _, p in list do
		CrewBattleEvent:FireClient(p, "changed")
	end
end

local function publish(msg: any)
	msg.s = SERVER_ID
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:PublishAsync(TOPIC, msg)
		end)
		if not ok and not IS_STUDIO then
			warn("[CityGrind] CrewBattles publish failed:", err)
		end
	end)
end

local function sideMsg(s: Side): any
	return { id = s.id, n = s.name, t = s.tag, c = s.color:ToHex() }
end

local function sideFrom(m: any): Side?
	if type(m) ~= "table" or type(m.id) ~= "string" or type(m.n) ~= "string" then
		return nil
	end
	local ok, color = pcall(Color3.fromHex, tostring(m.c))
	return { id = m.id, name = m.n, tag = if type(m.t) == "string" then m.t else "", color = if ok then color else Color3.fromRGB(200, 100, 255) }
end

local function newBattle(id: string, format: string, metric: string?, a: Side, b: Side, by: string, host: string, acceptBy: number): Battle
	local battle: Battle = {
		id = id,
		format = format,
		metric = metric,
		a = a,
		b = b,
		by = by,
		host = host,
		state = "pending",
		createdAt = now(),
		acceptBy = acceptBy,
		startsAt = nil,
		endsAt = nil,
		scores = { [a.id] = {}, [b.id] = {} },
		tops = {},
		contrib = {},
		lastSent = "",
		sentFinal = false,
		result = nil,
		rewarded = {},
		doneAt = nil,
		finalizing = false,
	}
	crewNames[a.id] = a.name
	crewNames[b.id] = b.name
	battles[id] = battle
	return battle
end

local function setBattleAttr(b: Battle)
	local active = b.state == "countdown" or b.state == "live" or b.state == "ending"
	for _, p in audience(b) do
		p:SetAttribute("CrewBattle", if active then b.id else nil)
	end
end

local function accepted(b: Battle, startsAt: number)
	if b.state == "pending" then
		b.state = "countdown"
		b.startsAt = startsAt
		b.endsAt = startsAt + CB.BY_ID[b.format].minutes * 60
	elseif b.state == "countdown" and b.startsAt and startsAt < b.startsAt then
		-- two officers accepted on different servers: the earliest start wins everywhere
		b.startsAt = startsAt
		b.endsAt = startsAt + CB.BY_ID[b.format].minutes * 60
	else
		return
	end
	local fmt = CB.formatName(b.format, b.metric)
	notifyCrew(b.a.id, "BATTLE ACCEPTED", string.format("%s accepted your %s battle. Starts in %d s!", b.b.name, fmt, math.max(0, startsAt - now())))
	notifyCrew(b.b.id, "CREW BATTLE ON", string.format("%s vs %s · %s starts in %d s!", b.a.name, b.b.name, fmt, math.max(0, startsAt - now())))
	setBattleAttr(b)
	changed(b)
end

---------------------------------------------------------------------------
-- Per-player tracking while their crew is live
---------------------------------------------------------------------------
type Tracker = {
	battleId: string,
	crewId: string,
	carried: number, -- score from before a rejoin
	wins: number,
	shifts: number,
	runs: number,
	best5k: number,
	caches: number,
	distance: number,
	lastPos: Vector3?,
	h2h: number, -- basketball points vs the rival crew
	buckets: number, -- basketball points anywhere
	race: number, -- racing points
	fiveK: number, -- City 5K finishes
}
local trackers: { [Player]: Tracker } = {}
local runHooked = false

local function attrNum(p: Player, name: string): number
	local v = p:GetAttribute(name)
	return if type(v) == "number" then v else 0
end

local function shiftsOf(p: Player): number
	local sum = 0
	for name, v in p:GetAttributes() do
		if type(v) == "number" and name:sub(1, 10) == "JobShifts_" then
			sum += v
		end
	end
	return sum
end

local function eventsSec(p: Player): any
	return PlayerData.section(p, "events")
end

local function runsOf(p: Player): number
	local d = PlayerData.get(p)
	return if d and type(d.runsCompleted) == "number" then d.runsCompleted else 0
end

local function newTracker(p: Player, b: Battle, crewId: string): Tracker
	local ev = eventsSec(p)
	local prev = b.contrib[p.UserId]
	return {
		battleId = b.id,
		crewId = crewId,
		carried = if prev and prev.crewId == crewId then prev.score else 0,
		wins = attrNum(p, "Wins"),
		shifts = shiftsOf(p),
		runs = runsOf(p),
		best5k = if ev and type(ev.best5k) == "number" then ev.best5k else 0,
		caches = if ev and type(ev.caches) == "number" then ev.caches else 0,
		distance = 0,
		lastPos = nil,
		h2h = 0,
		buckets = 0,
		race = 0,
		fiveK = 0,
	}
end

local function trackerFor(p: Player): (Tracker?, Battle?)
	local t = trackers[p]
	if not t then
		return nil, nil
	end
	local b = battles[t.battleId]
	if not b or b.state ~= "live" then
		return nil, nil
	end
	return t, b
end

-- The player's score in their battle from the tracker.
local function scoreOf(p: Player, t: Tracker, b: Battle): number
	local s = 0
	if b.format == "Basketball" then
		s = t.h2h + 5 * math.max(0, attrNum(p, "Wins") - t.wins)
	elseif b.format == "Racing" then
		s = t.race
	elseif b.format == "Running" then
		local five = t.fiveK
		if not runHooked then
			-- without the Events hook a new City 5K personal best is the proof of a finish
			local ev = eventsSec(p)
			local best = if ev and type(ev.best5k) == "number" then ev.best5k else 0
			if best > 0 and (t.best5k == 0 or best < t.best5k) then
				five = math.max(five, 1)
			end
		end
		s = math.floor(t.distance / 10) + 100 * math.max(0, runsOf(p) - t.runs) + 300 * five
	elseif b.format == "TreasureHunt" then
		local ev = eventsSec(p)
		local caches = if ev and type(ev.caches) == "number" then ev.caches else 0
		s = 100 * math.max(0, caches - t.caches)
	elseif b.format == "CityChallenge" then
		if b.metric == "jobs" then
			s = math.max(0, shiftsOf(p) - t.shifts)
		elseif b.metric == "distance" then
			s = math.floor(t.distance)
		elseif b.metric == "buckets" then
			s = t.buckets
		end
	end
	return t.carried + s
end

local function onFoot(p: Player): boolean
	local character = p.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 or hum.SeatPart ~= nil then
		return false
	end
	local driving = p:GetAttribute("Driving")
	if type(driving) == "string" and driving ~= "" then
		return false
	end
	return hum.FloorMaterial ~= Enum.Material.Air
end

local function trackTick(dt: number)
	for _, p in Players:GetPlayers() do
		local crewId = p:GetAttribute("CrewId")
		local b = if type(crewId) == "string" and crewId ~= "" then liveBattleOf(crewId) else nil
		local t = trackers[p]
		if not b then
			if t then
				trackers[p] = nil
			end
			continue
		end
		local battle: Battle = b
		if not t or t.battleId ~= battle.id or t.crewId ~= crewId then
			t = newTracker(p, battle, crewId :: string)
			trackers[p] = t
		end
		local tr: Tracker = t :: Tracker
		-- distance on foot (server-side positions; teleports / vehicles don't count)
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local pos = root.Position
			if tr.lastPos then
				local d = Vector3.new(pos.X - tr.lastPos.X, 0, pos.Z - tr.lastPos.Z).Magnitude
				if onFoot(p) and d < 40 * math.max(dt, 0.1) and AntiCheat.positionOk(p) then
					-- [Security] credit at most a sprint's worth per tick, so a client
					-- running just under the speed checks can't out-score honest runners
					tr.distance += math.min(d, SPRINT_CREDIT * math.max(dt, 0.1))
				end
			end
			tr.lastPos = pos
		end
		local score = scoreOf(p, tr, battle)
		battle.contrib[p.UserId] = { name = p.DisplayName, crewId = crewId :: string, score = score }
	end
	-- local totals per battle
	for _, b in battles do
		if b.state ~= "live" and b.state ~= "ending" then
			continue
		end
		local sa, sb = 0, 0
		local best: Top? = nil
		for uid, c in b.contrib do
			if c.crewId == b.a.id then
				sa += c.score
			elseif c.crewId == b.b.id then
				sb += c.score
			end
			if c.score > 0 and (not best or c.score > best.v) then
				best = { u = uid, n = c.name, c = c.crewId, v = c.score }
			end
		end
		b.scores[b.a.id][SERVER_ID] = sa
		b.scores[b.b.id][SERVER_ID] = sb
		b.tops[SERVER_ID] = best :: any
	end
end

-- Basketball: points vs the rival crew on the same court, and buckets anywhere.
local function onScored(_ball: any, _hoop: any, shot: any)
	if type(shot) ~= "table" or typeof(shot.shooter) ~= "Instance" or not shot.shooter:IsA("Player") then
		return
	end
	local p: Player = shot.shooter
	local pts = tonumber(shot.points) or 0
	if pts <= 0 then
		return
	end
	local t, b = trackerFor(p)
	if not t or not b then
		return
	end
	t.buckets += pts
	if b.format == "Basketball" then
		local CourtGames = optional("CourtGames")
		if not CourtGames or type(CourtGames.gameOf) ~= "function" then
			return
		end
		local ok, court = pcall(CourtGames.gameOf, p)
		if not ok or not court then
			return
		end
		local rival = otherSide(b, t.crewId)
		for _, q in membersHere(rival.id) do
			local ok2, c2 = pcall(CourtGames.gameOf, q)
			if ok2 and c2 == court then
				t.h2h += pts
				return
			end
		end
	end
end

local function onRaceFinished(p: any, place: any, _time: any, kind: any, raceId: any)
	-- solo time trials always report place 1: they don't count
	if kind == "trial" or typeof(p) ~= "Instance" or not p:IsA("Player") or type(place) ~= "number" then
		return
	end
	local t, b = trackerFor(p)
	if not t or not b or b.format ~= "Racing" then
		return
	end
	t.race += if place == 1 then 10 elseif place == 2 then 7 elseif place == 3 then 5 else 3
	local key = tostring(raceId)
	local log = raceLog[key]
	if not log then
		log = {}
		raceLog[key] = log
	end
	local rival = otherSide(b, t.crewId).id
	for _, e in log do
		if e.crewId == rival then
			if place < e.place then
				t.race += 2
			else
				local q = Players:GetPlayerByUserId(e.userId)
				local qt = q and trackers[q]
				if qt and qt.battleId == b.id then
					qt.race += 2
				end
			end
		end
	end
	table.insert(log, { crewId = t.crewId, place = place, userId = p.UserId, at = os.clock() })
end

local function onRunFinished(p: any)
	if typeof(p) ~= "Instance" or not p:IsA("Player") then
		return
	end
	local t, b = trackerFor(p)
	if t and b and b.format == "Running" then
		t.fiveK += 1
	end
end

local hooked = { basketball = false, racing = false }
local function hookSignals()
	if not hooked.basketball then
		local Basketball = optional("Basketball")
		if Basketball and type(Basketball.scored) == "table" and type(Basketball.scored.connect) == "function" then
			hooked.basketball = true
			Basketball.scored.connect(onScored)
		end
	end
	if not hooked.racing then
		local Racing = optional("Racing")
		if Racing and typeof(Racing.raceFinished) == "Instance" and Racing.raceFinished:IsA("BindableEvent") then
			hooked.racing = true
			Racing.raceFinished.Event:Connect(onRaceFinished)
		end
	end
	if not runHooked then
		local Events = optional("Events")
		if Events and typeof(Events.runFinished) == "Instance" and Events.runFinished:IsA("BindableEvent") then
			runHooked = true
			Events.runFinished.Event:Connect(onRunFinished)
		end
	end
end

---------------------------------------------------------------------------
-- Results
---------------------------------------------------------------------------
local function sectionOf(p: Player): any
	return PlayerData.section(p, "crewBattles")
end

local function unlock(p: Player, id: string)
	local Quests = optional("Quests")
	if Quests and type(Quests.unlock) == "function" then
		pcall(Quests.unlock, p, id)
	end
end

local function give(p: Player, reward: any, label: string)
	if reward.cash and reward.cash > 0 then
		PlayerData.addCash(p, reward.cash, label)
	end
	if reward.xp and reward.xp > 0 then
		PlayerData.addXP(p, reward.xp)
	end
	if reward.rep and reward.rep > 0 then
		PlayerData.addReputation(p, reward.rep)
	end
end

local function rewardText(reward: any): string
	local parts = {}
	if reward.cash and reward.cash > 0 then
		table.insert(parts, "$" .. reward.cash)
	end
	if reward.xp and reward.xp > 0 then
		table.insert(parts, reward.xp .. " XP")
	end
	if reward.rep and reward.rep > 0 then
		table.insert(parts, reward.rep .. " rep")
	end
	return table.concat(parts, " · ")
end

-- Every server runs this once per battle when the result is known.
local function handleResult(b: Battle, r: any)
	if b.state == "done" then
		return
	end
	b.state = "done"
	b.result = r
	b.doneAt = now()
	setBattleAttr(b)
	for p, t in trackers do
		if t.battleId == b.id then
			trackers[p] = nil
		end
	end
	table.insert(history, 1, r)
	while #history > 15 do
		table.remove(history)
	end
	local Crews = optional("Crews")
	local week = CB.week(r.at or now())
	for _, p in audience(b) do
		local crewId = p:GetAttribute("CrewId") :: string
		local mine = b.contrib[p.UserId]
		-- only members who actually scored for this crew take part (no AFK rewards, no carried
		-- score from the rival crew after switching sides)
		local took = mine ~= nil and mine.crewId == crewId and mine.score > 0
		local outcome = if r.winner == nil then (if r.noContest then "none" else "draw") elseif r.winner == crewId then "win" else "loss"
		local rated = outcome ~= "none" and r.unrated == nil
		local reward = nil
		local note: string? = nil
		if r.unrated == "uncontested" then
			note = "Uncontested (one crew scored nothing): unrated, no rewards."
		elseif r.unrated == "repeat" then
			note = "These crews already battled today: unrated, no rewards."
		end
		if took and not b.rewarded[p.UserId] then
			b.rewarded[p.UserId] = true
			local sec = sectionOf(p)
			if rated and sec then
				if outcome == "win" then
					reward = CB.WIN_REWARD
				elseif outcome == "draw" then
					reward = CB.DRAW_REWARD
				elseif outcome == "loss" then
					reward = CB.LOSS_REWARD
				end
				-- daily cap on paid battles per player
				local day = math.floor(now() / 86400)
				if sec.rewardDay ~= day then
					sec.rewardDay = day
					sec.rewardCount = 0
				end
				if reward and (tonumber(sec.rewardCount) or 0) >= CB.DAILY_REWARDED_BATTLES then
					reward = nil
					note = "Daily crew battle reward limit reached."
				elseif reward then
					sec.rewardCount = (tonumber(sec.rewardCount) or 0) + 1
				end
				sec.played += 1
				if outcome == "win" then
					sec.wins += 1
				end
				if r.mvp and r.mvp.u == p.UserId then
					sec.mvps += 1
				end
				-- cup eligibility: battled for this crew this week
				sec.cupWeeks[tostring(week)] = crewId
				local keys = {}
				for k in sec.cupWeeks do
					table.insert(keys, tonumber(k) or 0)
				end
				table.sort(keys)
				while #keys > 3 do
					sec.cupWeeks[tostring(table.remove(keys, 1))] = nil
				end
				PlayerData.markChanged(p)
			end
			if reward then
				give(p, reward, "Crew battle vs " .. otherSide(b, crewId).name)
				if Crews and type(Crews.addCrewRep) == "function" and reward.crewRep > 0 then
					pcall(Crews.addCrewRep, p, reward.crewRep)
				end
			end
			if rated then
				if outcome == "win" then
					unlock(p, "crew_battle_win")
					if sec and sec.wins >= 10 then
						unlock(p, "crew_battle_10")
					end
				end
				if r.mvp and r.mvp.u == p.UserId then
					unlock(p, "crew_battle_mvp")
				end
			end
		end
		local mySide = if r.a.id == crewId then r.a else r.b
		local theirSide = if r.a.id == crewId then r.b else r.a
		CrewBattleEvent:FireClient(p, "result", {
			id = r.id,
			formatName = r.formatName,
			icon = r.icon,
			unit = r.unit,
			outcome = outcome,
			mine = { name = mySide.name, tag = mySide.tag, score = mySide.score, delta = mySide.delta, rating = mySide.rating },
			theirs = { name = theirSide.name, tag = theirSide.tag, score = theirSide.score, delta = theirSide.delta, rating = theirSide.rating },
			mvp = r.mvp and { name = r.mvp.n, score = r.mvp.v } or nil,
			myScore = if mine then mine.score else 0,
			reward = if reward then rewardText(reward) else nil,
			note = note,
		})
		local headline = if outcome == "win" then "CREW BATTLE WON!" elseif outcome == "loss" then "CREW BATTLE LOST" elseif outcome == "draw" then "CREW BATTLE DRAW" else "CREW BATTLE OVER"
		Net.notify(p, headline, string.format("%s %d – %d %s · %s", mySide.name, mySide.score, theirSide.score, theirSide.name, r.formatName))
		CrewBattleEvent:FireClient(p, "live", nil)
	end
	changed(nil)
end

-- Rated battles between two crews in the last 24 h (saved records + this server's memory).
local pairMem: { [string]: { number } } = {}

local function pairKey(x: string, y: string): string
	return if x < y then x .. "|" .. y else y .. "|" .. x
end

local function recentVs(rec: RatingRec?, opponentId: string): number
	local n = 0
	if rec and type(rec.vs) == "table" then
		for _, e in rec.vs do
			if type(e) == "table" and e.o == opponentId and type(e.t) == "number" and os.time() - e.t < 86400 then
				n += 1
			end
		end
	end
	return n
end

local function pairCount(aId: string, bId: string, recA: RatingRec?, recB: RatingRec?): number
	local mem = 0
	local times: { number } = pairMem[pairKey(aId, bId)] or {}
	for _, t in times do
		if os.time() - t < 86400 then
			mem += 1
		end
	end
	return math.max(mem, recentVs(recA, bId), recentVs(recB, aId))
end

-- Host (or fallback) decides the result and applies ratings / cup once.
local function finalize(b: Battle)
	if b.state == "done" or b.finalizing then
		return
	end
	b.finalizing = true
	task.spawn(function()
		local ok, err = pcall(function()
			local sa, sb = total(b, b.a.id), total(b, b.b.id)
			local winner: string? = if sa > sb then b.a.id elseif sb > sa then b.b.id else nil
			local noContest = sa == 0 and sb == 0
			local loadedA = loadRating(b.a.id, true)
			local loadedB = loadRating(b.b.id, true)
			local ra, rb = loadedA.rating, loadedB.rating
			local da, db = 0, 0
			local recA, recB = ratings[b.a.id] or blankRating(), ratings[b.b.id] or blankRating()
			-- anti-farming: a battle one side never played, or one pair of crews battling over
			-- and over (alt crews), changes no rating, gives no cup points and pays no rewards
			local unrated: string? = nil
			if not noContest and (sa == 0 or sb == 0) then
				unrated = "uncontested"
			elseif not noContest and pairCount(b.a.id, b.b.id, loadedA, loadedB) >= CB.PAIR_RATED_PER_DAY then
				unrated = "repeat"
			end
			if not noContest and not unrated then
				local pk = pairKey(b.a.id, b.b.id)
				pairMem[pk] = pairMem[pk] or {}
				table.insert(pairMem[pk], os.time())
				local scoreA = if winner == b.a.id then 1 elseif winner == nil then 0.5 else 0
				local ea = CB.expected(ra, rb)
				da = math.floor(CB.K * (scoreA - ea) + 0.5)
				db = -da
				local okA
				recA, okA = applyResult(b.a.id, b.id, da, if scoreA == 1 then "win" elseif scoreA == 0 then "loss" else "draw", b.b.id)
				local okB
				recB, okB = applyResult(b.b.id, b.id, db, if scoreA == 0 then "win" elseif scoreA == 1 then "loss" else "draw", b.a.id)
				if okA then
					addCupPoints(b.a.id, if scoreA == 1 then CB.CUP_POINTS.win elseif scoreA == 0.5 then CB.CUP_POINTS.draw else 0)
				end
				if okB then
					addCupPoints(b.b.id, if scoreA == 0 then CB.CUP_POINTS.win elseif scoreA == 0.5 then CB.CUP_POINTS.draw else 0)
				end
				submitCrew(b.a.id, recA)
				submitCrew(b.b.id, recB)
			end
			local mvp: Top? = nil
			for _, t in b.tops do
				if t and (not mvp or t.v > mvp.v) then
					mvp = t
				end
			end
			local f = CB.BY_ID[b.format]
			local r = {
				id = b.id,
				format = b.format,
				formatName = CB.formatName(b.format, b.metric),
				icon = f.icon,
				unit = CB.unit(b.format, b.metric),
				at = now(),
				winner = winner,
				noContest = noContest,
				unrated = unrated,
				a = { id = b.a.id, name = b.a.name, tag = b.a.tag, score = sa, delta = da, rating = recA.rating },
				b = { id = b.b.id, name = b.b.name, tag = b.b.tag, score = sb, delta = db, rating = recB.rating },
				mvp = mvp,
			}
			publish({ t = "rs", id = b.id, r = r })
			b.finalizing = false
			handleResult(b, r)
		end)
		if not ok then
			-- never leave the crews stuck in an "ending" battle
			warn("[CityGrind] CrewBattles finalize failed:", err)
			b.finalizing = false
			if b.state ~= "done" then
				b.state = "done"
				b.doneAt = now()
				setBattleAttr(b)
				changed(nil)
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Cross-server messages
---------------------------------------------------------------------------
local function onMessage(packet: any)
	local msg = type(packet) == "table" and packet.Data
	if type(msg) ~= "table" or msg.s == SERVER_ID or type(msg.t) ~= "string" then
		return
	end
	local t = msg.t
	if t == "ch" then
		if type(msg.id) ~= "string" or battles[msg.id] or not CB.BY_ID[msg.f] then
			return
		end
		local a, b = sideFrom(msg.a), sideFrom(msg.b)
		if not a or not b then
			return
		end
		local battle = newBattle(msg.id, msg.f, if type(msg.m) == "string" then msg.m else nil, a, b, tostring(msg.by), msg.s, tonumber(msg.acceptBy) or now() + CB.ACCEPT_SECONDS)
		local fmt = CB.formatName(battle.format, battle.metric)
		for _, p in membersHere(b.id) do
			local c = crewOf(p)
			if isOfficer(c) then
				Net.notify(p, "CREW CHALLENGE!", string.format("%s challenges your crew to %s. Accept in the Battles app (2 min).", a.name, fmt))
			end
		end
		changed(battle)
	else
		local b = type(msg.id) == "string" and battles[msg.id]
		if not b then
			return
		end
		if t == "ac" then
			accepted(b, tonumber(msg.startsAt) or now() + CB.COUNTDOWN_SECONDS)
		elseif t == "dc" then
			if b.state == "pending" then
				b.state = "done"
				b.doneAt = now()
				changed(b)
			end
		elseif t == "sc" then
			if type(msg.a) == "number" and type(msg.b) == "number" then
				b.scores[b.a.id][msg.s] = msg.a
				b.scores[b.b.id][msg.s] = msg.b
				if type(msg.top) == "table" and type(msg.top.v) == "number" then
					b.tops[msg.s] = { u = tonumber(msg.top.u) or 0, n = tostring(msg.top.n), c = tostring(msg.top.c), v = msg.top.v }
				end
			end
		elseif t == "rs" then
			if type(msg.r) == "table" and type(msg.r.a) == "table" and type(msg.r.b) == "table" then
				handleResult(b, msg.r)
			end
		end
	end
end

---------------------------------------------------------------------------
-- Requests
---------------------------------------------------------------------------
local function targetsFor(myId: string?): { any }
	local list, seen = {}, {}
	for _, p in Players:GetPlayers() do
		local c = crewOf(p)
		if c and c.id ~= myId and not seen[c.id] then
			seen[c.id] = true
			crewNames[c.id] = c.name
			table.insert(list, { id = c.id, name = c.name, tag = c.tag, rating = CrewBattles.ratingOf(c.id), here = true, busy = activeBattleOf(c.id) ~= nil })
		end
	end
	local LB = optional("Leaderboards")
	if LB and type(LB.top) == "function" then
		local ok, top = pcall(LB.top, "crewRating", 30, "all")
		if ok and type(top) == "table" then
			for _, e in top do
				if e.key ~= myId and not seen[e.key] then
					seen[e.key] = true
					table.insert(list, { id = e.key, name = e.name, tag = "", rating = e.value, here = false, busy = activeBattleOf(e.key) ~= nil })
				end
			end
		end
	end
	return list
end

local function challenge(player: Player, args: any): (boolean, string)
	if type(args) ~= "table" or type(args.target) ~= "string" or type(args.format) ~= "string" then
		return false, "Bad request."
	end
	local f = CB.BY_ID[args.format]
	if not f then
		return false, "Pick a format."
	end
	local metric = nil
	if f.id == "CityChallenge" then
		if type(args.metric) ~= "string" or not CB.METRIC_BY_ID[args.metric] then
			return false, "Pick a city challenge metric."
		end
		metric = args.metric
	end
	local mine = crewOf(player)
	if not mine then
		return false, "You're not in a crew."
	end
	if not isOfficer(mine) then
		return false, "Only crew leaders and officers can issue challenges."
	end
	if args.target == mine.id then
		return false, "You can't battle your own crew."
	end
	if activeBattleOf(mine.id) then
		return false, "Your crew is already in a battle or has a challenge out."
	end
	if activeBattleOf(args.target) then
		return false, "That crew is busy with another battle."
	end
	-- find the target crew (this server, else the crew board)
	local target: Side? = nil
	for _, t in targetsFor(mine.id) do
		if t.id == args.target then
			local color = Color3.fromRGB(200, 100, 255)
			for _, p in membersHere(t.id) do
				local c = crewOf(p)
				if c then
					color = c.color
					break
				end
			end
			target = { id = t.id, name = t.name, tag = t.tag or "", color = color }
			break
		end
	end
	if not target then
		return false, "That crew can't be found."
	end
	if not Net.allow(player, "CrewBattleChallenge", CB.CHALLENGE_COOLDOWN) then
		return false, "Wait a minute before issuing another challenge."
	end
	local a: Side = { id = mine.id, name = mine.name, tag = mine.tag, color = mine.color }
	local id = HttpService:GenerateGUID(false):sub(1, 12)
	local b = newBattle(id, f.id, metric, a, target, player.DisplayName, SERVER_ID, now() + CB.ACCEPT_SECONDS)
	publish({ t = "ch", id = id, f = f.id, m = metric, a = sideMsg(a), b = sideMsg(target), by = player.DisplayName, acceptBy = b.acceptBy })
	local fmt = CB.formatName(f.id, metric)
	local hereOfficers = 0
	for _, p in membersHere(target.id) do
		local c = crewOf(p)
		if isOfficer(c) then
			hereOfficers += 1
			Net.notify(p, "CREW CHALLENGE!", string.format("%s challenges your crew to %s. Accept in the Battles app (2 min).", a.name, fmt))
			local Messages = optional("Messages")
			if Messages and type(Messages.sendSystem) == "function" then
				pcall(Messages.sendSystem, p, "Crew Battles", string.format("%s (%s) challenged your crew to %s. Open the Battles app on your phone to accept or decline within 2 minutes.", a.name, player.DisplayName, fmt))
			end
		end
	end
	notifyCrew(mine.id, "CHALLENGE SENT", string.format("%s challenged %s to %s.", player.DisplayName, target.name, fmt))
	changed(b)
	if hereOfficers == 0 then
		return true, "Challenge sent. Their leader or officers have 2 minutes to accept (from any server)."
	end
	return true, "Challenge sent to " .. target.name .. "."
end

local function respond(player: Player, id: any, action: string): (boolean, string)
	local b = type(id) == "string" and battles[id]
	if not b or b.state ~= "pending" then
		return false, "That challenge is no longer open."
	end
	local c = crewOf(player)
	if not isOfficer(c) then
		return false, "Only leaders and officers can do that."
	end
	if action == "Cancel" then
		if c.id ~= b.a.id then
			return false, "Only the challenging crew can cancel."
		end
		b.state = "done"
		b.doneAt = now()
		publish({ t = "dc", id = b.id })
		notifyCrew(b.a.id, "CHALLENGE CANCELLED", player.DisplayName .. " cancelled the challenge to " .. b.b.name .. ".")
		changed(b)
		return true, "Challenge cancelled."
	end
	if c.id ~= b.b.id then
		return false, "This challenge isn't for your crew."
	end
	if action == "Decline" then
		b.state = "done"
		b.doneAt = now()
		publish({ t = "dc", id = b.id })
		notifyCrew(b.a.id, "CHALLENGE DECLINED", b.b.name .. " declined your crew battle.")
		changed(b)
		return true, "Challenge declined."
	end
	-- Accept
	if now() > b.acceptBy then
		return false, "The challenge expired."
	end
	for _, other in battles do
		if other ~= b and isActive(other) and (other.a.id == c.id or other.b.id == c.id) then
			return false, "Your crew is already in another battle."
		end
	end
	local startsAt = now() + CB.COUNTDOWN_SECONDS
	publish({ t = "ac", id = b.id, startsAt = startsAt })
	accepted(b, startsAt)
	return true, "Battle accepted! Starts in " .. CB.COUNTDOWN_SECONDS .. " seconds."
end

CrewBattleRequest.OnServerInvoke = function(player: Player, action: any, args: any)
	if not Net.allow(player, "CrewBattleRequest", 0.5) then
		return { ok = false, msg = "Slow down." }
	end
	local ok, success, msg = pcall(function()
		if action == "Challenge" then
			return challenge(player, args)
		elseif action == "Accept" or action == "Decline" or action == "Cancel" then
			return respond(player, args, action)
		end
		return false, "Unknown action."
	end)
	if not ok then
		warn("[CityGrind] CrewBattleRequest failed:", success)
		return { ok = false, msg = "Something went wrong." }
	end
	return { ok = success == true, msg = msg }
end

local function battleView(b: Battle, viewer: Player, myId: string): any
	local f = CB.BY_ID[b.format]
	local c = crewOf(viewer)
	local top = {}
	for _, ct in b.contrib do
		if ct.score > 0 then
			table.insert(top, { name = ct.name, score = ct.score, mine = ct.crewId == myId })
		end
	end
	table.sort(top, function(x, y)
		return x.score > y.score
	end)
	while #top > 6 do
		table.remove(top)
	end
	local me = b.contrib[viewer.UserId]
	return {
		id = b.id,
		format = b.format,
		formatName = CB.formatName(b.format, b.metric),
		desc = if b.format == "CityChallenge" and b.metric then CB.METRIC_BY_ID[b.metric].desc else f.desc,
		icon = f.icon,
		unit = CB.unit(b.format, b.metric),
		state = b.state,
		by = b.by,
		a = { id = b.a.id, name = b.a.name, tag = b.a.tag, color = b.a.color, score = total(b, b.a.id) },
		b = { id = b.b.id, name = b.b.name, tag = b.b.tag, color = b.b.color, score = total(b, b.b.id) },
		mineIsA = b.a.id == myId,
		acceptBy = b.acceptBy,
		startsAt = b.startsAt,
		endsAt = b.endsAt,
		canAccept = b.state == "pending" and b.b.id == myId and isOfficer(c),
		canCancel = b.state == "pending" and b.a.id == myId and isOfficer(c),
		top = top,
		myScore = if me then me.score else 0,
	}
end

local function getSnapshot(player: Player): any
	local c = crewOf(player)
	local week = CB.week(now())
	local snapshot: any = {
		serverNow = now(),
		global = storesOk,
		formats = nil,
	}
	if c then
		local rec = ratings[c.id] or loadRating(c.id)
		snapshot.crew = {
			id = c.id,
			name = c.name,
			tag = c.tag,
			role = c.role,
			canChallenge = isOfficer(c),
			rating = rec.rating,
			wins = rec.wins,
			losses = rec.losses,
			draws = rec.draws,
		}
		local b = activeBattleOf(c.id)
		if b then
			snapshot.battle = battleView(b, player, c.id)
		end
		snapshot.targets = targetsFor(c.id)
	end
	-- weekly cup
	local standings = {}
	local myPoints = 0
	for i, e in (readCup(week, 10)) do
		if c and e.id == c.id then
			myPoints = e.points
		end
		if i <= 10 then
			table.insert(standings, { name = crewNames[e.id] or "Crew", points = e.points, mine = c ~= nil and e.id == c.id })
		end
	end
	local last = {}
	for i, e in (readCup(week - 1, 3)) do
		if i > 3 then
			break
		end
		table.insert(last, { name = crewNames[e.id] or "Crew", points = e.points })
	end
	snapshot.cup = { week = week, endsAt = CB.weekEnds(week), standings = standings, myPoints = myPoints, lastWeek = last }
	local hist = {}
	for i, r in history do
		if i > 10 then
			break
		end
		table.insert(hist, {
			formatName = r.formatName,
			icon = r.icon,
			a = { name = r.a.name, score = r.a.score },
			b = { name = r.b.name, score = r.b.score },
			winner = if r.winner == r.a.id then r.a.name elseif r.winner == r.b.id then r.b.name else nil,
			noContest = r.noContest,
			at = r.at,
		})
	end
	snapshot.history = hist
	local sec = sectionOf(player)
	snapshot.me = sec and { played = sec.played, wins = sec.wins, mvps = sec.mvps } or nil
	return snapshot
end

CrewBattleGet.OnServerInvoke = function(player: Player)
	if not Net.allow(player, "CrewBattleGet", 0.3) then
		return nil
	end
	-- [Security] a failed read returns nothing instead of throwing into the client
	local ok, snapshot = pcall(getSnapshot, player)
	if not ok then
		warn("[Security] CrewBattleGet failed:", snapshot)
		return nil
	end
	return snapshot
end

---------------------------------------------------------------------------
-- Weekly City Crew Cup rewards (collected on the next visit after the week ends)
---------------------------------------------------------------------------
local function claimCup(p: Player)
	local sec = sectionOf(p)
	if not sec then
		return
	end
	local lastWeek = CB.week(now()) - 1
	if sec.cupClaimed >= lastWeek then
		return
	end
	local crewId = sec.cupWeeks[tostring(lastWeek)]
	if type(crewId) ~= "string" then
		return
	end
	local top, fromStore = readCup(lastWeek, 3)
	if #top == 0 or (storesOk and not fromStore) then
		return -- global standings not readable right now (this server's view isn't enough); try again later
	end
	for place, e in top do
		if place > 3 then
			break
		end
		if e.id == crewId and e.points > 0 then
			sec.cupClaimed = lastWeek
			PlayerData.markChanged(p)
			local reward = CB.CUP_REWARDS[place]
			give(p, reward, "City Crew Cup #" .. place)
			Net.notify(p, if place == 1 then "CITY CREW CUP CHAMPIONS!" else "CITY CREW CUP PODIUM", string.format("%s finished #%d in last week's City Crew Cup. %s", crewNames[crewId] or "Your crew", place, rewardText(reward)))
			if place == 1 then
				unlock(p, "crew_cup_champion")
			end
			return
		end
	end
	-- not on the podium: nothing to claim for that week
	sec.cupClaimed = lastWeek
	PlayerData.markChanged(p)
end

---------------------------------------------------------------------------
-- Main loop
---------------------------------------------------------------------------
local function chipFor(b: Battle, p: Player): any
	local myId = p:GetAttribute("CrewId")
	local mine = if b.a.id == myId then b.a else b.b
	local theirs = if b.a.id == myId then b.b else b.a
	local me = b.contrib[p.UserId]
	return {
		id = b.id,
		state = b.state,
		icon = CB.BY_ID[b.format].icon,
		formatName = CB.formatName(b.format, b.metric),
		unit = CB.unit(b.format, b.metric),
		mine = { tag = mine.tag, name = mine.name, color = mine.color, score = total(b, mine.id) },
		theirs = { tag = theirs.tag, name = theirs.name, color = theirs.color, score = total(b, theirs.id) },
		startsAt = b.startsAt,
		endsAt = b.endsAt,
		myScore = if me then me.score else 0,
		serverNow = now(),
	}
end

local function step(dt: number)
	local t = now()
	for id, b in battles do
		if b.state == "pending" and t > b.acceptBy then
			b.state = "done"
			b.doneAt = t
			if b.host == SERVER_ID then
				notifyCrew(b.a.id, "CHALLENGE EXPIRED", b.b.name .. " didn't answer your crew battle challenge.")
			end
			changed(b)
		elseif b.state == "countdown" and b.startsAt and t >= b.startsAt then
			b.state = "live"
			notifyCrew(b.a.id, "BATTLE STARTED!", CB.formatName(b.format, b.metric) .. " vs " .. b.b.name .. ". Go!")
			notifyCrew(b.b.id, "BATTLE STARTED!", CB.formatName(b.format, b.metric) .. " vs " .. b.a.name .. ". Go!")
			setBattleAttr(b)
			changed(b)
		elseif b.state == "live" and b.endsAt and t >= b.endsAt then
			b.state = "ending"
			changed(b)
		elseif b.state == "done" and b.doneAt and t - b.doneAt > 600 then
			battles[id] = nil
		end
	end
	trackTick(dt)
	for _, b in battles do
		if b.state == "ending" and b.endsAt then
			-- the host finalizes; another server only does if the host went quiet
			-- (a battle id is applied to a crew's rating once either way)
			local grace = if b.host == SERVER_ID then CB.FINALIZE_GRACE else 90
			if t >= b.endsAt + grace then
				if b.host ~= SERVER_ID and next(b.contrib) == nil and #audience(b) == 0 then
					-- an uninvolved server that missed the host's result: just forget the battle
					-- (finalizing here too would only spend DataStore budget on every server)
					b.state = "done"
					b.doneAt = t
				else
					finalize(b)
				end
			end
		end
	end
end

local function broadcastScores()
	for _, b in battles do
		if (b.state == "live" or b.state == "ending") and b.host ~= nil then
			if b.state == "ending" and b.sentFinal then
				continue
			end
			local sa = b.scores[b.a.id][SERVER_ID] or 0
			local sb = b.scores[b.b.id][SERVER_ID] or 0
			local key = sa .. "|" .. sb
			if key ~= b.lastSent or b.state == "ending" then
				b.lastSent = key
				if b.state == "ending" then
					b.sentFinal = true
				end
				-- only servers with something to report (every server knows every battle; a
				-- message from each would flood the topic's per-minute receive limit)
				if #membersHere(b.a.id) + #membersHere(b.b.id) > 0 or next(b.contrib) ~= nil then
					local top = b.tops[SERVER_ID]
					publish({ t = "sc", id = b.id, a = sa, b = sb, top = top })
				end
			end
		end
	end
end

function CrewBattles.start(_city: Instance?)
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(TOPIC, onMessage)
		end)
		if not ok and not IS_STUDIO then
			warn("[CityGrind] CrewBattles: cross-server battles unavailable:", err)
		end
	end)

	PlayerData.onLoaded(function(p)
		task.wait(5)
		if p.Parent then
			claimCup(p)
			local id = p:GetAttribute("CrewId")
			if type(id) == "string" and id ~= "" then
				CrewBattles.ratingOf(id)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(p)
		trackers[p] = nil
	end)

	-- main loop: state changes, tracking, chips
	task.spawn(function()
		local last = os.clock()
		local ticks = 0
		while true do
			task.wait(1)
			local dt = os.clock() - last
			last = os.clock()
			ticks += 1
			hookSignals()
			local ok, err = pcall(step, dt)
			if not ok then
				warn("[CityGrind] CrewBattles step failed:", err)
			end
			if ticks % 2 == 0 then
				-- clear stale battle attributes (left the crew, battle over)
				for _, p in Players:GetPlayers() do
					local bid = p:GetAttribute("CrewBattle")
					if bid ~= nil then
						local b = battles[bid]
						local crewId = p:GetAttribute("CrewId")
						if not b or b.state == "done" or b.state == "pending" or (b.a.id ~= crewId and b.b.id ~= crewId) then
							p:SetAttribute("CrewBattle", nil)
							CrewBattleEvent:FireClient(p, "live", nil)
						end
					end
				end
				for _, b in battles do
					if b.state == "countdown" or b.state == "live" or b.state == "ending" then
						for _, p in audience(b) do
							if p:GetAttribute("CrewBattle") ~= b.id then
								p:SetAttribute("CrewBattle", b.id)
							end
							CrewBattleEvent:FireClient(p, "live", chipFor(b, p))
						end
					end
				end
			end
			if ticks % CB.SCORE_BROADCAST_SECONDS == 0 then
				pcall(broadcastScores)
			end
			if ticks % 60 == 0 then
				-- crews online here show up on the crew board; drop stale race logs
				for _, p in Players:GetPlayers() do
					local id = p:GetAttribute("CrewId")
					if type(id) == "string" and id ~= "" and ratings[id] then
						local c = crewOf(p)
						if c then
							crewNames[id] = c.name
						end
						submitCrew(id, ratings[id])
					elseif type(id) == "string" and id ~= "" then
						CrewBattles.ratingOf(id)
					end
				end
				for key, log in raceLog do
					if #log == 0 or os.clock() - log[#log].at > 900 then
						raceLog[key] = nil
					end
				end
			end
			if ticks % 300 == 0 then
				for _, p in Players:GetPlayers() do
					task.spawn(claimCup, p)
				end
			end
		end
	end)
end

return CrewBattles
]=====])
put(server, 'ModuleScript', 'Crews', [=====[
-- CITY GRIND: crews (sections 60, 61, 62). Server side.
-- A crew is a persistent group with a name, tag, colour and logo. It lives in
-- its own DataStore record (so it exists while members are offline or on other
-- servers); every write re-reads the record with UpdateAsync. MessagingService
-- tells other servers to reload a crew after a change. Without DataStore access
-- (Studio) crews work in memory for the current server.
--
-- Crew rep grows from members' activity: every point of Reputation a member
-- earns is added to crew rep. Crew level comes from crew rep. Each week the crew
-- has a mission tracked from members' Wins / Reputation / Level increases.
--
-- Remotes:  CrewRequest (RemoteFunction): (action, args) -> { ok, message }
--           CrewGet     (RemoteFunction): () -> snapshot for the Crew phone app
--           CrewEvent   (RemoteEvent, server -> client): ("changed") ("invite", {crewId, name, tag, by})
-- Player attributes: CrewId, CrewName, CrewTag, CrewColor (Color3), CrewRole, CrewLogo, CrewLevel ("" / nil when crewless)
-- Saved section "crew" = { crewId = "", invites = { {crewId, name, tag, by, at} } }
-- DataStores: CityGrind_Crews_v1 (key "crew_<id>"), CityGrind_CrewNames_v1 (lower name -> id),
--             OrderedDataStore CityGrind_CrewRep_v1 (crew id -> rep)

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Net = require(script.Parent:WaitForChild("Net"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local CrewsConfig = require(ReplicatedStorage:WaitForChild("CityGrind"):WaitForChild("CrewsConfig"))

local Crews = {}

local SERVER_ID = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)
local TOPIC = "CityGrindCrews"
local FLUSH_SECONDS = 45
local LEADERBOARD_SECONDS = 90
local ONLINE_STALE = 6 * 3600

local CrewRequest = Net.remote("RemoteFunction", "CrewRequest")
local CrewGet = Net.remote("RemoteFunction", "CrewGet")
local CrewEvent = Net.remote("RemoteEvent", "CrewEvent")

PlayerData.registerSection("crew", function()
	return { crewId = "", invites = {} }
end)

---------------------------------------------------------------------------
-- Storage
---------------------------------------------------------------------------
local store: DataStore? = nil
local nameStore: DataStore? = nil
local rankStore: OrderedDataStore? = nil
pcall(function()
	store = DataStoreService:GetDataStore("CityGrind_Crews_v1")
	nameStore = DataStoreService:GetDataStore("CityGrind_CrewNames_v1")
	rankStore = DataStoreService:GetOrderedDataStore("CityGrind_CrewRep_v1")
end)

local storeOk = false -- set by the probe in start(); false = in-memory crews for this server
local probeDone = false

local cache: { [string]: any } = {} -- crew id -> latest record we've seen (authoritative in memory mode)
local memoryNames: { [string]: string } = {}
local crewIdOf: { [Player]: string } = {} -- online members in this server
local pending: { [string]: { rep: number, stats: { [string]: number } } } = {}
local lastStats: { [Player]: { [string]: number } } = {}
local busy: { [Player]: boolean } = {}
local leaderboardCache: { at: number, list: { any } }? = nil

local function retry<T>(attempts: number, fn: () -> T): (boolean, any)
	local ok, result
	for attempt = 1, attempts do
		ok, result = pcall(fn)
		if ok then
			return true, result
		end
		if attempt < attempts then
			task.wait(attempt)
		end
	end
	return false, result
end

local function deepCopy(t: any): any
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in t do
		c[k] = deepCopy(v)
	end
	return c
end

local function waitProbe()
	local deadline = os.clock() + 15
	while not probeDone and os.clock() < deadline do
		task.wait(0.2)
	end
end

-- Reads a crew. `fresh` forces a DataStore read (otherwise the cache is fine).
local function readCrew(id: string, fresh: boolean?): any
	if not storeOk or not store then
		return cache[id]
	end
	if not fresh and cache[id] then
		return cache[id]
	end
	local ok, rec = retry(3, function()
		return (store :: DataStore):GetAsync("crew_" .. id)
	end)
	if ok then
		if rec then
			cache[id] = rec -- the stored copy is the truth
		else
			cache[id] = nil
		end
		return rec
	end
	return cache[id]
end

-- Atomically edits a crew: `mutate(rec)` runs on the freshest copy and returns
-- (true) to save or (false, why) to abort. It must not yield.
local function editCrew(id: string, mutate: (any) -> (boolean, string?)): (boolean, string?, any)
	local why: string? = nil
	if storeOk and store then
		local result = nil
		local ok, err = retry(3, function()
			return (store :: DataStore):UpdateAsync("crew_" .. id, function(saved)
				why = nil
				if type(saved) ~= "table" or saved.disbanded then
					why = "That crew doesn't exist anymore."
					return nil
				end
				local fine, reason = mutate(saved)
				if not fine then
					why = reason or "Couldn't do that."
					return nil
				end
				saved.version = (saved.version or 0) + 1
				result = saved
				return saved
			end)
		end)
		if not ok then
			warn("[CityGrind] Crew save failed:", err)
			return false, "The crew service is busy. Try again in a moment."
		end
		if why or not result then
			return false, why or "Couldn't do that."
		end
		cache[id] = result
		return true, nil, result
	end
	local rec = cache[id]
	if not rec or rec.disbanded then
		return false, "That crew doesn't exist anymore."
	end
	local copy = deepCopy(rec)
	local fine, reason = mutate(copy)
	if not fine then
		return false, reason or "Couldn't do that."
	end
	copy.version = (copy.version or 0) + 1
	cache[id] = copy
	return true, nil, copy
end

local function setRank(rec: any)
	if not storeOk or not rankStore or rec.disbanded then
		return
	end
	task.spawn(function()
		pcall(function()
			(rankStore :: OrderedDataStore):SetAsync(rec.id, math.floor(rec.rep or 0))
		end)
	end)
end

local function publishChange(id: string, note: { title: string, body: string }?)
	if not storeOk then
		return
	end
	task.spawn(function()
		pcall(function()
			MessagingService:PublishAsync(TOPIC, { id = id, server = SERVER_ID, title = note and note.title, body = note and note.body })
		end)
	end)
end

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function lazy(name: string): any
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	return if ok then result else nil
end

local function uidKey(userId: number): string
	return tostring(userId)
end

local function memberCount(rec: any): number
	local n = 0
	for _ in rec.members do
		n += 1
	end
	return n
end

local function roleOf(rec: any, userId: number): string?
	local m = rec and rec.members and rec.members[uidKey(userId)]
	return m and m.role
end

local function rank(role: string?): number
	return role and CrewsConfig.ROLE_RANK[role] or 0
end

local function colorOf(rec: any): Color3
	local entry = CrewsConfig.COLORS[rec.color] or CrewsConfig.COLORS[1]
	return entry.color
end

local function currentMission(rec: any, now: number)
	local week = CrewsConfig.weekIndex(now)
	local m = rec.mission
	if type(m) ~= "table" or m.week ~= week then
		local def = CrewsConfig.missionFor(rec.id, week)
		return { week = week, id = def.id, progress = 0, done = false }, true
	end
	return m, false
end

local function missionDef(id: string)
	for _, def in CrewsConfig.MISSIONS do
		if def.id == id then
			return def
		end
	end
	return CrewsConfig.MISSIONS[1]
end

local function pruneInvites(rec: any)
	local now = os.time()
	rec.invites = rec.invites or {}
	for k, inv in rec.invites do
		if type(inv) ~= "table" or now - (inv.at or 0) > CrewsConfig.INVITE_DAYS * 86400 then
			rec.invites[k] = nil
		end
	end
end

-- Filters text written by a player for display to everyone. nil = rejected / failed.
local function filterBroadcast(text: string, userId: number): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, userId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(result) == "string" then
		return result
	end
	-- Studio test players (negative ids) can't be filtered; Studio only, never live.
	if userId <= 0 and RunService:IsStudio() then
		return text
	end
	return nil
end

local function cleanSpaces(text: string): string
	return (text:gsub("%s+", " "):gsub("^ ", ""):gsub(" $", ""))
end

---------------------------------------------------------------------------
-- Membership on this server
---------------------------------------------------------------------------
local function setAttributes(player: Player, rec: any?)
	if not player.Parent then
		return
	end
	if rec then
		local level = CrewsConfig.levelFor(rec.rep or 0)
		player:SetAttribute("CrewId", rec.id)
		player:SetAttribute("CrewName", rec.name)
		player:SetAttribute("CrewTag", rec.tag)
		player:SetAttribute("CrewColor", colorOf(rec))
		player:SetAttribute("CrewRole", roleOf(rec, player.UserId) or "Member")
		player:SetAttribute("CrewLogo", CrewsConfig.LOGOS[rec.logo] or CrewsConfig.LOGOS[1])
		player:SetAttribute("CrewLevel", level)
	else
		player:SetAttribute("CrewId", "")
		player:SetAttribute("CrewName", "")
		player:SetAttribute("CrewTag", "")
		player:SetAttribute("CrewColor", nil)
		player:SetAttribute("CrewRole", "")
		player:SetAttribute("CrewLogo", "")
		player:SetAttribute("CrewLevel", 0)
	end
end

local function changed(player: Player)
	if player.Parent then
		CrewEvent:FireClient(player, "changed")
	end
end

local function attach(player: Player, rec: any)
	crewIdOf[player] = rec.id
	local section = PlayerData.section(player, "crew")
	if section and section.crewId ~= rec.id then
		section.crewId = rec.id
		PlayerData.markChanged(player)
	end
	setAttributes(player, rec)
	changed(player)
end

local function detach(player: Player, message: string?)
	crewIdOf[player] = nil
	local section = PlayerData.section(player, "crew")
	if section and section.crewId ~= "" then
		section.crewId = ""
		PlayerData.markChanged(player)
	end
	setAttributes(player, nil)
	changed(player)
	if message then
		Net.notify(player, "CREW", message)
	end
end

-- Re-applies a crew record to everyone on this server who belongs to it.
local function refreshMembers(id: string)
	local rec = cache[id]
	for player, crewId in crewIdOf do
		if crewId == id then
			if not rec or rec.disbanded then
				detach(player, "Your crew was disbanded.")
			elseif not rec.members[uidKey(player.UserId)] then
				detach(player, "You're no longer in " .. rec.name .. ".")
			else
				setAttributes(player, rec)
				changed(player)
			end
		end
	end
end

local function notifyCrew(id: string, title: string, body: string, except: Player?)
	for player, crewId in crewIdOf do
		if crewId == id and player ~= except then
			Net.notify(player, title, body)
		end
	end
end

-- After any successful edit: update players here and tell other servers.
local function afterEdit(rec: any, note: { title: string, body: string }?, except: Player?)
	refreshMembers(rec.id)
	if note then
		notifyCrew(rec.id, note.title, note.body, except)
	end
	publishChange(rec.id, note)
end

---------------------------------------------------------------------------
-- Rep, wins and missions
---------------------------------------------------------------------------
local function addPending(id: string, rep: number, stat: string?, amount: number?)
	local p = pending[id]
	if not p then
		p = { rep = 0, stats = {} }
		pending[id] = p
	end
	p.rep += rep
	if stat and amount then
		p.stats[stat] = (p.stats[stat] or 0) + amount
	end
end

-- Public: adds crew rep on behalf of a member (saved with the next flush).
function Crews.addCrewRep(player: Player, amount: number)
	local id = crewIdOf[player]
	if id and type(amount) == "number" and amount > 0 and amount == amount then
		addPending(id, math.floor(amount), nil, nil)
	end
end

local function flushCrew(id: string)
	local p = pending[id]
	pending[id] = nil
	-- online members' current wins for the crew stats
	local wins: { [string]: number } = {}
	local names: { [string]: string } = {}
	for player, crewId in crewIdOf do
		if crewId == id then
			wins[uidKey(player.UserId)] = player:GetAttribute("Wins") or 0
			names[uidKey(player.UserId)] = player.DisplayName
		end
	end
	if not p then
		-- nothing earned: only save if someone's win count moved
		local cached = cache[id]
		local moved = false
		for key, w in wins do
			local m = cached and cached.members[key]
			if m and m.wins ~= w then
				moved = true
			end
		end
		if not moved then
			return
		end
	end
	local completed = nil
	local ok, _, rec = editCrew(id, function(r)
		completed = nil
		if p then
			r.rep = (r.rep or 0) + p.rep
			local mission, _ = currentMission(r, os.time())
			r.mission = mission
			local def = missionDef(mission.id)
			local gained = p.stats[def.stat]
			if gained and not mission.done then
				mission.progress = math.min(def.goal, mission.progress + gained)
				if mission.progress >= def.goal then
					mission.done = true
					r.rep += def.reward
					completed = def
				end
			end
		end
		for key, w in wins do
			local m = r.members[key]
			if m then
				m.wins = w
				m.name = names[key] or m.name
			end
		end
		return true
	end)
	if ok and rec then
		setRank(rec)
		local note = nil
		if completed then
			note = { title = "CREW MISSION COMPLETE", body = completed.title .. " - +" .. completed.reward .. " crew rep!" }
		end
		afterEdit(rec, note)
	elseif p then
		-- keep the progress for the next attempt (unless the crew is gone)
		if cache[id] and not cache[id].disbanded then
			addPending(id, p.rep, nil, nil)
			for stat, n in p.stats do
				addPending(id, 0, stat, n)
			end
		end
	end
end

local function flushAll()
	local ids = {}
	for id in pending do
		ids[id] = true
	end
	for _, id in crewIdOf do
		ids[id] = true
	end
	for id in ids do
		flushCrew(id)
	end
end

local function watchStats(player: Player)
	lastStats[player] = {}
	local watched = { Reputation = true }
	for _, stat in CrewsConfig.MISSION_STATS do
		watched[stat] = true
	end
	for stat in watched do
		player:GetAttributeChangedSignal(stat):Connect(function()
			local value = player:GetAttribute(stat)
			local last = lastStats[player]
			if not last or type(value) ~= "number" then
				return
			end
			local before = last[stat]
			last[stat] = value
			if before == nil or not player:GetAttribute("DataLoaded") then
				return -- first value after loading isn't progress
			end
			local delta = value - before
			local id = crewIdOf[player]
			if delta > 0 and id then
				addPending(id, if stat == "Reputation" then delta else 0, stat, delta)
			end
		end)
		local v = player:GetAttribute(stat)
		if type(v) == "number" then
			lastStats[player][stat] = v
		end
	end
end

---------------------------------------------------------------------------
-- Snapshot for the phone app
---------------------------------------------------------------------------
local function getLeaderboard(): { any }
	if leaderboardCache and os.clock() - leaderboardCache.at < LEADERBOARD_SECONDS then
		return leaderboardCache.list
	end
	local list = {}
	local function row(rec: any, rep: number)
		local level = CrewsConfig.levelFor(rep)
		table.insert(list, {
			id = rec.id,
			name = rec.name,
			tag = rec.tag,
			logo = CrewsConfig.LOGOS[rec.logo] or CrewsConfig.LOGOS[1],
			color = colorOf(rec),
			rep = rep,
			level = level,
		})
	end
	local fromStore = false
	if storeOk and rankStore then
		local ok, page = pcall(function()
			return (rankStore :: OrderedDataStore):GetSortedAsync(false, 10):GetCurrentPage()
		end)
		if ok and type(page) == "table" then
			fromStore = true
			for _, entry in page do
				local rec = readCrew(entry.key, false)
				if rec and not rec.disbanded then
					row(rec, entry.value)
				end
			end
		end
	end
	if not fromStore then
		local recs = {}
		for _, rec in cache do
			if not rec.disbanded then
				table.insert(recs, rec)
			end
		end
		table.sort(recs, function(a, b)
			return (a.rep or 0) > (b.rep or 0)
		end)
		for i = 1, math.min(10, #recs) do
			row(recs[i], recs[i].rep or 0)
		end
	end
	leaderboardCache = { at = os.clock(), list = list }
	return list
end

local function crewSnapshot(rec: any, viewer: Player)
	local now = os.time()
	local level, floorRep, nextRep = CrewsConfig.levelFor(rec.rep or 0)
	local members = {}
	local totalWins = 0
	for key, m in rec.members do
		local userId = tonumber(key) or 0
		local here = Players:GetPlayerByUserId(userId)
		local wins = if here then (here:GetAttribute("Wins") or 0) else (m.wins or 0)
		totalWins += wins
		table.insert(members, {
			userId = userId,
			name = if here then here.DisplayName else (m.name or "Player"),
			role = m.role,
			wins = wins,
			online = here ~= nil or (type(m.server) == "string" and m.server ~= "" and now - (m.seen or 0) < ONLINE_STALE),
			here = here ~= nil,
			seen = m.seen or 0,
		})
	end
	table.sort(members, function(a, b)
		if rank(a.role) ~= rank(b.role) then
			return rank(a.role) > rank(b.role)
		end
		if a.online ~= b.online then
			return a.online
		end
		return a.name < b.name
	end)
	local mission = currentMission(rec, now)
	local def = missionDef(mission.id)
	return {
		id = rec.id,
		name = rec.name,
		tag = rec.tag,
		color = colorOf(rec),
		logo = CrewsConfig.LOGOS[rec.logo] or CrewsConfig.LOGOS[1],
		rep = rec.rep or 0,
		level = level,
		levelFloor = floorRep,
		levelNext = nextRep,
		createdAt = rec.createdAt or 0,
		announcement = rec.announcement,
		members = members,
		memberCount = #members,
		maxMembers = CrewsConfig.MAX_MEMBERS,
		totalWins = totalWins,
		myRole = roleOf(rec, viewer.UserId) or "Member",
		mission = {
			title = def.title,
			progress = mission.progress,
			goal = def.goal,
			reward = def.reward,
			done = mission.done,
			endsAt = CrewsConfig.weekEnds(now),
		},
	}
end

local function snapshotFor(player: Player)
	local id = crewIdOf[player]
	local rec = id and cache[id]
	local section = PlayerData.section(player, "crew")
	local invites = {}
	if section and not rec then
		for _, inv in section.invites do
			if os.time() - (inv.at or 0) <= CrewsConfig.INVITE_DAYS * 86400 then
				table.insert(invites, { crewId = inv.crewId, name = inv.name, tag = inv.tag, by = inv.by, at = inv.at })
			end
		end
	end
	return {
		loaded = section ~= nil,
		crew = if rec and not rec.disbanded then crewSnapshot(rec, player) else nil,
		invites = invites,
		leaderboard = getLeaderboard(),
		fee = CrewsConfig.FEE,
		minLevel = CrewsConfig.MIN_LEVEL,
		persistent = storeOk,
	}
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------
local function myCrew(player: Player): (any, string?)
	local id = crewIdOf[player]
	local rec = id and cache[id]
	if not rec or rec.disbanded then
		return nil, "You're not in a crew."
	end
	return rec
end

local function claimName(lower: string, id: string): boolean
	if not storeOk or not nameStore then
		if memoryNames[lower] and cache[memoryNames[lower]] and not cache[memoryNames[lower]].disbanded then
			return false
		end
		memoryNames[lower] = id
		return true
	end
	local taken = false
	local ok = retry(3, function()
		return (nameStore :: DataStore):UpdateAsync(lower, function(old)
			taken = false
			if type(old) == "string" and old ~= id then
				taken = true
				return nil
			end
			return id
		end)
	end)
	return ok and not taken
end

local function releaseName(lower: string, id: string)
	if not storeOk or not nameStore then
		if memoryNames[lower] == id then
			memoryNames[lower] = nil
		end
		return
	end
	task.spawn(function()
		pcall(function()
			(nameStore :: DataStore):UpdateAsync(lower, function(old)
				if old == id then
					return nil
				end
				return old
			end)
		end)
		pcall(function()
			(nameStore :: DataStore):RemoveAsync(lower)
		end)
	end)
end

local creating: { [Player]: boolean } = {}
local createCrew: (Player, any) -> (boolean, string?)

-- [Security] create yields (text filter + DataStore) for longer than its cooldown, so two
-- requests could both pass the "not in a crew" check and found (and pay for) two crews.
function Crews.create(player: Player, args: any): (boolean, string?)
	if creating[player] then
		return false, "Your crew is still being set up."
	end
	creating[player] = true
	local ok, okResult, msg = pcall(createCrew, player, args)
	creating[player] = nil
	if not ok then
		warn("[CityGrind] Crew create failed:", okResult)
		return false, "Something went wrong. Try again."
	end
	return okResult, msg
end

createCrew = function(player: Player, args: any): (boolean, string?)
	if type(args) ~= "table" then
		return false, "Fill in the form."
	end
	local section = PlayerData.section(player, "crew")
	if not section then
		return false, "Your data is still loading."
	end
	if crewIdOf[player] or section.crewId ~= "" then
		return false, "Leave your crew before starting a new one."
	end
	if (player:GetAttribute("Level") or 1) < CrewsConfig.MIN_LEVEL then
		return false, "You need to be level " .. CrewsConfig.MIN_LEVEL .. " to start a crew."
	end
	if (player:GetAttribute("Cash") or 0) < CrewsConfig.FEE then
		return false, "Starting a crew costs " .. CrewsConfig.FEE .. " cash."
	end
	local name = type(args.name) == "string" and cleanSpaces(args.name) or ""
	local tag = type(args.tag) == "string" and string.upper((args.tag:gsub("%s", ""))) or ""
	local color = args.color
	local logo = args.logo
	if #name < CrewsConfig.NAME_MIN or #name > CrewsConfig.NAME_MAX or not name:match("^[%w '%-_%.]+$") then
		return false, "Crew names are 3-20 letters, numbers or spaces."
	end
	if #tag < CrewsConfig.TAG_MIN or #tag > CrewsConfig.TAG_MAX or not tag:match("^[%w]+$") then
		return false, "Tags are 2-4 letters or numbers."
	end
	if type(color) ~= "number" or not CrewsConfig.COLORS[color] then
		return false, "Pick a crew colour."
	end
	if type(logo) ~= "number" or not CrewsConfig.LOGOS[logo] then
		return false, "Pick a crew logo."
	end
	local filteredName = filterBroadcast(name, player.UserId)
	local filteredTag = filterBroadcast(tag, player.UserId)
	if not filteredName or not filteredTag then
		return false, "Couldn't check that name right now. Try again."
	end
	if filteredName ~= name or filteredTag ~= tag then
		return false, "That name or tag isn't allowed. Try another."
	end

	local id = HttpService:GenerateGUID(false):gsub("-", ""):sub(1, 12)
	local lower = string.lower(name)
	if not claimName(lower, id) then
		return false, "A crew called " .. name .. " already exists."
	end
	if not PlayerData.spendCash(player, CrewsConfig.FEE, "Crew founded: " .. name) then
		releaseName(lower, id)
		return false, "Starting a crew costs " .. CrewsConfig.FEE .. " cash."
	end
	local now = os.time()
	local rec = {
		id = id,
		name = name,
		tag = tag,
		color = color,
		logo = logo,
		leader = player.UserId,
		createdAt = now,
		rep = 0,
		version = 1,
		members = {
			[uidKey(player.UserId)] = { name = player.DisplayName, role = "Leader", joined = now, server = SERVER_ID, seen = now, wins = player:GetAttribute("Wins") or 0 },
		},
		invites = {},
		announcement = nil,
		mission = nil,
	}
	rec.mission = (currentMission(rec, now))
	local saved = true
	if storeOk and store then
		local exists = false
		saved = retry(3, function()
			return (store :: DataStore):UpdateAsync("crew_" .. id, function(old)
				exists = old ~= nil
				if exists then
					return nil
				end
				return rec
			end)
		end) and not exists
	end
	if not saved then
		releaseName(lower, id)
		PlayerData.addCash(player, CrewsConfig.FEE, "Crew fee refund")
		return false, "Couldn't save your crew. Your fee was refunded - try again."
	end
	cache[id] = rec
	setRank(rec)
	leaderboardCache = nil
	if player.Parent then
		section.invites = {}
		attach(player, rec)
	end
	return true, "Welcome to " .. name .. " [" .. tag .. "]!"
end

function Crews.invite(from: Player, to: Player): (boolean, string?)
	local rec, why = myCrew(from)
	if not rec then
		return false, why
	end
	if rank(roleOf(rec, from.UserId)) < CrewsConfig.ROLE_RANK.Officer then
		return false, "Only officers and the leader can invite."
	end
	if to == from or not to.Parent then
		return false, "Pick someone else."
	end
	if crewIdOf[to] then
		return false, to.DisplayName .. " is already in a crew."
	end
	local toSection = PlayerData.section(to, "crew")
	if not toSection then
		return false, to.DisplayName .. " is still loading in."
	end
	if memberCount(rec) >= CrewsConfig.MAX_MEMBERS then
		return false, "Your crew is full."
	end
	local Social = lazy("Social")
	if Social and Social.allows then
		local ok, allowed, reason = pcall(Social.allows, from, to, "invite")
		if ok and not allowed then
			return false, reason or (to.DisplayName .. " isn't taking invites right now.")
		end
	end
	local key = uidKey(to.UserId)
	local ok, err, saved = editCrew(rec.id, function(r)
		if rank(roleOf(r, from.UserId)) < CrewsConfig.ROLE_RANK.Officer then
			return false, "Only officers and the leader can invite."
		end
		if r.members[key] then
			return false, to.DisplayName .. " is already in your crew."
		end
		pruneInvites(r)
		r.invites[key] = { by = from.DisplayName, at = os.time() }
		return true
	end)
	if not ok or not saved then
		return false, err
	end
	-- the invitee's own pending list (shown in their Crew app)
	for i = #toSection.invites, 1, -1 do
		local inv = toSection.invites[i]
		if inv.crewId == saved.id or os.time() - (inv.at or 0) > CrewsConfig.INVITE_DAYS * 86400 then
			table.remove(toSection.invites, i)
		end
	end
	table.insert(toSection.invites, 1, { crewId = saved.id, name = saved.name, tag = saved.tag, by = from.DisplayName, at = os.time() })
	while #toSection.invites > 10 do
		table.remove(toSection.invites)
	end
	PlayerData.markChanged(to)

	local Messages = lazy("Messages")
	local sent = false
	if Messages and Messages.sendInvite then
		local okCall, delivered, reason = pcall(Messages.sendInvite, from, to, "crew", {
			crewId = saved.id,
			label = saved.name .. " [" .. saved.tag .. "]", -- stored names are already filtered
		})
		if okCall and delivered then
			sent = true
		elseif okCall and reason then
			return false, reason
		end
	end
	if not sent then
		CrewEvent:FireClient(to, "invite", { crewId = saved.id, name = saved.name, tag = saved.tag, by = from.DisplayName })
		Net.notify(to, "CREW INVITE", from.DisplayName .. " invited you to " .. saved.name .. " [" .. saved.tag .. "]. Open the Crew app.")
	end
	changed(to)
	return true, "Invite sent to " .. to.DisplayName .. "."
end

local function dropInvite(player: Player, crewId: string)
	local section = PlayerData.section(player, "crew")
	if not section then
		return
	end
	for i = #section.invites, 1, -1 do
		if section.invites[i].crewId == crewId then
			table.remove(section.invites, i)
		end
	end
	PlayerData.markChanged(player)
end

function Crews.accept(player: Player, crewId: any): (boolean, string?)
	if type(crewId) ~= "string" or #crewId > 40 then
		return false, "That invite is no longer valid."
	end
	if crewIdOf[player] then
		return false, "Leave your crew before joining another."
	end
	local section = PlayerData.section(player, "crew")
	if not section then
		return false, "Your data is still loading."
	end
	if busy[player] then
		return false, "One moment..."
	end
	busy[player] = true
	local key = uidKey(player.UserId)
	local ok, why, rec = editCrew(crewId, function(r)
		pruneInvites(r)
		if r.members[key] then
			return true -- already a member (e.g. retried)
		end
		if not r.invites[key] then
			return false, "That invite expired. Ask for a new one."
		end
		if memberCount(r) >= CrewsConfig.MAX_MEMBERS then
			return false, "That crew is full."
		end
		r.invites[key] = nil
		local now = os.time()
		r.members[key] = { name = player.DisplayName, role = "Member", joined = now, server = SERVER_ID, seen = now, wins = player:GetAttribute("Wins") or 0 }
		return true
	end)
	busy[player] = nil
	dropInvite(player, crewId)
	if not ok or not rec then
		changed(player)
		return false, why
	end
	if not player.Parent then
		return false, nil
	end
	section.invites = {}
	attach(player, rec)
	afterEdit(rec, { title = "CREW", body = player.DisplayName .. " joined " .. rec.name .. "!" }, player)
	return true, "You joined " .. rec.name .. " [" .. rec.tag .. "]!"
end

function Crews.decline(player: Player, crewId: any): (boolean, string?)
	if type(crewId) ~= "string" or #crewId > 40 then
		return false, nil
	end
	-- [Security] only touch the crew record (a DataStore write) for an invite this player actually holds
	local section = PlayerData.section(player, "crew")
	local held = false
	for _, inv in (section and section.invites) or {} do
		if inv.crewId == crewId then
			held = true
			break
		end
	end
	if not held then
		return true, "Invite declined."
	end
	dropInvite(player, crewId)
	local key = uidKey(player.UserId)
	task.spawn(editCrew, crewId, function(r)
		if not r.invites or not r.invites[key] then
			return false
		end
		r.invites[key] = nil
		return true
	end)
	changed(player)
	return true, "Invite declined."
end

local function disbandCrew(rec: any, byName: string)
	local ok, why, saved = editCrew(rec.id, function(r)
		r.disbanded = true
		r.members = {}
		r.invites = {}
		return true
	end)
	if not ok or not saved then
		return false, why
	end
	releaseName(string.lower(saved.name), saved.id)
	if storeOk and rankStore then
		task.spawn(function()
			pcall(function()
				(rankStore :: OrderedDataStore):RemoveAsync(saved.id)
			end)
		end)
	end
	pending[saved.id] = nil
	leaderboardCache = nil
	afterEdit(saved, { title = "CREW", body = saved.name .. " was disbanded by " .. byName .. "." })
	return true, nil
end

function Crews.leave(player: Player): (boolean, string?)
	local rec, why = myCrew(player)
	if not rec then
		return false, why
	end
	local key = uidKey(player.UserId)
	if roleOf(rec, player.UserId) == "Leader" then
		if memberCount(rec) <= 1 then
			local ok, err = disbandCrew(rec, player.DisplayName)
			if ok then
				return true, "You left and the crew was disbanded."
			end
			return false, err
		end
		return false, "Make someone else leader first, or disband the crew."
	end
	flushCrew(rec.id)
	local ok, err, saved = editCrew(rec.id, function(r)
		if not r.members[key] then
			return true
		end
		if r.members[key].role == "Leader" then
			return false, "Make someone else leader first, or disband the crew."
		end
		r.members[key] = nil
		return true
	end)
	if not ok or not saved then
		return false, err
	end
	detach(player, nil)
	afterEdit(saved, { title = "CREW", body = player.DisplayName .. " left the crew." }, player)
	return true, "You left " .. saved.name .. "."
end

-- Role changes and kicks on any member, online or not.
local function manage(player: Player, action: string, targetId: any): (boolean, string?)
	local rec, why = myCrew(player)
	if not rec then
		return false, why
	end
	if type(targetId) ~= "number" or targetId % 1 ~= 0 or targetId == player.UserId then
		return false, "Pick another member."
	end
	local me, them = uidKey(player.UserId), uidKey(targetId)
	local targetName = "They"
	local resultMsg = ""
	local ok, err, saved = editCrew(rec.id, function(r)
		local myRole = r.members[me] and r.members[me].role
		local target = r.members[them]
		if not myRole then
			return false, "You're not in this crew anymore."
		end
		if not target then
			return false, "They're not in the crew anymore."
		end
		targetName = target.name or "They"
		if action == "kick" then
			if not (myRole == "Leader" or (myRole == "Officer" and target.role == "Member")) then
				return false, "You can't remove that member."
			end
			r.members[them] = nil
			resultMsg = targetName .. " was removed from the crew."
		elseif action == "promote" then
			if myRole ~= "Leader" or target.role ~= "Member" then
				return false, "Only the leader can promote members to officer."
			end
			target.role = "Officer"
			resultMsg = targetName .. " is now an officer."
		elseif action == "demote" then
			if myRole ~= "Leader" or target.role ~= "Officer" then
				return false, "Only the leader can demote officers."
			end
			target.role = "Member"
			resultMsg = targetName .. " is now a member."
		elseif action == "transfer" then
			if myRole ~= "Leader" then
				return false, "Only the leader can hand over the crew."
			end
			target.role = "Leader"
			r.members[me].role = "Officer"
			r.leader = targetId
			resultMsg = targetName .. " is the new crew leader."
		else
			return false, nil
		end
		return true
	end)
	if not ok or not saved then
		return false, err
	end
	if action == "kick" then
		local kicked = Players:GetPlayerByUserId(targetId)
		if kicked and crewIdOf[kicked] == saved.id then
			detach(kicked, "You were removed from " .. saved.name .. ".")
		end
	end
	afterEdit(saved, { title = "CREW", body = resultMsg })
	return true, resultMsg
end

function Crews.announce(player: Player, text: any): (boolean, string?)
	local rec, why = myCrew(player)
	if not rec then
		return false, why
	end
	if rank(roleOf(rec, player.UserId)) < CrewsConfig.ROLE_RANK.Officer then
		return false, "Only officers and the leader can post announcements."
	end
	if type(text) ~= "string" then
		return false, nil
	end
	text = cleanSpaces(text)
	if #text < 1 or utf8.len(text) == nil or #text > CrewsConfig.ANNOUNCE_MAX then
		return false, "Announcements are 1-" .. CrewsConfig.ANNOUNCE_MAX .. " characters."
	end
	local filtered = filterBroadcast(text, player.UserId)
	if not filtered then
		return false, "Couldn't post that right now. Try again."
	end
	local me = uidKey(player.UserId)
	local ok, err, saved = editCrew(rec.id, function(r)
		if rank(roleOf(r, player.UserId)) < CrewsConfig.ROLE_RANK.Officer or not r.members[me] then
			return false, "Only officers and the leader can post announcements."
		end
		r.announcement = { text = filtered, by = player.DisplayName, at = os.time() }
		return true
	end)
	if not ok or not saved then
		return false, err
	end
	afterEdit(saved, { title = "CREW ANNOUNCEMENT", body = filtered }, player)
	return true, "Announcement posted."
end

-- Public: the player's crew, or nil.
function Crews.crewOf(player: Player): { id: string, name: string, tag: string, color: Color3, role: string }?
	local id = crewIdOf[player]
	local rec = id and cache[id]
	if not rec or rec.disbanded then
		return nil
	end
	return { id = rec.id, name = rec.name, tag = rec.tag, color = colorOf(rec), role = roleOf(rec, player.UserId) or "Member" }
end

---------------------------------------------------------------------------
-- Loading players
---------------------------------------------------------------------------
local function onLoaded(player: Player)
	waitProbe()
	local section = PlayerData.section(player, "crew")
	if not section or not player.Parent then
		return
	end
	if type(section.invites) ~= "table" then
		section.invites = {}
	end
	local id = section.crewId
	if type(id) ~= "string" or id == "" or not storeOk then
		-- (without DataStore access the saved crew can't be read: keep the saved id untouched)
		setAttributes(player, nil)
		changed(player)
		return
	end
	local rec = readCrew(id, true)
	local key = uidKey(player.UserId)
	if not rec or rec.disbanded or not rec.members[key] then
		-- (in memory mode crews don't outlive the server, so the old id just clears)
		if rec and storeOk then
			detach(player, if rec.disbanded then rec.name .. " was disbanded while you were away." else "You're no longer in " .. rec.name .. ".")
		else
			detach(player, nil)
		end
		return
	end
	attach(player, rec)
	-- mark online + refresh name/wins
	task.spawn(function()
		local ok, _, saved = editCrew(id, function(r)
			local m = r.members[key]
			if not m then
				return false
			end
			m.server = SERVER_ID
			m.seen = os.time()
			m.name = player.DisplayName
			m.wins = player:GetAttribute("Wins") or m.wins or 0
			return true
		end)
		if ok and saved then
			afterEdit(saved, nil)
		end
	end)
end

local function onRemoving(player: Player)
	local id = crewIdOf[player]
	crewIdOf[player] = nil
	lastStats[player] = nil
	busy[player] = nil
	if not id then
		return
	end
	local key = uidKey(player.UserId)
	local wins = player:GetAttribute("Wins") or 0
	local p = pending[id]
	pending[id] = nil
	local ok, _, saved = editCrew(id, function(r)
		local m = r.members[key]
		if p then
			r.rep = (r.rep or 0) + p.rep
			local mission = currentMission(r, os.time())
			r.mission = mission
			local def = missionDef(mission.id)
			local gained = p.stats[def.stat]
			if gained and not mission.done then
				mission.progress = math.min(def.goal, mission.progress + gained)
				if mission.progress >= def.goal then
					mission.done = true
					r.rep += def.reward
				end
			end
		end
		if m then
			m.server = ""
			m.seen = os.time()
			m.wins = wins
		end
		return true
	end)
	if ok and saved then
		setRank(saved)
		afterEdit(saved, nil)
	elseif p and cache[id] and not cache[id].disbanded then
		addPending(id, p.rep, nil, nil)
	end
end

---------------------------------------------------------------------------
-- Start
---------------------------------------------------------------------------
local ACTIONS: { [string]: { cooldown: number, run: (Player, any) -> (boolean, string?) } } = {
	create = { cooldown = 4, run = Crews.create },
	invite = {
		cooldown = 2,
		run = function(player, args)
			local target = type(args) == "table" and args.target
			if typeof(target) ~= "Instance" or not target:IsA("Player") then
				return false, "Pick a player."
			end
			return Crews.invite(player, target)
		end,
	},
	accept = { cooldown = 1, run = function(player, args)
		return Crews.accept(player, type(args) == "table" and args.crewId)
	end },
	decline = { cooldown = 0.5, run = function(player, args)
		return Crews.decline(player, type(args) == "table" and args.crewId)
	end },
	leave = { cooldown = 2, run = function(player)
		return Crews.leave(player)
	end },
	disband = {
		cooldown = 3,
		run = function(player)
			local rec, why = myCrew(player)
			if not rec then
				return false, why
			end
			if roleOf(rec, player.UserId) ~= "Leader" then
				return false, "Only the leader can disband the crew."
			end
			local ok, err = disbandCrew(rec, player.DisplayName)
			return ok, if ok then "Crew disbanded." else err
		end,
	},
	announce = { cooldown = 10, run = function(player, args)
		return Crews.announce(player, type(args) == "table" and args.text)
	end },
}
for _, action in { "kick", "promote", "demote", "transfer" } do
	ACTIONS[action] = { cooldown = 1, run = function(player, args)
		return manage(player, action, type(args) == "table" and args.userId)
	end }
end

function Crews.start(_city: Instance?)
	-- Probe DataStore access once (fails fast in Studio without API access).
	task.spawn(function()
		if store then
			-- a few tries: one hiccup must not put a live server into memory mode
			local ok = retry(if RunService:IsStudio() then 1 else 3, function()
				return (store :: DataStore):GetAsync("probe")
			end)
			storeOk = ok
		end
		probeDone = true
		if not storeOk then
			warn("[CityGrind] Crews are running in memory only (no DataStore access).")
			return
		end
		pcall(function()
			MessagingService:SubscribeAsync(TOPIC, function(message)
				local data = message.Data
				if type(data) ~= "table" or type(data.id) ~= "string" or data.server == SERVER_ID then
					return
				end
				local relevant = cache[data.id] ~= nil
				for _, crewId in crewIdOf do
					if crewId == data.id then
						relevant = true
					end
				end
				if not relevant then
					return
				end
				readCrew(data.id, true)
				refreshMembers(data.id)
				if type(data.title) == "string" and type(data.body) == "string" then
					notifyCrew(data.id, data.title, data.body)
				end
			end)
		end)
	end)

	CrewRequest.OnServerInvoke = function(player: Player, action: any, args: any)
		local entry = type(action) == "string" and ACTIONS[action]
		if not entry then
			return { ok = false, message = "Unknown action." }
		end
		if not Net.allow(player, "Crew" .. action, entry.cooldown) then
			return { ok = false, message = "Slow down a little." }
		end
		local ok, result, message = pcall(entry.run, player, args)
		if not ok then
			warn("[CityGrind] Crew action failed:", result)
			return { ok = false, message = "Something went wrong. Try again." }
		end
		leaderboardCache = if action == "create" or action == "disband" then nil else leaderboardCache
		return { ok = result == true, message = message }
	end

	CrewGet.OnServerInvoke = function(player: Player)
		if not Net.allow(player, "CrewGet", 0.5) then
			return nil
		end
		local ok, snap = pcall(snapshotFor, player)
		return if ok then snap else nil
	end

	-- Crew invite cards in the Messages app.
	task.spawn(function()
		local Messages = lazy("Messages")
		if Messages and Messages.onInvite then
			Messages.onInvite("crew", function(_from: Player?, to: Player, payload: any)
				-- Messages shows the returned message to the player
				return Crews.accept(to, type(payload) == "table" and payload.crewId or nil)
			end)
		end
	end)

	PlayerData.onLoaded(onLoaded)
	Players.PlayerAdded:Connect(watchStats)
	for _, player in Players:GetPlayers() do
		watchStats(player)
	end
	Players.PlayerRemoving:Connect(onRemoving)

	task.spawn(function()
		while true do
			task.wait(FLUSH_SECONDS)
			local ok, err = pcall(flushAll)
			if not ok then
				warn("[CityGrind] Crew flush failed:", err)
			end
		end
	end)

	game:BindToClose(function()
		if not storeOk then
			return
		end
		local count = 0
		for player in crewIdOf do
			count += 1
			task.spawn(function()
				onRemoving(player)
				count -= 1
			end)
		end
		local deadline = os.clock() + 20
		while count > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
		pcall(flushAll)
	end)
end

return Crews

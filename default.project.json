{
  "name": "city-grind",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "CityGrind": {
        "$className": "Folder",
        "Config": { "$path": "src/shared/Config.luau" }
      }
    },
    "ServerScriptService": {
      "CityGrindServer": {
        "$path": "src/server/Main.server.luau",
        "PlayerData": { "$path": "src/server/PlayerData.luau" },
        "CityBuilder": { "$path": "src/server/CityBuilder.luau" }
      }
    },
    "StarterPlayer": {
      "$properties": { "EnableMouseLockOption": false },
      "StarterPlayerScripts": {
        "CityGrindClient": {
          "$path": "src/client/Client.client.luau",
          "UI": { "$path": "src/client/UI.luau" },
          "Movement": { "$path": "src/client/Movement.luau" },
          "HUD": { "$path": "src/client/HUD.luau" },
          "Phone": { "$path": "src/client/Phone.luau" }
        }
      }
    }
  }
}

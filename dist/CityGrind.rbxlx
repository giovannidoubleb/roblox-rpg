      <Item class="ModuleScript" referent="RBX00000004">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- CITY GRIND: shared tuning values. Lives in ReplicatedStorage.CityGrind.Config
-- so the server and every client read the same numbers.

local Config = {}

Config.DATASTORE_NAME = "CityGrind_PlayerData_v1"
Config.AUTOSAVE_SECONDS = 120
Config.SESSION_LOCK_SECONDS = 180

Config.STARTING_CASH = 500
Config.MAX_CASH = 1_000_000_000
Config.MAX_LEVEL = 100
Config.MAX_TRANSACTIONS = 25

-- Total XP needed to go from `level` to `level + 1`.
function Config.xpToNext(level: number): number
	return math.floor(100 * level ^ 1.5)
end

Config.REPUTATION_RANKS = {
	{ min = 0, name = "Nobody" },
	{ min = 100, name = "Known" },
	{ min = 500, name = "Respected" },
	{ min = 1000, name = "Local Star" },
	{ min = 2500, name = "City Famous" },
	{ min = 5000, name = "Celebrity" },
	{ min = 10000, name = "Legend" },
}

function Config.reputationRank(rep: number): string
	local name = Config.REPUTATION_RANKS[1].name
	for _, rank in Config.REPUTATION_RANKS do
		if rep >= rank.min then
			name = rank.name
		end
	end
	return name
end

-- Attribute names. Stats are 1-99 like a sports game rating.
Config.STATS = {
	"Strength", "Speed", "Stamina", "Vertical",
	"Shooting", "BallHandling", "Passing", "Defense", "Finishing",
}

-- Movement. Stamina stat (1-99) scales max stamina and recovery.
Config.WALK_SPEED = 14
Config.SPRINT_SPEED = 24
Config.CROUCH_SPEED = 7
Config.SLIDE_SPEED = 34
Config.SLIDE_SECONDS = 0.7
Config.SLIDE_COST = 15
Config.SPRINT_DRAIN_PER_SEC = 12
Config.MIN_SPRINT_STAMINA = 10

function Config.maxStamina(staminaStat: number): number
	return 100 + (staminaStat - 1) * 2 -- 100 at stat 1, ~296 at stat 99
end

function Config.staminaRegen(staminaStat: number): number
	return 14 + staminaStat * 0.25 -- per second
end

-- Neighborhood run route rewards (server validated).
Config.RUN_REWARD_XP = 40
Config.RUN_REWARD_CASH = 25
Config.RUN_STAMINA_STAT_XP = 20 -- progress toward +1 Stamina stat
Config.RUN_COOLDOWN = 45
Config.STAT_XP_PER_POINT = 100

Config.DRINK_PRICE = 5

Config.WALLPAPERS = {
	{ name = "Sunset", top = Color3.fromRGB(255, 120, 80), bottom = Color3.fromRGB(90, 40, 140) },
	{ name = "Court", top = Color3.fromRGB(255, 160, 40), bottom = Color3.fromRGB(150, 60, 20) },
	{ name = "Midnight", top = Color3.fromRGB(30, 40, 90), bottom = Color3.fromRGB(5, 5, 20) },
	{ name = "Ocean", top = Color3.fromRGB(60, 200, 230), bottom = Color3.fromRGB(10, 60, 140) },
	{ name = "Mint", top = Color3.fromRGB(120, 230, 170), bottom = Color3.fromRGB(20, 110, 90) },
}

Config.UI_SCALES = { 0.8, 0.9, 1, 1.1, 1.25 }

-- Basketball (sections 70, 71). Distances are in studs.
Config.Ball = {
	DIAMETER = 1.5,
	GRAVITY = 90, -- the ball floats a little so shots arc like real ones
	PICKUP_RANGE = 3.4,
	STEAL_RANGE = 5.5,
	STEAL_COOLDOWN = 1.2,
	REGRAB_COOLDOWN = 0.6,
	PERFECT_RELEASE = 0.55, -- seconds of holding the shot button
	RELEASE_WINDOW = 0.45, -- how far from perfect still counts for anything
	PERFECT_TOLERANCE = 0.06,
	MAX_SHOT_RANGE = 60,
	THREE_POINT_RANGE = 19,
	DUNK_RANGE = 6,
	BLOCK_RANGE = 5,
	CONTEST_RANGE = 6,
	PASS_RANGE = 60,
	FREE_BALLS_PER_COURT = 6,
	FREE_BALL_IDLE_SECONDS = 60,
}

Config.Game = {
	TARGET_SCORE = 11,
	TIME_LIMIT = 6 * 60,
	COUNTDOWN = 5,
	MAX_TEAM_SIZE = 3,
	MIN_SECONDS_FOR_REWARDS = 60,
	MIN_POINTS_FOR_REWARDS = 5,
	WIN_CASH = 60,
	WIN_XP = 80,
	WIN_REP = 15,
	LOSS_CASH = 20,
	LOSS_XP = 30,
	LOSS_REP = 3,
}

return Config
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX00000005"><Properties><string name="Name">ServerScriptService</string></Properties>
    <Item class="Script" referent="RBX00000006">
      <Properties>
        <string name="Name">CityGrindServer</string>
        <ProtectedString name="Source"><![CDATA[-- CITY GRIND: server entry point (ServerScriptService.CityGrindServer).
-- Builds the city, owns player data, and validates every remote.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local shared = ReplicatedStorage:WaitForChild("CityGrind")
local Config = require(shared:WaitForChild("Config"))
local PlayerData = require(script:WaitForChild("PlayerData"))
local CityBuilder = require(script:WaitForChild("CityBuilder"))
local Basketball = require(script:WaitForChild("Basketball"))
local CourtGames = require(script:WaitForChild("CourtGames"))

---------------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------------
local remotes = shared:FindFirstChild("Remotes") or Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = shared

local function remote(className: string, name: string): any
	local r = remotes:FindFirstChild(name) or Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end

local Notify = remote("RemoteEvent", "Notify") -- server -> client (title, body)
local StaminaRefill = remote("RemoteEvent", "StaminaRefill") -- server -> client
local PhoneState = remote("RemoteEvent", "PhoneState") -- client -> server (isOpen)
local GetProfile = remote("RemoteFunction", "GetProfile") -- client -> server
local SetSetting = remote("RemoteFunction", "SetSetting") -- client -> server (key, value)
local BallAction = remote("RemoteEvent", "BallAction") -- client -> server (action)
local BallFx = remote("RemoteEvent", "BallFx") -- server -> client (kind, ...)

-- Simple per-player cooldowns so no remote can be spammed.
local lastCall: { [Player]: { [string]: number } } = {}
local function allow(player: Player, key: string, cooldown: number): boolean
	local now = os.clock()
	local calls = lastCall[player]
	if not calls then
		calls = {}
		lastCall[player] = calls
	end
	if calls[key] and now - calls[key] < cooldown then
		return false
	end
	calls[key] = now
	return true
end

PlayerData.onNotify.Event:Connect(function(player: Player, title: string, body: string)
	Notify:FireClient(player, title, body)
end)

---------------------------------------------------------------------------
-- City
---------------------------------------------------------------------------
local city = CityBuilder.build()

---------------------------------------------------------------------------
-- Phone: profile, bank and settings data
---------------------------------------------------------------------------
GetProfile.OnServerInvoke = function(player: Player)
	if not allow(player, "GetProfile", 0.5) then
		return nil
	end
	return PlayerData.publicSnapshot(player)
end

SetSetting.OnServerInvoke = function(player: Player, key: any, value: any)
	if not allow(player, "SetSetting", 0.3) then
		return false
	end
	if type(key) ~= "string" then
		return false
	end
	return PlayerData.setSetting(player, key, value)
end

-- Taking the phone out puts a real phone in the character's hand,
-- so other players can see who is on their phone.
local function setPhoneProp(player: Player, isOpen: boolean)
	local character = player.Character
	if not character then
		return
	end
	local existing = character:FindFirstChild("CityPhone")
	if existing then
		existing:Destroy()
	end
	player:SetAttribute("PhoneOut", isOpen)
	if not isOpen then
		return
	end
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return
	end
	local phone = Instance.new("Part")
	phone.Name = "CityPhone"
	phone.Size = Vector3.new(0.45, 0.9, 0.08)
	phone.Color = Color3.fromRGB(20, 20, 24)
	phone.Material = Enum.Material.SmoothPlastic
	phone.CanCollide = false
	phone.CanQuery = false
	phone.CanTouch = false
	phone.Massless = true
	local screen = Instance.new("Part")
	screen.Name = "Screen"
	screen.Size = Vector3.new(0.38, 0.8, 0.02)
	screen.Color = Color3.fromRGB(120, 170, 255)
	screen.Material = Enum.Material.Neon
	screen.CanCollide = false
	screen.CanQuery = false
	screen.CanTouch = false
	screen.Massless = true
	screen.Parent = phone
	local screenWeld = Instance.new("WeldConstraint")
	screen.CFrame = phone.CFrame * CFrame.new(0, 0, -0.05)
	screenWeld.Part0 = phone
	screenWeld.Part1 = screen
	screenWeld.Parent = screen
	local offset = if hand.Name == "RightHand" then CFrame.new(0, -0.25, -0.25) else CFrame.new(0, -1, -0.3)
	phone.CFrame = hand.CFrame * offset * CFrame.Angles(math.rad(-70), 0, 0)
	screen.CFrame = phone.CFrame * CFrame.new(0, 0, -0.05)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hand
	weld.Part1 = phone
	weld.Parent = phone
	phone.Parent = character
end

PhoneState.OnServerEvent:Connect(function(player: Player, isOpen: any)
	if type(isOpen) ~= "boolean" or not allow(player, "PhoneState", 0.25) then
		return
	end
	setPhoneProp(player, isOpen)
end)

---------------------------------------------------------------------------
-- Vending machine: spend $5, get a full stamina refill
---------------------------------------------------------------------------
if city.vendingPrompt then
	local prompt = city.vendingPrompt
	prompt.Triggered:Connect(function(player: Player)
		if not allow(player, "Vending", 2) then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local machine = prompt.Parent :: BasePart
		if not root or (root.Position - machine.Position).Magnitude > prompt.MaxActivationDistance + 4 then
			return
		end
		if PlayerData.spendCash(player, Config.DRINK_PRICE, "Corner Mart energy drink") then
			StaminaRefill:FireClient(player)
			Notify:FireClient(player, "ENERGY DRINK", "Stamina fully restored.")
		else
			Notify:FireClient(player, "NOT ENOUGH CASH", "You need $" .. Config.DRINK_PRICE .. ".")
		end
	end)
end

---------------------------------------------------------------------------
-- Neighborhood run route (section 57's 5K, scaled to District 1)
-- The server checks the order of checkpoints and the time between them,
-- so a teleporting or speed-hacking client cannot claim the reward.
---------------------------------------------------------------------------
type RunState = { nextIndex: number, startedAt: number, legStartedAt: number }
local runs: { [Player]: RunState } = {}
local runCooldownUntil: { [Player]: number } = {}
local route = CityBuilder.RUN_ROUTE
local MAX_AVG_SPEED = Config.SLIDE_SPEED -- nobody can average faster than a slide

local function legDistance(fromIndex: number, toIndex: number): number
	local a, b = route[fromIndex], route[toIndex]
	return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end

local function setRunAttributes(player: Player)
	local run = runs[player]
	player:SetAttribute("RunNext", if run then run.nextIndex else 0)
	player:SetAttribute("RunStartedAt", if run then run.startedAt else 0)
end

local function onCheckpoint(player: Player, index: number)
	local now = workspace:GetServerTimeNow()
	local run = runs[player]

	if not run then
		if index ~= 1 then
			return
		end
		if (runCooldownUntil[player] or 0) > now then
			if allow(player, "RunCooldownMsg", 5) then
				local wait = math.ceil(runCooldownUntil[player] - now)
				Notify:FireClient(player, "CATCH YOUR BREATH", "Next run in " .. wait .. "s.")
			end
			return
		end
		runs[player] = { nextIndex = 2, startedAt = now, legStartedAt = now }
		setRunAttributes(player)
		Notify:FireClient(player, "RUN STARTED", "Hit every checkpoint and come back to the start.")
		return
	end

	-- Ignore the start arch while still standing in it, and any out-of-order arch.
	local expected = if run.nextIndex > #route then 1 else run.nextIndex
	if index ~= expected then
		return
	end

	local previous = if expected == 1 then #route else expected - 1
	local minTime = legDistance(previous, expected) / MAX_AVG_SPEED
	if now - run.legStartedAt < minTime then
		runs[player] = nil
		setRunAttributes(player)
		Notify:FireClient(player, "RUN CANCELLED", "That checkpoint was reached impossibly fast.")
		return
	end
	run.legStartedAt = now

	if expected ~= 1 then
		run.nextIndex += 1
		setRunAttributes(player)
		return
	end

	-- Finished the loop.
	local seconds = math.floor((now - run.startedAt) * 10) / 10
	runs[player] = nil
	runCooldownUntil[player] = now + Config.RUN_COOLDOWN
	setRunAttributes(player)
	PlayerData.recordRun(player, seconds)
	PlayerData.addCash(player, Config.RUN_REWARD_CASH, "Neighborhood run")
	PlayerData.addXP(player, Config.RUN_REWARD_XP)
	PlayerData.addStatXP(player, "Stamina", Config.RUN_STAMINA_STAT_XP)
	PlayerData.addStatXP(player, "Speed", math.floor(Config.RUN_STAMINA_STAT_XP / 2))
	PlayerData.addReputation(player, 2)
	Notify:FireClient(
		player,
		"RUN COMPLETE",
		string.format("%.1fs  +$%d  +%d XP  +Stamina", seconds, Config.RUN_REWARD_CASH, Config.RUN_REWARD_XP)
	)
end

for index, trigger in city.runTriggers do
	trigger.Touched:Connect(function(hit: BasePart)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		if not player then
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 or humanoid.SeatPart then
			return
		end
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root or (root.Position - trigger.Position).Magnitude > 14 then
			return
		end
		onCheckpoint(player, index)
	end)
end

---------------------------------------------------------------------------
-- Basketball (Phase 2). The client only reports button presses.
---------------------------------------------------------------------------
Basketball.announce = function(players: { Player }, text: string)
	for _, player in players do
		BallFx:FireClient(player, "Callout", text)
	end
end
Basketball.dunkJump = function(player: Player, rim: Vector3)
	BallFx:FireClient(player, "Dunk", rim)
end
Basketball.onTrain = function(player: Player, statName: string, amount: number)
	PlayerData.addStatXP(player, statName, amount)
end

local BALL_ACTIONS = {
	ShootStart = { cooldown = 0.15, fn = Basketball.shootStart },
	ShootRelease = { cooldown = 0.05, fn = Basketball.shootRelease },
	Pass = { cooldown = 0.3, fn = Basketball.pass },
	Steal = { cooldown = 0.3, fn = Basketball.steal },
}
BallAction.OnServerEvent:Connect(function(player: Player, action: any)
	local entry = type(action) == "string" and BALL_ACTIONS[action]
	if entry and allow(player, "Ball" .. action, entry.cooldown) then
		entry.fn(player)
	end
end)

CourtGames.start()

---------------------------------------------------------------------------
-- Player lifecycle
---------------------------------------------------------------------------
-- Shift is Sprint, so turn off Roblox's Shift-to-lock-mouse toggle.
game:GetService("StarterPlayer").EnableMouseLockOption = false

local function onPlayerAdded(player: Player)
	player.DevEnableMouseLock = false
	if player.Character then
		Basketball.tagCharacter(player.Character)
	end
	player.CharacterAdded:Connect(function(character)
		Basketball.tagCharacter(character)
		-- dying or respawning cancels a run in progress
		runs[player] = nil
		setRunAttributes(player)
		player:SetAttribute("PhoneOut", false)
	end)
end
Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	onPlayerAdded(player)
end

Players.PlayerRemoving:Connect(function(player)
	runs[player] = nil
	runCooldownUntil[player] = nil
	lastCall[player] = nil
end)

PlayerData.start()

---------------------------------------------------------------------------
-- Day / night (section 67). One full day every 20 minutes.
---------------------------------------------------------------------------
local DAY_LENGTH_SECONDS = 20 * 60
local lampsOn: boolean? = nil
RunService.Heartbeat:Connect(function(dt)
	Lighting.ClockTime = (Lighting.ClockTime + dt * 24 / DAY_LENGTH_SECONDS) % 24
	local night = Lighting.ClockTime < 6.3 or Lighting.ClockTime > 17.7
	if night ~= lampsOn then
		lampsOn = night
		for _, light in city.lamps do
			light.Enabled = night
			local head = light.Parent
			if head and head:IsA("BasePart") then
				head.Material = if night then Enum.Material.Neon else Enum.Material.SmoothPlastic
			end
		end
	end
end)
]]></ProtectedString>
      </Properties>
      <Item class="ModuleScript" referent="RBX00000007">
        <Properties>
          <string name="Name">PlayerData</string>
          <ProtectedString name="Source"><![CDATA[-- CITY GRIND: server-authoritative player data.
-- The server owns every number. Clients only ever see copies through
-- Player attributes (read-only for them) and the GetProfile remote.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("CityGrind"):WaitForChild("Config"))

local PlayerData = {}

local SERVER_ID = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[CityGrind] DataStore unavailable, progress will NOT save this session:", result)
	end
end

local profiles: { [Player]: any } = {}
local dirty: { [Player]: boolean } = {}
local loadFailed: { [Player]: boolean } = {}

-- Fired as (player, title, body). Main wires this to the Notify remote.
PlayerData.onNotify = Instance.new("BindableEvent")

local function defaultProfile()
	local stats = {}
	for _, stat in Config.STATS do
		stats[stat] = 1
	end
	local statXP = {}
	for _, stat in Config.STATS do
		statXP[stat] = 0
	end
	return {
		version = 1,
		cash = Config.STARTING_CASH,
		xp = 0,
		level = 1,
		reputation = 0,
		fame = 0,
		stats = stats,
		statXP = statXP,
		runsCompleted = 0,
		bestRunSeconds = 0,
		basketball = { games = 0, wins = 0, losses = 0, points = 0, threes = 0, dunks = 0, blocks = 0, steals = 0 },
		transactions = {
			{ t = os.time(), amount = Config.STARTING_CASH, label = "Welcome to the city" },
		},
		settings = { wallpaper = 1, uiScale = 1, notificationSounds = true },
		firstJoin = os.time(),
	}
end

-- Fill in any fields added after a player's data was first saved.
local function reconcile(data: any)
	local template = defaultProfile()
	for key, value in template do
		if data[key] == nil then
			data[key] = value
		elseif type(value) == "table" and type(data[key]) == "table" and key ~= "transactions" then
			for subKey, subValue in value do
				if data[key][subKey] == nil then
					data[key][subKey] = subValue
				end
			end
		end
	end
	return data
end

local function publish(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	player:SetAttribute("Cash", data.cash)
	player:SetAttribute("XP", data.xp)
	player:SetAttribute("Level", data.level)
	player:SetAttribute("XPToNext", Config.xpToNext(data.level))
	player:SetAttribute("Reputation", data.reputation)
	player:SetAttribute("Rank", Config.reputationRank(data.reputation))
	player:SetAttribute("Fame", data.fame)
	player:SetAttribute("Wallpaper", data.settings.wallpaper)
	player:SetAttribute("UIScale", data.settings.uiScale)
	player:SetAttribute("NotificationSounds", data.settings.notificationSounds)
	for _, stat in Config.STATS do
		player:SetAttribute(stat, data.stats[stat])
	end
	player:SetAttribute("Wins", data.basketball.wins)
	player:SetAttribute("Losses", data.basketball.losses)
	player:SetAttribute("DataLoaded", true)
end

local function retry<T>(attempts: number, fn: () -> T): (boolean, T | string)
	local ok, result
	for attempt = 1, attempts do
		ok, result = pcall(fn)
		if ok then
			return true, result
		end
		task.wait(attempt * 2)
	end
	return false, result
end

function PlayerData.load(player: Player)
	local key = "player_" .. player.UserId
	local data

	if store then
		local lockedElsewhere = false
		for _ = 1, 5 do
			lockedElsewhere = false
			local ok, result = retry(3, function()
				return (store :: DataStore):UpdateAsync(key, function(saved)
					saved = saved or defaultProfile()
					local lock = saved.sessionLock
					if lock and lock.server ~= SERVER_ID and os.time() - lock.time < Config.SESSION_LOCK_SECONDS then
						lockedElsewhere = true
						return nil -- leave the record untouched
					end
					saved.sessionLock = { server = SERVER_ID, time = os.time() }
					return saved
				end)
			end)
			if not ok then
				warn("[CityGrind] Load failed for", player.Name, result)
				loadFailed[player] = true
				player:Kick("City Grind could not load your save. Please rejoin in a minute.")
				return
			end
			if not lockedElsewhere then
				data = result
				break
			end
			task.wait(4) -- previous server is still releasing the save
		end
		if lockedElsewhere then
			loadFailed[player] = true
			player:Kick("Your save is still open on another server. Please rejoin in a minute.")
			return
		end
	else
		data = defaultProfile()
	end

	if not player.Parent then
		return -- left while loading
	end
	data.sessionLock = nil
	profiles[player] = reconcile(data)
	publish(player)
end

function PlayerData.save(player: Player, releaseLock: boolean)
	local data = profiles[player]
	if not data or not store or loadFailed[player] then
		return
	end
	local key = "player_" .. player.UserId
	local ok, err = retry(3, function()
		return (store :: DataStore):UpdateAsync(key, function(saved)
			local lock = saved and saved.sessionLock
			if lock and lock.server ~= SERVER_ID then
				return nil -- another server took over; never overwrite its data
			end
			local copy = table.clone(data)
			copy.sessionLock = if releaseLock then nil else { server = SERVER_ID, time = os.time() }
			return copy
		end)
	end)
	if ok then
		dirty[player] = nil
	else
		warn("[CityGrind] Save failed for", player.Name, err)
	end
end

function PlayerData.release(player: Player)
	PlayerData.save(player, true)
	profiles[player] = nil
	dirty[player] = nil
	loadFailed[player] = nil
end

function PlayerData.get(player: Player)
	return profiles[player]
end

local function markChanged(player: Player)
	dirty[player] = true
	publish(player)
end

local function addTransaction(data, amount: number, label: string)
	table.insert(data.transactions, 1, { t = os.time(), amount = amount, label = label })
	while #data.transactions > Config.MAX_TRANSACTIONS do
		table.remove(data.transactions)
	end
end

function PlayerData.addCash(player: Player, amount: number, label: string): boolean
	local data = profiles[player]
	if not data or amount <= 0 or amount ~= amount then
		return false
	end
	amount = math.floor(amount)
	data.cash = math.min(data.cash + amount, Config.MAX_CASH)
	addTransaction(data, amount, label)
	markChanged(player)
	return true
end

function PlayerData.spendCash(player: Player, amount: number, label: string): boolean
	local data = profiles[player]
	if not data or amount <= 0 or amount ~= amount then
		return false
	end
	amount = math.floor(amount)
	if data.cash < amount then
		return false
	end
	data.cash -= amount
	addTransaction(data, -amount, label)
	markChanged(player)
	return true
end

function PlayerData.addXP(player: Player, amount: number)
	local data = profiles[player]
	if not data or amount <= 0 then
		return
	end
	data.xp += math.floor(amount)
	while data.level < Config.MAX_LEVEL and data.xp >= Config.xpToNext(data.level) do
		data.xp -= Config.xpToNext(data.level)
		data.level += 1
		PlayerData.onNotify:Fire(player, "LEVEL UP", "You reached level " .. data.level .. "!")
	end
	if data.level >= Config.MAX_LEVEL then
		data.xp = 0
	end
	markChanged(player)
end

function PlayerData.addReputation(player: Player, amount: number)
	local data = profiles[player]
	if not data or amount <= 0 then
		return
	end
	local before = Config.reputationRank(data.reputation)
	data.reputation += math.floor(amount)
	local after = Config.reputationRank(data.reputation)
	if after ~= before then
		PlayerData.onNotify:Fire(player, "NEW RANK", "People around the city now call you " .. after .. ".")
	end
	markChanged(player)
end

-- Training progress toward a stat. Every STAT_XP_PER_POINT raises it by 1 (max 99).
function PlayerData.addStatXP(player: Player, stat: string, amount: number)
	local data = profiles[player]
	if not data or data.stats[stat] == nil or amount <= 0 then
		return
	end
	data.statXP[stat] += amount
	while data.statXP[stat] >= Config.STAT_XP_PER_POINT and data.stats[stat] < 99 do
		data.statXP[stat] -= Config.STAT_XP_PER_POINT
		data.stats[stat] += 1
		PlayerData.onNotify:Fire(player, "STAT UP", stat .. " is now " .. data.stats[stat] .. ".")
	end
	markChanged(player)
end

-- Only whitelisted settings with validated values can be written by a client.
local SETTING_VALIDATORS = {
	wallpaper = function(v)
		return type(v) == "number" and v % 1 == 0 and Config.WALLPAPERS[v] ~= nil
	end,
	uiScale = function(v)
		return table.find(Config.UI_SCALES, v) ~= nil
	end,
	notificationSounds = function(v)
		return type(v) == "boolean"
	end,
}

function PlayerData.setSetting(player: Player, key: string, value: any): boolean
	local data = profiles[player]
	local validate = SETTING_VALIDATORS[key]
	if not data or not validate or not validate(value) then
		return false
	end
	data.settings[key] = value
	markChanged(player)
	return true
end

function PlayerData.recordRun(player: Player, seconds: number)
	local data = profiles[player]
	if not data then
		return
	end
	data.runsCompleted += 1
	if data.bestRunSeconds == 0 or seconds < data.bestRunSeconds then
		data.bestRunSeconds = seconds
	end
	markChanged(player)
end

-- Adds to the saved basketball career totals (only known keys, only positive).
function PlayerData.recordBasketball(player: Player, deltas: { [string]: number })
	local data = profiles[player]
	if not data then
		return
	end
	for key, amount in deltas do
		if data.basketball[key] ~= nil and type(amount) == "number" and amount > 0 then
			data.basketball[key] += math.floor(amount)
		end
	end
	markChanged(player)
end

-- What the phone's Profile and Bank apps are allowed to see.
function PlayerData.publicSnapshot(player: Player)
	local data = profiles[player]
	if not data then
		return nil
	end
	return {
		cash = data.cash,
		level = data.level,
		xp = data.xp,
		xpToNext = Config.xpToNext(data.level),
		reputation = data.reputation,
		rank = Config.reputationRank(data.reputation),
		fame = data.fame,
		stats = table.clone(data.stats),
		runsCompleted = data.runsCompleted,
		bestRunSeconds = data.bestRunSeconds,
		basketball = table.clone(data.basketball),
		transactions = table.clone(data.transactions),
		firstJoin = data.firstJoin,
	}
end

function PlayerData.start()
	Players.PlayerAdded:Connect(PlayerData.load)
	for _, player in Players:GetPlayers() do
		task.spawn(PlayerData.load, player)
	end
	Players.PlayerRemoving:Connect(PlayerData.release)

	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for player in dirty do
				task.spawn(PlayerData.save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				PlayerData.release(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.25)
		end
	end)
end

return PlayerData
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000008">
        <Properties>
          <string name="Name">CityBuilder</string>
          <ProtectedString name="Source"><![CDATA[-- CITY GRIND: builds District 1, The Neighborhood.
-- Runs once on the server when Workspace has no "City" model, so a place file
-- that already contains a hand-edited City is left alone.
--
-- Layout (top-down, +x east, +z south):
--   Main road along x (z = 0), cross road along z (x = 0), sidewalks on both.
--   NW: Starter apartments, park + playground    NE: Outdoor court, Iron Box gym, subway
--   SW: Corner Mart, Fresh Cuts barber, Threads  SE: Mama's Kitchen, Budget Wheels lot

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local CityBuilder = {}

local ROAD_W = 32
local WALK_W = 8
local GROUND_X = 600
local GROUND_Z = 460

local city: Model
local folders: { [string]: Folder } = {}

local function folder(name: string): Folder
	if not folders[name] then
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = city
		folders[name] = f
	end
	return folders[name]
end

type PartProps = {
	name: string?,
	size: Vector3,
	cframe: CFrame,
	color: Color3?,
	material: Enum.Material?,
	transparency: number?,
	collide: boolean?,
	shape: Enum.PartType?,
	parent: Instance?,
}

local function part(p: PartProps): BasePart
	local b = Instance.new("Part")
	b.Name = p.name or "Part"
	b.Anchored = true
	b.Size = p.size
	b.CFrame = p.cframe
	b.Color = p.color or Color3.fromRGB(160, 160, 160)
	b.Material = p.material or Enum.Material.SmoothPlastic
	b.Transparency = p.transparency or 0
	b.CanCollide = if p.collide == nil then true else p.collide
	if p.shape then
		b.Shape = p.shape
	end
	b.TopSurface = Enum.SurfaceType.Smooth
	b.BottomSurface = Enum.SurfaceType.Smooth
	b.Parent = p.parent or city
	return b
end

local function sign(target: BasePart, face: Enum.NormalId, text: string, textColor: Color3, bg: Color3?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = bg or Color3.new(0, 0, 0)
	label.BackgroundTransparency = if bg then 0 else 1
	label.Text = text
	label.TextColor3 = textColor
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.Parent = gui
	return gui
end

-- Marks a spot the phone's Map app can navigate to.
local function mapPoint(name: string, category: string, position: Vector3)
	local p = part({
		name = name,
		size = Vector3.new(1, 1, 1),
		cframe = CFrame.new(position),
		transparency = 1,
		collide = false,
		parent = folder("MapPoints"),
	})
	p.CanQuery = false
	p.CanTouch = false
	p:SetAttribute("Category", category)
end

-- A solid building with floors of windows on the side facing the road.
-- facing = 1 means the front is on the +z side, -1 means -z.
local function building(opts: {
	name: string,
	center: Vector3,
	size: Vector3,
	color: Color3,
	material: Enum.Material?,
	facing: number,
	signText: string,
	signColor: Color3,
	category: string,
	floorHeight: number?,
})
	local model = Instance.new("Model")
	model.Name = opts.name
	model.Parent = folder("Buildings")

	local s = opts.size
	local base = opts.center + Vector3.new(0, s.Y / 2, 0)
	part({ name = "Body", size = s, cframe = CFrame.new(base), color = opts.color, material = opts.material or Enum.Material.Brick, parent = model })
	part({
		name = "RoofTrim",
		size = Vector3.new(s.X + 1, 1, s.Z + 1),
		cframe = CFrame.new(base + Vector3.new(0, s.Y / 2 + 0.5, 0)),
		color = Color3.fromRGB(60, 60, 66),
		material = Enum.Material.Concrete,
		parent = model,
	})

	local frontZ = opts.center.Z + opts.facing * (s.Z / 2 + 0.1)
	local floorH = opts.floorHeight or 12
	local floors = math.max(1, math.floor(s.Y / floorH))
	for f = 1, floors do
		local y = opts.center.Y + (f - 1) * floorH
		if f == 1 then
			-- door + shop window on the ground floor
			part({
				name = "Door",
				size = Vector3.new(6, 9, 0.4),
				cframe = CFrame.new(opts.center.X, y + 4.5, frontZ),
				color = Color3.fromRGB(45, 35, 30),
				material = Enum.Material.Wood,
				parent = model,
			})
			local shopWindow = math.min(s.X - 16, 24)
			if shopWindow > 4 then
				for _, side in { -1, 1 } do
					part({
						name = "ShopWindow",
						size = Vector3.new(shopWindow / 2, 6, 0.3),
						cframe = CFrame.new(opts.center.X + side * (3 + shopWindow / 4 + 2), y + 4.5, frontZ),
						color = Color3.fromRGB(150, 200, 230),
						material = Enum.Material.Glass,
						transparency = 0.35,
						parent = model,
					})
				end
			end
		else
			local count = math.floor((s.X - 6) / 8)
			for i = 1, count do
				local x = opts.center.X - (count - 1) * 4 + (i - 1) * 8
				part({
					name = "Window",
					size = Vector3.new(5, 6, 0.3),
					cframe = CFrame.new(x, y + floorH / 2, frontZ),
					color = Color3.fromRGB(140, 190, 225),
					material = Enum.Material.Glass,
					transparency = 0.2,
					parent = model,
				})
			end
		end
	end

	local board = part({
		name = "Sign",
		size = Vector3.new(math.min(s.X - 4, 28), 3.5, 0.6),
		cframe = CFrame.new(opts.center.X, opts.center.Y + 11, frontZ + opts.facing * 0.3),
		color = Color3.fromRGB(20, 20, 24),
		parent = model,
	})
	if opts.facing == 1 then
		-- a part's Front face points -z, so turn the board around to face +z
		board.CFrame *= CFrame.Angles(0, math.pi, 0)
	end
	sign(board, Enum.NormalId.Front, opts.signText, opts.signColor)

	mapPoint(opts.name, opts.category, Vector3.new(opts.center.X, 3, frontZ + opts.facing * 6))
	return model
end

local function tree(position: Vector3, parent: Instance)
	local h = 10 + math.random() * 6
	part({ name = "Trunk", size = Vector3.new(h, 1.6, 1.6), cframe = CFrame.new(position + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), color = Color3.fromRGB(100, 70, 45), material = Enum.Material.Wood, shape = Enum.PartType.Cylinder, parent = parent })
	local r = 9 + math.random() * 4
	part({ name = "Leaves", size = Vector3.new(r, r, r), cframe = CFrame.new(position + Vector3.new(0, h + r * 0.3, 0)), color = Color3.fromRGB(60, 140 + math.random(0, 40), 60), material = Enum.Material.Grass, shape = Enum.PartType.Ball, parent = parent })
end

local function bench(cf: CFrame, parent: Instance)
	local seat = Instance.new("Seat")
	seat.Name = "Bench"
	seat.Anchored = true
	seat.Size = Vector3.new(6, 0.6, 2)
	seat.CFrame = cf * CFrame.new(0, 1.8, 0)
	seat.Color = Color3.fromRGB(130, 90, 55)
	seat.Material = Enum.Material.WoodPlanks
	seat.Parent = parent
	part({ name = "BenchBack", size = Vector3.new(6, 2, 0.4), cframe = cf * CFrame.new(0, 3, 0.9), color = Color3.fromRGB(130, 90, 55), material = Enum.Material.WoodPlanks, parent = parent })
	for _, x in { -2.5, 2.5 } do
		part({ name = "Leg", size = Vector3.new(0.4, 1.6, 1.8), cframe = cf * CFrame.new(x, 0.8, 0), color = Color3.fromRGB(40, 40, 40), material = Enum.Material.Metal, parent = parent })
	end
end

-- A streetball hoop. dir = +1 means it faces +z (it sits at the -z end of the court).
-- The rim is sized for a 1.5-stud ball, and its centre is marked by a RimCenter attachment.
local RIM_RADIUS = 1.45
local function hoop(name: string, baseline: Vector3, dir: number, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	local pole = baseline + Vector3.new(0, 0, -dir * 3)
	local polePart = part({ name = "HoopPole", size = Vector3.new(0.8, 12, 0.8), cframe = CFrame.new(pole + Vector3.new(0, 6, 0)), color = Color3.fromRGB(40, 40, 45), material = Enum.Material.Metal, parent = m })
	part({ name = "HoopArm", size = Vector3.new(0.6, 0.6, 3.5), cframe = CFrame.new(pole + Vector3.new(0, 11.5, dir * 1.75)), color = Color3.fromRGB(40, 40, 45), material = Enum.Material.Metal, parent = m })
	local board = pole + Vector3.new(0, 11.5, dir * 3.5)
	part({ name = "Backboard", size = Vector3.new(7, 4.2, 0.3), cframe = CFrame.new(board), color = Color3.new(1, 1, 1), material = Enum.Material.Glass, transparency = 0.3, parent = m })
	part({ name = "BoardSquare", size = Vector3.new(2.4, 1.8, 0.32), cframe = CFrame.new(board + Vector3.new(0, -0.6, 0)), color = Color3.fromRGB(230, 60, 40), material = Enum.Material.SmoothPlastic, transparency = 0.5, collide = false, parent = m })
	local rimCenter = board + Vector3.new(0, -1.3, dir * (RIM_RADIUS + 0.45))
	local segments = 16
	for i = 0, segments - 1 do
		local a = i / segments * math.pi * 2
		part({
			name = "Rim",
			size = Vector3.new(0.18, 0.18, 2 * math.pi * RIM_RADIUS / segments + 0.05),
			cframe = CFrame.new(rimCenter + Vector3.new(math.cos(a) * RIM_RADIUS, 0, math.sin(a) * RIM_RADIUS)) * CFrame.Angles(0, -a, 0),
			color = Color3.fromRGB(240, 90, 20),
			material = Enum.Material.Metal,
			parent = m,
		})
	end
	-- a simple net: thin strands that don't block the ball
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local top = rimCenter + Vector3.new(math.cos(a) * RIM_RADIUS * 0.95, -0.1, math.sin(a) * RIM_RADIUS * 0.95)
		local bottom = rimCenter + Vector3.new(math.cos(a) * RIM_RADIUS * 0.55, -1.6, math.sin(a) * RIM_RADIUS * 0.55)
		local strand = part({ name = "Net", size = Vector3.new(0.06, 0.06, (top - bottom).Magnitude), cframe = CFrame.lookAt((top + bottom) / 2, bottom), color = Color3.new(1, 1, 1), collide = false, parent = m })
		strand.CanQuery = false
		strand.CanTouch = false
	end
	local rimMarker = Instance.new("Attachment")
	rimMarker.Name = "RimCenter"
	rimMarker.Parent = polePart
	rimMarker.WorldPosition = rimCenter
	m:SetAttribute("RimRadius", RIM_RADIUS)
	return m
end

local function buildGround()
	local f = folder("Streets")
	part({ name = "Ground", size = Vector3.new(GROUND_X, 2, GROUND_Z), cframe = CFrame.new(0, -0.95, 0), color = Color3.fromRGB(86, 140, 70), material = Enum.Material.Grass, parent = f })
	-- roads
	part({ name = "MainRoad", size = Vector3.new(GROUND_X, 0.2, ROAD_W), cframe = CFrame.new(0, 0.1, 0), color = Color3.fromRGB(45, 45, 50), material = Enum.Material.Asphalt, parent = f })
	for _, side in { -1, 1 } do
		local len = GROUND_Z / 2 - ROAD_W / 2
		part({ name = "CrossRoad", size = Vector3.new(ROAD_W, 0.2, len), cframe = CFrame.new(0, 0.1, side * (ROAD_W / 2 + len / 2)), color = Color3.fromRGB(45, 45, 50), material = Enum.Material.Asphalt, parent = f })
	end
	-- lane dashes
	for x = -GROUND_X / 2 + 10, GROUND_X / 2 - 10, 20 do
		if math.abs(x) > ROAD_W / 2 + 4 then
			part({ name = "LaneMark", size = Vector3.new(8, 0.05, 0.6), cframe = CFrame.new(x, 0.23, 0), color = Color3.fromRGB(240, 200, 60), material = Enum.Material.SmoothPlastic, collide = false, parent = f })
		end
	end
	for z = -GROUND_Z / 2 + 10, GROUND_Z / 2 - 10, 20 do
		if math.abs(z) > ROAD_W / 2 + 4 then
			part({ name = "LaneMark", size = Vector3.new(0.6, 0.05, 8), cframe = CFrame.new(0, 0.23, z), color = Color3.fromRGB(240, 200, 60), material = Enum.Material.SmoothPlastic, collide = false, parent = f })
		end
	end
	-- crosswalk stripes on all four sides of the intersection
	for _, side in { -1, 1 } do
		for i = -6, 6 do
			part({ name = "Crosswalk", size = Vector3.new(1.4, 0.05, 6), cframe = CFrame.new(i * 2.4, 0.23, side * (ROAD_W / 2 + 4)), color = Color3.new(1, 1, 1), collide = false, parent = f })
			part({ name = "Crosswalk", size = Vector3.new(6, 0.05, 1.4), cframe = CFrame.new(side * (ROAD_W / 2 + 4), 0.23, i * 2.4), color = Color3.new(1, 1, 1), collide = false, parent = f })
		end
	end
	-- sidewalks (raised slightly, but low enough to walk onto)
	local walkColor = Color3.fromRGB(175, 175, 170)
	for _, side in { -1, 1 } do
		local edge = side * (ROAD_W / 2 + WALK_W / 2)
		local lenX = GROUND_X / 2 - ROAD_W / 2
		local lenZ = GROUND_Z / 2 - ROAD_W / 2 - WALK_W
		for _, s2 in { -1, 1 } do
			-- along the main road, stopping at the cross road
			part({ name = "Sidewalk", size = Vector3.new(lenX, 0.5, WALK_W), cframe = CFrame.new(s2 * (ROAD_W / 2 + lenX / 2), 0.25, edge), color = walkColor, material = Enum.Material.Concrete, parent = f })
			-- along the cross road, starting after the main road's sidewalk
			part({ name = "Sidewalk", size = Vector3.new(WALK_W, 0.5, lenZ), cframe = CFrame.new(edge, 0.25, s2 * (ROAD_W / 2 + WALK_W + lenZ / 2)), color = walkColor, material = Enum.Material.Concrete, parent = f })
		end
	end
end

local function buildStreetLamps()
	local f = folder("StreetLamps")
	for _, side in { -1, 1 } do
		local z = side * (ROAD_W / 2 + WALK_W - 0.6)
		for x = -GROUND_X / 2 + 40, GROUND_X / 2 - 40, 40 do
			if math.abs(x) > ROAD_W then
				local lamp = Instance.new("Model")
				lamp.Name = "StreetLamp"
				lamp.Parent = f
				part({ name = "Pole", size = Vector3.new(0.6, 16, 0.6), cframe = CFrame.new(x, 8, z), color = Color3.fromRGB(35, 35, 40), material = Enum.Material.Metal, parent = lamp })
				local head = part({ name = "Head", size = Vector3.new(1.6, 0.6, 3), cframe = CFrame.new(x, 16, z - side * 1.2), color = Color3.fromRGB(255, 240, 200), material = Enum.Material.Neon, parent = lamp })
				local light = Instance.new("SpotLight")
				light.Face = Enum.NormalId.Bottom
				light.Range = 40
				light.Angle = 110
				light.Brightness = 3
				light.Color = Color3.fromRGB(255, 225, 170)
				light.Parent = head
			end
		end
	end
end

-- A full outdoor court with two hoops, team pads, a ball rack and a scoreboard.
-- The CourtGames server module finds courts by their "Court" tag.
local COURT_W, COURT_L = 44, 76
local function buildCourt(name: string, c: Vector3, floorColor: Color3, paintColor: Color3): Model
	local court = Instance.new("Model")
	court.Name = name
	court.Parent = folder("Courts")
	local w, l = COURT_W, COURT_L
	court:SetAttribute("CourtCenter", c)
	court:SetAttribute("CourtSize", Vector3.new(w, 0, l))
	court:SetAttribute("DisplayName", (name:gsub("(%l)(%u)", "%1 %2")))
	CollectionService:AddTag(court, "Court")

	part({ name = "CourtFloor", size = Vector3.new(w + 8, 0.4, l + 8), cframe = CFrame.new(c + Vector3.new(0, 0.2, 0)), color = floorColor, material = Enum.Material.Concrete, parent = court })
	part({ name = "Paint", size = Vector3.new(w, 0.05, l), cframe = CFrame.new(c + Vector3.new(0, 0.42, 0)), color = paintColor, material = Enum.Material.Concrete, collide = false, parent = court })
	local white = Color3.new(1, 1, 1)
	local function line(size: Vector3, offset: Vector3, angle: number?)
		part({ name = "Line", size = size, cframe = CFrame.new(c + offset + Vector3.new(0, 0.47, 0)) * CFrame.Angles(0, angle or 0, 0), color = white, collide = false, parent = court })
	end
	line(Vector3.new(w, 0.04, 0.4), Vector3.new(0, 0, -l / 2))
	line(Vector3.new(w, 0.04, 0.4), Vector3.new(0, 0, l / 2))
	line(Vector3.new(0.4, 0.04, l), Vector3.new(-w / 2, 0, 0))
	line(Vector3.new(0.4, 0.04, l), Vector3.new(w / 2, 0, 0))
	line(Vector3.new(w, 0.04, 0.4), Vector3.new(0, 0, 0))
	for _, dir in { -1, 1 } do
		local endZ = dir * l / 2
		-- the key
		line(Vector3.new(12, 0.04, 0.4), Vector3.new(0, 0, endZ - dir * 15))
		line(Vector3.new(0.4, 0.04, 15), Vector3.new(-6, 0, endZ - dir * 7.5))
		line(Vector3.new(0.4, 0.04, 15), Vector3.new(6, 0, endZ - dir * 7.5))
		-- three point arc, centred on the rim (2.4 studs in from the baseline)
		local r = 19
		for i = 0, 24 do
			local a = i / 24 * math.pi
			line(Vector3.new(0.4, 0.04, 2.6), Vector3.new(math.cos(a) * r, 0, endZ - dir * (2.4 + math.sin(a) * r)), a * dir)
		end
		hoop(if dir == -1 then "HoopNorth" else "HoopSouth", c + Vector3.new(0, 0, endZ), -dir, court)
	end
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		line(Vector3.new(0.4, 0.04, 2.5), Vector3.new(math.cos(a) * 6, 0, math.sin(a) * 6), -a)
	end
	-- chain-link fence with a gap on the south side
	local fenceColor = Color3.fromRGB(120, 125, 130)
	for _, side in { -1, 1 } do
		part({ name = "Fence", size = Vector3.new(0.3, 10, l + 8), cframe = CFrame.new(c + Vector3.new(side * (w / 2 + 4), 5, 0)), color = fenceColor, material = Enum.Material.DiamondPlate, transparency = 0.6, parent = court })
	end
	part({ name = "Fence", size = Vector3.new(w + 8, 10, 0.3), cframe = CFrame.new(c + Vector3.new(0, 5, -(l / 2 + 4))), color = fenceColor, material = Enum.Material.DiamondPlate, transparency = 0.6, parent = court })
	for _, side in { -1, 1 } do
		part({ name = "Fence", size = Vector3.new(w / 2 - 4, 10, 0.3), cframe = CFrame.new(c + Vector3.new(side * (w / 4 + 4), 5, l / 2 + 4)), color = fenceColor, material = Enum.Material.DiamondPlate, transparency = 0.6, parent = court })
	end
	-- spectator benches along the west fence (section 51)
	for i = -2, 2 do
		bench(CFrame.new(c + Vector3.new(-(w / 2 + 1.5), 0.4, i * 12)) * CFrame.Angles(0, -math.pi / 2, 0), court)
	end

	-- team pads behind the south baseline: stand on one to join that team
	for _, pad in { { "HomePad", -9, Color3.fromRGB(50, 120, 255), "HOME" }, { "AwayPad", 9, Color3.fromRGB(255, 70, 70), "AWAY" } } do
		local p = part({ name = pad[1], size = Vector3.new(8, 0.3, 2.6), cframe = CFrame.new(c + Vector3.new(pad[2], 0.55, l / 2 + 1.6)), color = pad[3], material = Enum.Material.Neon, collide = false, parent = court })
		p.CanQuery = false
		local labelPart = part({ name = pad[1] .. "Label", size = Vector3.new(8, 1.6, 0.2), cframe = CFrame.new(c + Vector3.new(pad[2], 1.6, l / 2 + 3.1)), color = Color3.fromRGB(20, 20, 24), collide = false, parent = court })
		labelPart.CFrame *= CFrame.Angles(0, math.pi, 0) -- face the road
		sign(labelPart, Enum.NormalId.Front, pad[4] .. " - stand here to play", pad[3])
	end

	-- ball rack for free play
	local rack = part({ name = "BallRack", size = Vector3.new(5, 2.5, 1.6), cframe = CFrame.new(c + Vector3.new(-(w / 2 + 1.5), 1.65, l / 2 - 4)), color = Color3.fromRGB(40, 40, 45), material = Enum.Material.Metal, parent = court })
	for i = -1, 1 do
		part({ name = "RackBall", size = Vector3.new(1.4, 1.4, 1.4), cframe = CFrame.new(rack.Position + Vector3.new(0, 1.9, i * 1.5)), color = Color3.fromRGB(230, 110, 30), material = Enum.Material.Rubber, shape = Enum.PartType.Ball, collide = false, parent = court })
	end
	local rackPrompt = Instance.new("ProximityPrompt")
	rackPrompt.Name = "GrabBall"
	rackPrompt.ActionText = "Grab a ball"
	rackPrompt.ObjectText = "Ball Rack"
	rackPrompt.MaxActivationDistance = 9
	rackPrompt.RequiresLineOfSight = false
	rackPrompt.Parent = rack

	-- scoreboard on the north fence, facing the court
	local board = part({ name = "Scoreboard", size = Vector3.new(16, 6, 0.4), cframe = CFrame.new(c + Vector3.new(0, 13, -(l / 2 + 4))) * CFrame.Angles(0, math.pi, 0), color = Color3.fromRGB(15, 15, 18), parent = court })
	for _, x in { -7, 7 } do
		part({ name = "ScoreboardPost", size = Vector3.new(0.5, 10, 0.5), cframe = CFrame.new(c + Vector3.new(x, 5, -(l / 2 + 4.4))), color = Color3.fromRGB(40, 40, 45), material = Enum.Material.Metal, parent = court })
	end
	local gui = sign(board, Enum.NormalId.Front, "OPEN COURT", Color3.fromRGB(255, 200, 60))
	gui.Name = "ScoreboardGui"

	mapPoint(court:GetAttribute("DisplayName"), "Court", c + Vector3.new(0, 3, l / 2 + 8))
	return court
end

local function buildPark()
	local park = Instance.new("Model")
	park.Name = "Park"
	park.Parent = folder("Parks")
	local c = Vector3.new(-200, 0, -120)
	part({ name = "Path", size = Vector3.new(6, 0.2, 140), cframe = CFrame.new(c + Vector3.new(0, 0.1, 30)), color = Color3.fromRGB(190, 170, 130), material = Enum.Material.Sand, parent = park })
	part({ name = "Path", size = Vector3.new(120, 0.2, 6), cframe = CFrame.new(c + Vector3.new(0, 0.1, 0)), color = Color3.fromRGB(190, 170, 130), material = Enum.Material.Sand, parent = park })
	part({ name = "Fountain", size = Vector3.new(3, 14, 14), cframe = CFrame.new(c + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), color = Color3.fromRGB(200, 200, 205), material = Enum.Material.Marble, shape = Enum.PartType.Cylinder, parent = park })
	part({ name = "Water", size = Vector3.new(0.4, 12, 12), cframe = CFrame.new(c + Vector3.new(0, 3.1, 0)) * CFrame.Angles(0, 0, math.pi / 2), color = Color3.fromRGB(80, 160, 220), material = Enum.Material.Glass, transparency = 0.3, shape = Enum.PartType.Cylinder, collide = false, parent = park })
	local rng = Random.new(7)
	for _ = 1, 22 do
		local p = c + Vector3.new(rng:NextNumber(-60, 60), 0, rng:NextNumber(-60, 70))
		if math.abs(p.X - c.X) > 8 and math.abs(p.Z - c.Z) > 8 then
			tree(p, park)
		end
	end
	for _, x in { -20, 20 } do
		bench(CFrame.new(c + Vector3.new(x, 0, 5)), park)
		bench(CFrame.new(c + Vector3.new(x, 0, -5)) * CFrame.Angles(0, math.pi, 0), park)
	end
	-- playground
	local pg = c + Vector3.new(35, 0, 40)
	part({ name = "Mulch", size = Vector3.new(30, 0.3, 26), cframe = CFrame.new(pg + Vector3.new(0, 0.15, 0)), color = Color3.fromRGB(120, 80, 50), material = Enum.Material.Ground, parent = park })
	part({ name = "SlideTower", size = Vector3.new(6, 6, 6), cframe = CFrame.new(pg + Vector3.new(-8, 3, 0)), color = Color3.fromRGB(240, 200, 40), material = Enum.Material.Plastic, parent = park })
	part({ name = "Slide", size = Vector3.new(3, 0.4, 11), cframe = CFrame.new(pg + Vector3.new(-8, 3.1, 8.5)) * CFrame.Angles(math.rad(-30), 0, 0), color = Color3.fromRGB(230, 60, 60), material = Enum.Material.Plastic, parent = park })
	part({ name = "SlideStep", size = Vector3.new(3, 3, 3), cframe = CFrame.new(pg + Vector3.new(-8, 1.5, -4.5)), color = Color3.fromRGB(60, 120, 230), material = Enum.Material.Plastic, parent = park })
	part({ name = "SwingBar", size = Vector3.new(14, 0.6, 0.6), cframe = CFrame.new(pg + Vector3.new(7, 9, 0)), color = Color3.fromRGB(60, 120, 230), material = Enum.Material.Metal, parent = park })
	for _, x in { 0.5, 13.5 } do
		part({ name = "SwingPost", size = Vector3.new(0.6, 9, 0.6), cframe = CFrame.new(pg + Vector3.new(x, 4.5, 0)), color = Color3.fromRGB(60, 120, 230), material = Enum.Material.Metal, parent = park })
	end
	for _, x in { 4, 10 } do
		local seat = Instance.new("Seat")
		seat.Name = "Swing"
		seat.Anchored = true
		seat.Size = Vector3.new(2, 0.3, 1.2)
		seat.CFrame = CFrame.new(pg + Vector3.new(x, 2.5, 0))
		seat.Color = Color3.fromRGB(30, 30, 30)
		seat.Parent = park
	end
	mapPoint("City Park", "Park", c + Vector3.new(0, 3, 70))
end

-- Vending machine outside Corner Mart. The server handles the purchase.
local function buildVendingMachine(position: Vector3, facing: number): ProximityPrompt
	local m = Instance.new("Model")
	m.Name = "VendingMachine"
	m.Parent = folder("Interactables")
	local body = part({ name = "Body", size = Vector3.new(4, 7, 3), cframe = CFrame.new(position + Vector3.new(0, 3.5, 0)), color = Color3.fromRGB(200, 30, 40), material = Enum.Material.Metal, parent = m })
	local front = part({ name = "Front", size = Vector3.new(3.2, 4, 0.1), cframe = CFrame.new(position + Vector3.new(0, 4.2, facing * 1.55)), color = Color3.fromRGB(240, 240, 255), material = Enum.Material.Neon, parent = m })
	sign(front, if facing == -1 then Enum.NormalId.Front else Enum.NormalId.Back, "ENERGY\nDRINK\n$5", Color3.fromRGB(200, 30, 40))
	m.PrimaryPart = body
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Buy Energy Drink ($5)"
	prompt.ObjectText = "Vending Machine"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 8
	prompt.HoldDuration = 0.3
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	return prompt
end

local function buildBusStop(position: Vector3)
	local m = Instance.new("Model")
	m.Name = "BusStop"
	m.Parent = folder("Transit")
	part({ name = "Roof", size = Vector3.new(12, 0.4, 5), cframe = CFrame.new(position + Vector3.new(0, 8, 0)), color = Color3.fromRGB(40, 40, 45), material = Enum.Material.Metal, parent = m })
	part({ name = "Back", size = Vector3.new(12, 7, 0.3), cframe = CFrame.new(position + Vector3.new(0, 4.3, 2.3)), color = Color3.fromRGB(180, 220, 240), material = Enum.Material.Glass, transparency = 0.5, parent = m })
	local post = part({ name = "SignPost", size = Vector3.new(0.4, 10, 0.4), cframe = CFrame.new(position + Vector3.new(-7, 5, -1)), color = Color3.fromRGB(40, 40, 45), material = Enum.Material.Metal, parent = m })
	local plate = part({ name = "SignPlate", size = Vector3.new(3, 2, 0.2), cframe = CFrame.new(post.Position + Vector3.new(0, 4, -0.2)), color = Color3.fromRGB(30, 110, 200), parent = m })
	sign(plate, Enum.NormalId.Front, "BUS", Color3.new(1, 1, 1))
	bench(CFrame.new(position + Vector3.new(0, 0, 1.2)), m)
	mapPoint("Bus Stop", "Transit", position + Vector3.new(0, 3, -4))
end

local function buildSubwayEntrance(position: Vector3)
	local m = Instance.new("Model")
	m.Name = "SubwayEntrance"
	m.Parent = folder("Transit")
	part({ name = "Base", size = Vector3.new(14, 1, 12), cframe = CFrame.new(position + Vector3.new(0, 0.5, 0)), color = Color3.fromRGB(90, 90, 95), material = Enum.Material.Concrete, parent = m })
	part({ name = "Stairwell", size = Vector3.new(8, 1.1, 8), cframe = CFrame.new(position + Vector3.new(0, 0.55, 0)), color = Color3.fromRGB(10, 10, 12), material = Enum.Material.SmoothPlastic, parent = m })
	for _, x in { -5, 5 } do
		part({ name = "Rail", size = Vector3.new(0.4, 3, 9), cframe = CFrame.new(position + Vector3.new(x, 2.5, 0)), color = Color3.fromRGB(30, 140, 70), material = Enum.Material.Metal, parent = m })
	end
	local sTop = part({ name = "Sign", size = Vector3.new(12, 2.4, 0.4), cframe = CFrame.new(position + Vector3.new(0, 6, 5.8)), color = Color3.fromRGB(30, 140, 70), parent = m })
	sTop.CFrame = sTop.CFrame * CFrame.Angles(0, math.pi, 0)
	sign(sTop, Enum.NormalId.Front, "SUBWAY  NEIGHBORHOOD", Color3.new(1, 1, 1))
	for _, x in { -5.8, 5.8 } do
		part({ name = "SignPost", size = Vector3.new(0.4, 6, 0.4), cframe = CFrame.new(position + Vector3.new(x, 3, 5.8)), color = Color3.fromRGB(40, 40, 45), material = Enum.Material.Metal, parent = m })
	end
	mapPoint("Subway Station", "Transit", position + Vector3.new(0, 3, 9))
end

local function buildDealership(center: Vector3)
	local m = Instance.new("Model")
	m.Name = "BudgetWheels"
	m.Parent = folder("Buildings")
	part({ name = "Lot", size = Vector3.new(90, 0.3, 70), cframe = CFrame.new(center + Vector3.new(0, 0.15, 0)), color = Color3.fromRGB(55, 55, 60), material = Enum.Material.Asphalt, parent = m })
	for i = -4, 4 do
		part({ name = "ParkingLine", size = Vector3.new(0.4, 0.05, 14), cframe = CFrame.new(center + Vector3.new(i * 9, 0.32, -6)), color = Color3.new(1, 1, 1), collide = false, parent = m })
	end
	building({
		name = "Budget Wheels",
		center = center + Vector3.new(0, 0, 24),
		size = Vector3.new(36, 14, 18),
		color = Color3.fromRGB(230, 230, 235),
		material = Enum.Material.Concrete,
		facing = -1,
		signText = "BUDGET WHEELS",
		signColor = Color3.fromRGB(255, 200, 40),
		category = "Shop",
	}).Parent = m
	-- pennant string across the lot entrance
	for i = 0, 11 do
		part({
			name = "Pennant",
			size = Vector3.new(1.2, 1.2, 0.1),
			cframe = CFrame.new(center + Vector3.new(-33 + i * 6, 10, -34)) * CFrame.Angles(0, 0, math.rad(45)),
			color = if i % 2 == 0 then Color3.fromRGB(230, 50, 50) else Color3.fromRGB(255, 220, 50),
			collide = false,
			parent = m,
		})
	end
end

-- The Neighborhood run route. Returns checkpoint trigger parts in order.
local RUN_ROUTE = {
	Vector3.new(-40, 0, -20),
	Vector3.new(240, 0, -20),
	Vector3.new(240, 0, 20),
	Vector3.new(-240, 0, 20),
	Vector3.new(-240, 0, -20),
}

local function buildRunRoute(): { BasePart }
	local f = folder("RunRoute")
	local triggers = {}
	for i, pos in RUN_ROUTE do
		local m = Instance.new("Model")
		m.Name = "Checkpoint" .. i
		m.Parent = f
		local alongX = i == 1 or i == 2 or i == 4 or i == 5
		local postOffset = if alongX then Vector3.new(0, 0, 5) else Vector3.new(5, 0, 0)
		local color = if i == 1 then Color3.fromRGB(60, 230, 110) else Color3.fromRGB(255, 170, 40)
		for _, s in { -1, 1 } do
			part({ name = "Post", size = Vector3.new(0.8, 10, 0.8), cframe = CFrame.new(pos + postOffset * s + Vector3.new(0, 5, 0)), color = color, material = Enum.Material.Neon, collide = false, parent = m })
		end
		local bar = part({
			name = "Banner",
			size = if alongX then Vector3.new(0.8, 2, 10.8) else Vector3.new(10.8, 2, 0.8),
			cframe = CFrame.new(pos + Vector3.new(0, 10, 0)),
			color = Color3.fromRGB(25, 25, 30),
			collide = false,
			parent = m,
		})
		local text = if i == 1 then "START / FINISH" else "CHECKPOINT " .. (i - 1)
		for _, face in (if alongX then { Enum.NormalId.Left, Enum.NormalId.Right } else { Enum.NormalId.Front, Enum.NormalId.Back }) do
			sign(bar, face, text, color)
		end
		local trigger = part({
			name = "Trigger",
			size = Vector3.new(12, 12, 12),
			cframe = CFrame.new(pos + Vector3.new(0, 6, 0)),
			transparency = 1,
			collide = false,
			parent = m,
		})
		trigger.CanQuery = false
		trigger:SetAttribute("CheckpointIndex", i)
		table.insert(triggers, trigger)
	end
	mapPoint("Run Route Start", "Fitness", RUN_ROUTE[1] + Vector3.new(0, 3, 0))
	return triggers
end

local function buildLighting()
	Lighting.ClockTime = 9
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(70, 70, 80)
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 130)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.3
		atmosphere.Haze = 1.2
		atmosphere.Color = Color3.fromRGB(200, 190, 180)
		atmosphere.Decay = Color3.fromRGB(110, 100, 120)
		atmosphere.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.6
		bloom.Size = 30
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
	end
end

export type CityHandles = {
	city: Model,
	vendingPrompt: ProximityPrompt?,
	runTriggers: { BasePart },
	lamps: { Light },
}

function CityBuilder.build(): CityHandles
	local existing = workspace:FindFirstChild("City")
	if existing and existing:IsA("Model") then
		-- Reuse a City someone already built or edited by hand.
		city = existing
		local triggers = {}
		local runRoute = city:FindFirstChild("RunRoute")
		if runRoute then
			for _, d in runRoute:GetDescendants() do
				if d:IsA("BasePart") and d:GetAttribute("CheckpointIndex") then
					triggers[d:GetAttribute("CheckpointIndex")] = d
				end
			end
		end
		local prompt = city:FindFirstChild("ProximityPrompt", true)
		local lamps = {}
		for _, d in city:GetDescendants() do
			if d:IsA("SpotLight") then
				table.insert(lamps, d)
			end
		end
		return { city = city, vendingPrompt = prompt :: ProximityPrompt?, runTriggers = triggers, lamps = lamps }
	end

	city = Instance.new("Model")
	city.Name = "City"
	city.Parent = workspace
	table.clear(folders)

	buildLighting()
	buildGround()
	buildStreetLamps()

	building({ name = "Starter Apartments", center = Vector3.new(-100, 0, -85), size = Vector3.new(70, 36, 40), color = Color3.fromRGB(170, 95, 70), facing = 1, signText = "MAPLE COURT APTS", signColor = Color3.fromRGB(255, 230, 180), category = "Home" })
	building({ name = "Iron Box Gym", center = Vector3.new(205, 0, -75), size = Vector3.new(60, 24, 40), color = Color3.fromRGB(70, 70, 78), material = Enum.Material.Concrete, facing = 1, signText = "IRON BOX GYM", signColor = Color3.fromRGB(255, 80, 60), category = "Gym" })
	building({ name = "Corner Mart", center = Vector3.new(-70, 0, 62), size = Vector3.new(40, 16, 30), color = Color3.fromRGB(235, 225, 200), material = Enum.Material.Concrete, facing = -1, signText = "CORNER MART", signColor = Color3.fromRGB(60, 200, 90), category = "Shop" })
	building({ name = "Fresh Cuts Barber", center = Vector3.new(-125, 0, 60), size = Vector3.new(30, 14, 26), color = Color3.fromRGB(60, 90, 160), facing = -1, signText = "FRESH CUTS", signColor = Color3.fromRGB(255, 255, 255), category = "Shop" })
	building({ name = "Threads Clothing", center = Vector3.new(-185, 0, 62), size = Vector3.new(44, 18, 30), color = Color3.fromRGB(40, 40, 46), material = Enum.Material.Concrete, facing = -1, signText = "THREADS", signColor = Color3.fromRGB(255, 120, 200), category = "Shop" })
	building({ name = "Mama's Kitchen", center = Vector3.new(70, 0, 62), size = Vector3.new(40, 16, 30), color = Color3.fromRGB(190, 70, 50), facing = -1, signText = "MAMA'S KITCHEN", signColor = Color3.fromRGB(255, 220, 120), category = "Food" })

	buildCourt("NeighborhoodCourt", Vector3.new(100, 0, -110), Color3.fromRGB(40, 90, 150), Color3.fromRGB(200, 90, 50))
	buildPark()
	buildDealership(Vector3.new(190, 0, 85))
	buildBusStop(Vector3.new(-35, 0, 32))
	buildSubwayEntrance(Vector3.new(40, 0, -45))
	local vendingPrompt = buildVendingMachine(Vector3.new(-45, 0, 44), -1)
	mapPoint("Vending Machine", "Shop", Vector3.new(-45, 3, 40))
	local runTriggers = buildRunRoute()

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "ApartmentSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(-100, 0.5, -55) * CFrame.Angles(0, math.pi, 0)
	spawn.Color = Color3.fromRGB(170, 95, 70)
	spawn.Material = Enum.Material.Concrete
	spawn.Duration = 0
	spawn.Parent = city
	-- Everyone starts outside their apartment, not on a template's default spawn.
	for _, d in workspace:GetDescendants() do
		if d:IsA("SpawnLocation") and d ~= spawn then
			d.Enabled = false
		end
	end

	local lamps = {}
	for _, d in city:GetDescendants() do
		if d:IsA("SpotLight") then
			table.insert(lamps, d)
		end
	end

	return { city = city, vendingPrompt = vendingPrompt, runTriggers = runTriggers, lamps = lamps }
end

CityBuilder.RUN_ROUTE = RUN_ROUTE

return CityBuilder
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000009">
        <Properties>
          <string name="Name">Basketball</string>
          <ProtectedString name="Source"><![CDATA[-- CITY GRIND: server-owned basketballs (section 70).
-- Possession, dribbling, shooting, passing, stealing, blocking and scoring all
-- happen here. The client only says "I pressed shoot / released / pass / steal";
-- the server times the release itself and decides every outcome.

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("CityGrind"):WaitForChild("Config"))
local B = Config.Ball

local Basketball = {}

export type Hoop = { model: Model, rim: Vector3, radius: number, court: Model?, side: string }
export type Shot = { shooter: Player, points: number, kind: string, perfect: boolean, at: number, contestedBy: Player? }
export type Ball = {
	part: BasePart,
	force: VectorForce,
	holder: Player?,
	weld: Weld?,
	lastHolder: Player?,
	court: Model?, -- the court a free-play ball belongs to
	gameCourt: Model?, -- set while the ball is the game ball of a court
	owner: Player?,
	shot: Shot?,
	shootingSince: number?,
	regrab: { [Player]: number },
	lastPos: Vector3,
	scoreDebounce: number,
	lastActive: number,
}

local balls: { [Ball]: boolean } = {}
local heldBy: { [Player]: Ball } = {}
local hoops: { Hoop } = {}
local stealCooldown: { [Player]: number } = {}
local trainCooldown: { [Player]: { [string]: number } } = {}
local rng = Random.new()

local ballFolder = Instance.new("Folder")
ballFolder.Name = "Basketballs"
ballFolder.Parent = workspace

---------------------------------------------------------------------------
-- Collision groups: the ball never collides with characters, so it can't be
-- body-blocked into glitches or used to fling people.
---------------------------------------------------------------------------
local BALL_GROUP, CHARACTER_GROUP = "CityBall", "CityCharacters"
pcall(function()
	PhysicsService:RegisterCollisionGroup(BALL_GROUP)
end)
pcall(function()
	PhysicsService:RegisterCollisionGroup(CHARACTER_GROUP)
end)
PhysicsService:CollisionGroupSetCollidable(BALL_GROUP, CHARACTER_GROUP, false)

function Basketball.tagCharacter(character: Model)
	local function tag(d: Instance)
		if d:IsA("BasePart") then
			d.CollisionGroup = CHARACTER_GROUP
		end
	end
	for _, d in character:GetDescendants() do
		tag(d)
	end
	character.DescendantAdded:Connect(tag)
end

---------------------------------------------------------------------------
-- Tiny signal so listeners get the real ball table (BindableEvents copy tables).
---------------------------------------------------------------------------
local function signal()
	local listeners = {}
	return {
		connect = function(fn)
			table.insert(listeners, fn)
		end,
		fire = function(...)
			for _, fn in listeners do
				task.spawn(fn, ...)
			end
		end,
	}
end

Basketball.scored = signal() -- (ball, hoop, shot?)
Basketball.blocked = signal() -- (ball, blocker, shooter)
Basketball.stolen = signal() -- (ball, stealer, victim)
Basketball.possession = signal() -- (ball, player?)

-- Set by Main: send big on-screen text ("GAME WINNER!") to these players.
Basketball.announce = function(_players: { Player }, _text: string) end
-- Set by Main: tell one client to jump at the rim for a dunk.
Basketball.dunkJump = function(_player: Player, _rim: Vector3) end
-- Set by Main: award training progress toward a stat.
Basketball.onTrain = function(_player: Player, _stat: string, _amount: number) end

-- Rules that depend on whether a game is being played. CourtGames replaces these.
Basketball.policy = {
	canHold = function(_player: Player, _ball: Ball): boolean
		return true
	end,
	targetHoop = function(_player: Player, _ball: Ball): Hoop?
		return nil
	end,
	opponents = function(_player: Player, _ball: Ball): { Player }
		return {}
	end,
	passTargets = function(player: Player, _ball: Ball): { Player }
		local list = {}
		for _, other in Players:GetPlayers() do
			if other ~= player then
				table.insert(list, other)
			end
		end
		return list
	end,
	canSteal = function(_player: Player, _victim: Player, _ball: Ball): boolean
		return true
	end,
}

function Basketball.registerHoop(hoop: Hoop)
	table.insert(hoops, hoop)
end

function Basketball.heldBall(player: Player): Ball?
	return heldBy[player]
end

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function humanoidOf(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function canAct(player: Player): boolean
	local humanoid = humanoidOf(player)
	return humanoid ~= nil and humanoid.Health > 0 and humanoid.SeatPart == nil and rootOf(player) ~= nil
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function stat(player: Player, name: string): number
	return player:GetAttribute(name) or 1
end

-- Small training rewards, throttled so spamming shots doesn't farm stats.
local function train(player: Player, statName: string, amount: number)
	local now = os.clock()
	local cooldowns = trainCooldown[player]
	if not cooldowns then
		cooldowns = {}
		trainCooldown[player] = cooldowns
	end
	if cooldowns[statName] and now - cooldowns[statName] < 2 then
		return
	end
	cooldowns[statName] = now
	Basketball.onTrain(player, statName, amount)
end
Basketball.train = train

local function nearestHoop(position: Vector3): (Hoop?, number)
	local best, bestDist = nil, math.huge
	for _, hoop in hoops do
		local d = flat(hoop.rim - position).Magnitude
		if d < bestDist then
			best, bestDist = hoop, d
		end
	end
	return best, bestDist
end

-- Velocity that carries the ball from `from` to `to` in `t` seconds under ball gravity.
local function launchVelocity(from: Vector3, to: Vector3, t: number): Vector3
	return (to - from) / t + Vector3.new(0, 0.5 * B.GRAVITY * t, 0)
end

---------------------------------------------------------------------------
-- Ball lifecycle
---------------------------------------------------------------------------
function Basketball.newBall(position: Vector3): Ball
	local part = Instance.new("Part")
	part.Name = "Basketball"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.one * B.DIAMETER
	part.Color = Color3.fromRGB(230, 110, 30)
	part.Material = Enum.Material.Rubber
	part.CustomPhysicalProperties = PhysicalProperties.new(0.35, 0.6, 0.78, 1, 1)
	part.CollisionGroup = BALL_GROUP
	part.CFrame = CFrame.new(position)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	-- two thin dark discs, slightly wider than the ball, read as seams
	for _, rot in { CFrame.Angles(0, 0, 0), CFrame.Angles(0, math.pi / 2, 0) } do
		local seam = Instance.new("Part")
		seam.Name = "Seam"
		seam.Size = Vector3.new(0.05, B.DIAMETER + 0.03, B.DIAMETER + 0.03)
		seam.Color = Color3.fromRGB(30, 20, 15)
		seam.Material = Enum.Material.SmoothPlastic
		seam.CanCollide = false
		seam.CanQuery = false
		seam.CanTouch = false
		seam.Massless = true
		seam.CollisionGroup = BALL_GROUP
		seam.CFrame = part.CFrame * rot
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = seam
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = part
		weld.Part1 = seam
		weld.Parent = seam
		seam.Parent = part
	end
	local attachment = Instance.new("Attachment")
	attachment.Parent = part
	local force = Instance.new("VectorForce")
	force.Attachment0 = attachment
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.ApplyAtCenterOfMass = true
	force.Parent = part
	part.Parent = ballFolder
	force.Force = Vector3.new(0, part:GetMass() * (workspace.Gravity - B.GRAVITY), 0)
	pcall(part.SetNetworkOwner, part, nil)

	local ball: Ball = {
		part = part,
		force = force,
		regrab = {},
		lastPos = position,
		scoreDebounce = 0,
		lastActive = os.clock(),
	}
	balls[ball] = true
	return ball
end

local function detach(ball: Ball)
	local holder = ball.holder
	if ball.weld then
		ball.weld:Destroy()
		ball.weld = nil
	end
	if holder then
		heldBy[holder] = nil
		if holder.Parent then
			holder:SetAttribute("HasBall", false)
		end
		ball.lastHolder = holder
	end
	ball.holder = nil
	ball.shootingSince = nil
	ball.part.Massless = false
	ball.part.CanCollide = true
	ball.force.Enabled = true
	pcall(ball.part.SetNetworkOwner, ball.part, nil)
end

function Basketball.give(ball: Ball, player: Player)
	local root = rootOf(player)
	if not root then
		return
	end
	if heldBy[player] and heldBy[player] ~= ball then
		return
	end
	detach(ball)
	ball.part.CanCollide = false
	ball.part.Massless = true
	ball.force.Enabled = false
	ball.part.CFrame = root.CFrame * CFrame.new(1.1, -1.5, -1.3)
	local weld = Instance.new("Weld")
	weld.Part0 = root
	weld.Part1 = ball.part
	weld.C0 = CFrame.new(1.1, -1.5, -1.3)
	weld.Parent = ball.part
	ball.weld = weld
	ball.holder = player
	ball.lastHolder = player
	ball.shot = nil
	ball.lastActive = os.clock()
	heldBy[player] = ball
	player:SetAttribute("HasBall", true)
	Basketball.possession.fire(ball, player)
end

function Basketball.drop(ball: Ball)
	local holder = ball.holder
	local root = holder and rootOf(holder)
	detach(ball)
	if root then
		ball.part.CFrame = CFrame.new(root.Position + root.CFrame.LookVector * 2)
	end
	ball.part.AssemblyLinearVelocity = Vector3.zero
	Basketball.possession.fire(ball, nil)
end

function Basketball.destroy(ball: Ball)
	if not balls[ball] then
		return
	end
	detach(ball)
	balls[ball] = nil
	ball.part:Destroy()
end

function Basketball.moveTo(ball: Ball, position: Vector3)
	detach(ball)
	ball.part.CFrame = CFrame.new(position)
	ball.part.AssemblyLinearVelocity = Vector3.zero
	ball.part.AssemblyAngularVelocity = Vector3.zero
	ball.lastPos = position
end

local function launch(ball: Ball, from: Vector3, velocity: Vector3, spin: Vector3?)
	detach(ball)
	ball.part.CFrame = CFrame.new(from)
	ball.part.AssemblyLinearVelocity = velocity
	ball.part.AssemblyAngularVelocity = spin or Vector3.zero
	ball.lastPos = from
	ball.lastActive = os.clock()
end

function Basketball.balls(): { [Ball]: boolean }
	return balls
end

---------------------------------------------------------------------------
-- Shooting
---------------------------------------------------------------------------
function Basketball.shootStart(player: Player)
	local ball = heldBy[player]
	if not ball or ball.shootingSince or not canAct(player) then
		return
	end
	ball.shootingSince = os.clock()
end

local function nearestOpponent(player: Player, ball: Ball, position: Vector3): (Player?, number)
	local best, bestDist = nil, math.huge
	for _, other in Basketball.policy.opponents(player, ball) do
		local r = rootOf(other)
		if r and canAct(other) then
			local d = flat(r.Position - position).Magnitude
			if d < bestDist then
				best, bestDist = other, d
			end
		end
	end
	return best, bestDist
end

local function shoot(player: Player, ball: Ball, held: number)
	local root = rootOf(player)
	local humanoid = humanoidOf(player)
	if not root or not humanoid then
		return
	end
	local hoop = Basketball.policy.targetHoop(player, ball)
	local dist
	if hoop then
		dist = flat(hoop.rim - root.Position).Magnitude
	else
		hoop, dist = nearestHoop(root.Position)
	end
	local look = flat(root.CFrame.LookVector)
	look = if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
	local from = root.Position + Vector3.new(0, 2.6, 0) + look * 0.8

	if not hoop or dist > B.MAX_SHOT_RANGE then
		-- Nowhere to shoot: just toss it forward.
		launch(ball, from, launchVelocity(from, from + look * 20 + Vector3.new(0, -2, 0), 0.9))
		ball.regrab[player] = os.clock() + B.REGRAB_COOLDOWN
		return
	end

	local offBy = math.abs(held - B.PERFECT_RELEASE)
	local timing = math.clamp(1 - offBy / B.RELEASE_WINDOW, 0, 1)
	local perfect = offBy <= B.PERFECT_TOLERANCE
	local moving = flat(root.AssemblyLinearVelocity).Magnitude
	local airborne = humanoid.FloorMaterial == Enum.Material.Air

	local kind
	if dist <= B.DUNK_RANGE and (moving > 16 or airborne) then
		kind = "dunk"
	elseif dist <= 7 then
		kind = "layup"
	elseif dist <= B.THREE_POINT_RANGE then
		kind = "mid"
	elseif dist <= 26 then
		kind = "three"
	else
		kind = "deep"
	end
	local points = if dist > B.THREE_POINT_RANGE + 0.3 then 3 else 2

	local defender, defenderDist = nearestOpponent(player, ball, root.Position)

	-- Block: a jumping defender right on the shooter can swat it.
	if defender and defenderDist <= B.BLOCK_RANGE then
		local defHumanoid = humanoidOf(defender)
		if defHumanoid and defHumanoid.FloorMaterial == Enum.Material.Air then
			local chance = 0.3 + (stat(defender, "Vertical") + stat(defender, "Defense")) * 0.002 - stat(player, "Vertical") * 0.001
			if rng:NextNumber() < math.clamp(chance, 0.1, 0.65) then
				local away = flat(root.Position - hoop.rim)
				away = if away.Magnitude > 0.01 then away.Unit else -look
				local side = Vector3.new(-away.Z, 0, away.X) * rng:NextNumber(-12, 12)
				launch(ball, from + Vector3.new(0, 1, 0), away * 28 + side + Vector3.new(0, 18, 0))
				ball.regrab[player] = os.clock() + B.REGRAB_COOLDOWN
				train(defender, "Defense", 6)
				train(defender, "Vertical", 4)
				Basketball.blocked.fire(ball, defender, player)
				return
			end
		end
	end

	local base
	if kind == "dunk" then
		base = 0.9
	elseif kind == "layup" then
		base = 0.72
	elseif kind == "mid" then
		base = 0.52 - (dist - 7) * 0.008
	elseif kind == "three" then
		base = 0.36 - (dist - B.THREE_POINT_RANGE) * 0.01
	else
		base = math.max(0.04, 0.22 - (dist - 26) * 0.012)
	end
	local close = kind == "dunk" or kind == "layup"
	local statBonus = if close
		then (stat(player, "Finishing") - 1) * 0.0025 + (stat(player, "Vertical") - 1) * 0.001
		else (stat(player, "Shooting") - 1) * 0.003
	local timingFactor = if kind == "dunk" then 1 elseif kind == "layup" then 0.6 + 0.4 * timing else 0.3 + 0.7 * timing
	local contest = 1
	if defender and defenderDist < B.CONTEST_RANGE then
		local closeness = defenderDist / B.CONTEST_RANGE
		contest = if kind == "dunk" then 0.85 + 0.15 * closeness else 0.55 + 0.45 * closeness
	end
	local perfectBonus = if perfect and not close then 0.1 else 0
	local chance = math.clamp((base + statBonus) * timingFactor * contest + perfectBonus, 0.02, 0.97)
	local make = rng:NextNumber() < chance

	ball.shot = {
		shooter = player,
		points = points,
		kind = kind,
		perfect = perfect and make,
		at = os.clock(),
		contestedBy = if defender and defenderDist < B.CONTEST_RANGE then defender else nil,
	}
	ball.regrab[player] = os.clock() + B.REGRAB_COOLDOWN

	if kind == "dunk" and make then
		Basketball.dunkJump(player, hoop.rim)
		detach(ball)
		ball.part.CFrame = CFrame.new(hoop.rim + Vector3.new(0, 1.8, 0))
		ball.lastPos = ball.part.Position
		-- hang above the rim for the jump, then slam it through
		ball.part.Anchored = true
		task.delay(0.28, function()
			if balls[ball] then
				ball.part.Anchored = false
				ball.lastPos = ball.part.Position
				ball.part.AssemblyLinearVelocity = Vector3.new(0, -45, 0)
			end
		end)
		return
	end

	local target = hoop.rim + Vector3.new(0, 0.05, 0)
	if not make then
		-- Clank it off the rim, or airball a badly timed shot.
		local angle = rng:NextNumber(0, math.pi * 2)
		local miss = if timing < 0.15 and not close then rng:NextNumber(2.6, 3.6) else rng:NextNumber(1.1, 1.7)
		target += Vector3.new(math.cos(angle) * miss, 0.2, math.sin(angle) * miss)
	end
	local flight = if close then 0.6 else 0.7 + dist * 0.012
	launch(ball, from, launchVelocity(from, target, flight), root.CFrame.RightVector * -8)
end

function Basketball.shootRelease(player: Player)
	local ball = heldBy[player]
	if not ball or not ball.shootingSince or not canAct(player) then
		return
	end
	local held = os.clock() - ball.shootingSince
	ball.shootingSince = nil
	shoot(player, ball, held)
end

---------------------------------------------------------------------------
-- Passing and stealing
---------------------------------------------------------------------------
function Basketball.pass(player: Player)
	local ball = heldBy[player]
	local root = rootOf(player)
	if not ball or not root or ball.shootingSince then
		return
	end
	local look = flat(root.CFrame.LookVector).Unit
	local best, bestScore = nil, math.huge
	for _, other in Basketball.policy.passTargets(player, ball) do
		local r = rootOf(other)
		if r and canAct(other) and not heldBy[other] then
			local offset = flat(r.Position - root.Position)
			local d = offset.Magnitude
			if d > 2 and d < B.PASS_RANGE then
				local facing = look:Dot(offset.Unit)
				if facing > 0.2 then
					local score = d * (2 - facing)
					if score < bestScore then
						best, bestScore = other, score
					end
				end
			end
		end
	end
	local from = root.Position + Vector3.new(0, 1, 0) + look * 1.4
	local target
	if best then
		local r = rootOf(best) :: BasePart
		local d = flat(r.Position - root.Position).Magnitude
		local t = math.clamp(d / 75, 0.2, 0.8)
		target = r.Position + flat(r.AssemblyLinearVelocity) * t + Vector3.new(0, 0.5, 0)
		launch(ball, from, launchVelocity(from, target, t))
		train(player, "Passing", 3)
	else
		target = root.Position + look * 25 + Vector3.new(0, -1, 0)
		launch(ball, from, launchVelocity(from, target, 0.5))
	end
	ball.regrab[player] = os.clock() + 0.4
end

function Basketball.steal(player: Player)
	local root = rootOf(player)
	if not root or heldBy[player] or not canAct(player) then
		return
	end
	local now = os.clock()
	if (stealCooldown[player] or 0) > now then
		return
	end
	stealCooldown[player] = now + B.STEAL_COOLDOWN
	for victim, ball in heldBy do
		local r = rootOf(victim)
		if victim ~= player and r and flat(r.Position - root.Position).Magnitude <= B.STEAL_RANGE then
			if Basketball.policy.canSteal(player, victim, ball) and Basketball.policy.canHold(player, ball) then
				local chance = 0.25 + (stat(player, "Defense") - stat(victim, "BallHandling")) * 0.004
				if ball.shootingSince then
					chance += 0.1 -- caught mid-shot
				end
				train(player, "Defense", 3)
				if rng:NextNumber() < math.clamp(chance, 0.08, 0.6) then
					Basketball.give(ball, player)
					Basketball.stolen.fire(ball, player, victim)
				else
					train(victim, "BallHandling", 3)
				end
				return
			end
		end
	end
end

---------------------------------------------------------------------------
-- Every frame: dribble animation, pickups and scoring
---------------------------------------------------------------------------
local function canPickUp(player: Player, ball: Ball, now: number): boolean
	if heldBy[player] or not canAct(player) then
		return false
	end
	if (ball.regrab[player] or 0) > now then
		return false
	end
	return Basketball.policy.canHold(player, ball)
end

RunService.Heartbeat:Connect(function()
	local now = os.clock()
	for ball in balls do
		local holder = ball.holder
		if holder then
			if not holder.Parent or not canAct(holder) then
				Basketball.drop(ball)
			elseif ball.weld then
				if ball.shootingSince then
					ball.weld.C0 = CFrame.new(0, 2.5, -0.9)
					if now - ball.shootingSince > 1.6 then
						Basketball.shootRelease(holder) -- held far too long
					end
				else
					local bounce = math.abs(math.sin(now * 8.5)) * 1.7
					ball.weld.C0 = CFrame.new(1.1, -2.1 + bounce, -1.3)
				end
				if (now - ball.lastActive) > 0.5 then
					ball.lastActive = now
					train(holder, "BallHandling", 1)
				end
			end
			continue
		end

		local part = ball.part
		local pos = part.Position

		-- Scoring: the ball's centre passes down through the rim.
		if now > ball.scoreDebounce then
			for _, hoop in hoops do
				local rimY = hoop.rim.Y
				if ball.lastPos.Y >= rimY and pos.Y < rimY then
					local mid = (ball.lastPos + pos) / 2
					if flat(mid - hoop.rim).Magnitude < hoop.radius - 0.35 then
						ball.scoreDebounce = now + 1
						local shot = ball.shot
						if shot and now - shot.at > 4 then
							shot = nil
						end
						ball.shot = nil
						Basketball.scored.fire(ball, hoop, shot)
						break
					end
				end
			end
		end
		ball.lastPos = pos

		-- Pickups: closest eligible player within reach.
		if not part.Anchored then
			local best, bestDist = nil, math.huge
			for _, player in Players:GetPlayers() do
				local r = rootOf(player)
				if r then
					local offset = pos - r.Position
					local horizontal = flat(offset).Magnitude
					if horizontal < B.PICKUP_RANGE and offset.Y > -4 and offset.Y < 4.5 and horizontal < bestDist then
						if canPickUp(player, ball, now) then
							best, bestDist = player, horizontal
						end
					end
				end
			end
			if best then
				Basketball.give(ball, best)
			elseif part.AssemblyLinearVelocity.Magnitude > 2 then
				ball.lastActive = now
			end
		end

		-- Fell out of the world.
		if pos.Y < -30 then
			if ball.court then
				local center = ball.court:GetAttribute("CourtCenter")
				Basketball.moveTo(ball, center + Vector3.new(0, 4, 0))
			else
				Basketball.destroy(ball)
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	local ball = heldBy[player]
	if ball then
		Basketball.drop(ball)
	end
	for b in balls do
		b.regrab[player] = nil
		if b.owner == player and not b.gameCourt then
			Basketball.destroy(b)
		end
	end
	stealCooldown[player] = nil
	trainCooldown[player] = nil
end)

return Basketball
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000A">
        <Properties>
          <string name="Name">CourtGames</string>
          <ProtectedString name="Source"><![CDATA[-- CITY GRIND: pickup games on every tagged court (sections 51, 71).
-- Stand on the HOME or AWAY pad; when both sides have the same number of
-- players (1v1, 2v2 or 3v3) a countdown starts. First to 11 wins, or whoever
-- leads after 6 minutes (tied games go to next basket). Between games the
-- ball rack gives out free-play balls.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("CityGrind"):WaitForChild("Config"))
local Basketball = require(script.Parent:WaitForChild("Basketball"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local G = Config.Game
local B = Config.Ball

local CourtGames = {}

type Team = "Home" | "Away"
type Court = {
	model: Model,
	name: string,
	center: Vector3,
	size: Vector3,
	hoops: { [string]: Basketball.Hoop },
	pads: { [Team]: BasePart },
	scoreText: TextLabel?,
	state: string,
	teams: { [Team]: { Player } },
	score: { [Team]: number },
	startedAt: number,
	countdownEnds: number,
	overtime: boolean,
	ball: Basketball.Ball?,
	freeBalls: { [Basketball.Ball]: boolean },
	points: { [Player]: number },
	awaySince: { [Player]: number },
}

local courts: { Court } = {}
local playerGame: { [Player]: { court: Court, team: Team } } = {}

local function other(team: Team): Team
	return if team == "Home" then "Away" else "Home"
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function gamePlayers(court: Court): { Player }
	local list = table.clone(court.teams.Home)
	for _, p in court.teams.Away do
		table.insert(list, p)
	end
	return list
end

-- Everyone in the game plus anyone watching nearby.
local function audience(court: Court): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		local r = rootOf(player)
		if (playerGame[player] and playerGame[player].court == court) or (r and flatDistance(r.Position, court.center) < 90) then
			table.insert(list, player)
		end
	end
	return list
end

local function setScoreboard(court: Court, text: string)
	if court.scoreText then
		court.scoreText.Text = text
	end
end

local function publish(court: Court)
	local m = court.model
	m:SetAttribute("State", court.state)
	m:SetAttribute("HomeScore", court.score.Home)
	m:SetAttribute("AwayScore", court.score.Away)
	m:SetAttribute("Mode", #court.teams.Home .. "v" .. #court.teams.Away)
	m:SetAttribute("Overtime", court.overtime)
	local timeLeft = if court.state == "Playing" then math.max(0, G.TIME_LIMIT - (os.clock() - court.startedAt)) else 0
	m:SetAttribute("TimeLeft", math.floor(timeLeft))
	m:SetAttribute("Countdown", if court.state == "Countdown" then math.max(0, math.ceil(court.countdownEnds - os.clock())) else 0)
end

local function inBounds(court: Court, position: Vector3, margin: number): boolean
	local offset = position - court.center
	return math.abs(offset.X) <= court.size.X / 2 + margin and math.abs(offset.Z) <= court.size.Z / 2 + margin
end

local function onPad(pad: BasePart, root: BasePart): boolean
	local offset = pad.CFrame:PointToObjectSpace(root.Position)
	return math.abs(offset.X) <= pad.Size.X / 2 + 0.5 and math.abs(offset.Z) <= pad.Size.Z / 2 + 0.5 and offset.Y > -1 and offset.Y < 6
end

local function clearFreeBalls(court: Court)
	for ball in court.freeBalls do
		Basketball.destroy(ball)
	end
	table.clear(court.freeBalls)
end

---------------------------------------------------------------------------
-- Rules handed to the ball system
---------------------------------------------------------------------------
Basketball.policy.canHold = function(player, ball)
	local entry = playerGame[player]
	if ball.gameCourt then
		return entry ~= nil and entry.court.model == ball.gameCourt and entry.court.state == "Playing"
	end
	return entry == nil
end

Basketball.policy.targetHoop = function(player, _ball)
	local entry = playerGame[player]
	if not entry then
		return nil
	end
	return entry.court.hoops[if entry.team == "Home" then "North" else "South"]
end

Basketball.policy.opponents = function(player, _ball)
	local entry = playerGame[player]
	if not entry then
		return {}
	end
	return entry.court.teams[other(entry.team)]
end

Basketball.policy.passTargets = function(player, _ball)
	local entry = playerGame[player]
	if entry then
		local mates = {}
		for _, p in entry.court.teams[entry.team] do
			if p ~= player then
				table.insert(mates, p)
			end
		end
		return mates
	end
	local list = {}
	for _, p in Players:GetPlayers() do
		if p ~= player and not playerGame[p] then
			table.insert(list, p)
		end
	end
	return list
end

Basketball.policy.canSteal = function(player, victim, _ball)
	local a, b = playerGame[player], playerGame[victim]
	if a and b then
		return a.court == b.court and a.team ~= b.team
	end
	return a == nil and b == nil
end

---------------------------------------------------------------------------
-- Game flow
---------------------------------------------------------------------------
local function giveTo(court: Court, team: Team)
	local ball = court.ball
	local list = court.teams[team]
	if not ball or #list == 0 then
		return
	end
	-- Check the ball to a random player on that team.
	Basketball.give(ball, list[math.random(1, #list)])
end

local function leaveGame(player: Player)
	local entry = playerGame[player]
	if not entry then
		return
	end
	playerGame[player] = nil
	local list = entry.court.teams[entry.team]
	local i = table.find(list, player)
	if i then
		table.remove(list, i)
	end
	if player.Parent then
		player:SetAttribute("InGame", nil)
		player:SetAttribute("Team", nil)
	end
	local ball = entry.court.ball
	if ball and ball.holder == player then
		Basketball.drop(ball)
	end
end

local function endGame(court: Court, winner: Team?, forfeit: boolean)
	court.state = "Ended"
	local duration = os.clock() - court.startedAt
	local total = court.score.Home + court.score.Away
	local eligible = not forfeit and duration >= G.MIN_SECONDS_FOR_REWARDS and total >= G.MIN_POINTS_FOR_REWARDS
	local teamSize = math.max(#court.teams.Home, #court.teams.Away)
	local sizeBonus = 1 + 0.25 * (teamSize - 1)

	for _, team in { "Home", "Away" } :: { Team } do
		for _, player in table.clone(court.teams[team]) do
			local won = team == winner
			if eligible then
				if won then
					PlayerData.addCash(player, math.floor(G.WIN_CASH * sizeBonus), "Won a " .. teamSize .. "v" .. teamSize .. " at " .. court.name)
					PlayerData.addXP(player, math.floor(G.WIN_XP * sizeBonus))
					PlayerData.addReputation(player, math.floor(G.WIN_REP * sizeBonus))
				else
					PlayerData.addCash(player, G.LOSS_CASH, "Played a " .. teamSize .. "v" .. teamSize .. " at " .. court.name)
					PlayerData.addXP(player, G.LOSS_XP)
					PlayerData.addReputation(player, G.LOSS_REP)
				end
				PlayerData.recordBasketball(player, { games = 1, wins = if won then 1 else 0, losses = if won then 0 else 1 })
			end
			Basketball.announce({ player }, if won then "YOU WIN!" else "GOOD GAME")
			if not eligible and not forfeit then
				PlayerData.onNotify:Fire(player, "SHORT GAME", "Games need 1+ minute and 5+ points to count for rewards.")
			end
			leaveGame(player)
		end
	end

	if court.ball then
		Basketball.destroy(court.ball)
		court.ball = nil
	end
	local result = if winner then string.upper(winner) .. " WINS" else "GAME OVER"
	setScoreboard(court, string.format("%s\n%d - %d", result, court.score.Home, court.score.Away))
	publish(court)
	task.delay(6, function()
		if court.state == "Ended" then
			court.state = "Idle"
			court.score = { Home = 0, Away = 0 }
			court.overtime = false
			setScoreboard(court, "OPEN COURT")
			publish(court)
		end
	end)
end

local function startGame(court: Court, home: { Player }, away: { Player })
	clearFreeBalls(court)
	for _, p in home do
		local held = Basketball.heldBall(p)
		if held then
			Basketball.destroy(held)
		end
	end
	for _, p in away do
		local held = Basketball.heldBall(p)
		if held then
			Basketball.destroy(held)
		end
	end
	court.teams = { Home = home, Away = away }
	court.score = { Home = 0, Away = 0 }
	court.points = {}
	court.awaySince = {}
	court.overtime = false
	court.state = "Playing"
	court.startedAt = os.clock()

	-- Line up at half court. Home attacks the north hoop (toward -z).
	for team, list in court.teams do
		local zSide = if team == "Home" then 6 else -6
		local facing = if team == "Home" then Vector3.new(0, 0, -1) else Vector3.new(0, 0, 1)
		for i, player in list do
			playerGame[player] = { court = court, team = team }
			player:SetAttribute("InGame", court.name)
			player:SetAttribute("Team", team)
			local pos = court.center + Vector3.new((i - (#list + 1) / 2) * 7, 3.5, zSide)
			if player.Character then
				player.Character:PivotTo(CFrame.lookAt(pos, pos + facing))
			end
		end
	end

	local ball = Basketball.newBall(court.center + Vector3.new(0, 4, 0))
	ball.gameCourt = court.model
	ball.court = court.model
	court.ball = ball
	local first: Team = if math.random() < 0.5 then "Home" else "Away"
	giveTo(court, first)
	local mode = #home .. "v" .. #away
	Basketball.announce(gamePlayers(court), mode .. "  ·  FIRST TO " .. G.TARGET_SCORE)
	publish(court)
end

local function updateIdle(court: Court)
	local home, away = {}, {}
	for _, player in Players:GetPlayers() do
		local r = rootOf(player)
		if r and not playerGame[player] then
			if onPad(court.pads.Home, r) and #home < G.MAX_TEAM_SIZE then
				table.insert(home, player)
			elseif onPad(court.pads.Away, r) and #away < G.MAX_TEAM_SIZE then
				table.insert(away, player)
			end
		end
	end
	local ready = #home >= 1 and #home == #away
	if court.state == "Idle" then
		if ready then
			court.state = "Countdown"
			court.countdownEnds = os.clock() + G.COUNTDOWN
		elseif #home + #away > 0 then
			setScoreboard(court, string.format("HOME %d  ·  AWAY %d\nNeed even teams", #home, #away))
		else
			setScoreboard(court, "OPEN COURT")
		end
	end
	if court.state == "Countdown" then
		if not ready then
			court.state = "Idle"
		elseif os.clock() >= court.countdownEnds then
			startGame(court, home, away)
			return
		else
			setScoreboard(court, string.format("%dv%d STARTS IN %d", #home, #away, math.ceil(court.countdownEnds - os.clock())))
		end
	end
	publish(court)
end

local function updatePlaying(court: Court)
	local now = os.clock()
	-- Players who wander off (or die and respawn far away) leave the game.
	for _, player in gamePlayers(court) do
		local r = rootOf(player)
		if not player.Parent then
			leaveGame(player)
		elseif not r or flatDistance(r.Position, court.center) > 90 then
			court.awaySince[player] = court.awaySince[player] or now
			if now - court.awaySince[player] > 8 then
				PlayerData.onNotify:Fire(player, "LEFT THE GAME", "You went too far from " .. court.name .. ".")
				leaveGame(player)
			end
		else
			court.awaySince[player] = nil
		end
	end
	if #court.teams.Home == 0 or #court.teams.Away == 0 then
		local winner: Team? = if #court.teams.Home > 0 then "Home" elseif #court.teams.Away > 0 then "Away" else nil
		endGame(court, winner, true)
		return
	end

	local ball = court.ball
	if ball then
		-- Out of bounds: the other team takes it.
		local holder = ball.holder
		if holder then
			local r = rootOf(holder)
			if r and not inBounds(court, r.Position, 1.5) then
				local entry = playerGame[holder]
				if entry then
					Basketball.announce(audience(court), "OUT OF BOUNDS")
					giveTo(court, other(entry.team))
				end
			end
		elseif not ball.part.Anchored then
			local pos = ball.part.Position
			if not inBounds(court, pos, 1.5) and pos.Y < court.center.Y + 4 then
				local last = ball.lastHolder and playerGame[ball.lastHolder]
				local team: Team = if last then other(last.team) else "Home"
				Basketball.announce(audience(court), "OUT OF BOUNDS")
				giveTo(court, team)
			end
		end
	end

	if now - court.startedAt >= G.TIME_LIMIT and not court.overtime then
		if court.score.Home ~= court.score.Away then
			endGame(court, if court.score.Home > court.score.Away then "Home" else "Away", false)
			return
		end
		court.overtime = true
		Basketball.announce(audience(court), "TIED! NEXT BUCKET WINS")
	end

	local timeLeft = math.max(0, G.TIME_LIMIT - (now - court.startedAt))
	setScoreboard(
		court,
		string.format(
			"HOME %d - %d AWAY\n%s",
			court.score.Home,
			court.score.Away,
			if court.overtime then "NEXT BUCKET WINS" else string.format("%d:%02d", timeLeft // 60, timeLeft % 60)
		)
	)
	publish(court)
end

---------------------------------------------------------------------------
-- Ball events
---------------------------------------------------------------------------
local function courtOfModel(model: Model?): Court?
	for _, court in courts do
		if court.model == model then
			return court
		end
	end
	return nil
end

Basketball.scored.connect(function(ball, hoop, shot)
	local court = courtOfModel(ball.gameCourt)
	local shooter = shot and shot.shooter

	if not court or court.state ~= "Playing" or ball ~= court.ball then
		-- Free play: training only, and a callout for the big ones.
		if shooter and shooter.Parent then
			if shot.kind == "dunk" then
				Basketball.train(shooter, "Vertical", 5)
				Basketball.train(shooter, "Finishing", 4)
				Basketball.announce({ shooter }, "SLAM!")
			elseif shot.kind == "layup" then
				Basketball.train(shooter, "Finishing", 4)
				Basketball.announce({ shooter }, "BUCKET")
			else
				Basketball.train(shooter, "Shooting", if shot.points == 3 then 6 else 4)
				if shot.perfect then
					Basketball.announce({ shooter }, "PERFECT RELEASE!")
				else
					Basketball.announce({ shooter }, if shot.points == 3 then "SPLASH! +3" else "BUCKET +2")
				end
			end
		end
		return
	end

	local team: Team = if hoop.side == "North" then "Home" else "Away"
	local points = 2
	local shooterEntry = shooter and playerGame[shooter]
	if shot and shooterEntry and shooterEntry.court == court and shooterEntry.team == team then
		points = shot.points
		court.points[shooter] = (court.points[shooter] or 0) + points
		PlayerData.recordBasketball(shooter, {
			points = points,
			threes = if points == 3 then 1 else 0,
			dunks = if shot.kind == "dunk" then 1 else 0,
		})
		if shot.kind == "dunk" then
			Basketball.train(shooter, "Vertical", 5)
			Basketball.train(shooter, "Finishing", 5)
		elseif shot.kind == "layup" then
			Basketball.train(shooter, "Finishing", 5)
		else
			Basketball.train(shooter, "Shooting", if points == 3 then 8 else 5)
		end
	end
	local before = court.score[team]
	local wasTied = court.score.Home == court.score.Away
	court.score[team] += points

	local gameOver = court.overtime or court.score[team] >= G.TARGET_SCORE
	local callout
	if gameOver then
		callout = "GAME WINNER!"
	elseif wasTied and before >= G.TARGET_SCORE - 4 then
		callout = "CLUTCH!"
	elseif shot and shot.kind == "dunk" and shot.contestedBy then
		callout = "POSTER!"
	elseif shot and shot.perfect then
		callout = "PERFECT RELEASE!"
	elseif points == 3 then
		callout = "FROM DOWNTOWN!"
	end
	if callout then
		Basketball.announce(audience(court), callout)
	end
	publish(court)

	if gameOver then
		task.delay(1.2, function()
			if court.state == "Playing" then
				endGame(court, team, false)
			end
		end)
		return
	end
	-- Possession goes to the team that got scored on once the ball drops.
	task.delay(1, function()
		if court.state == "Playing" and court.ball == ball and not ball.holder then
			giveTo(court, other(team))
		end
	end)
end)

Basketball.blocked.connect(function(ball, blocker, _shooter)
	local court = courtOfModel(ball.gameCourt)
	if court and court.state == "Playing" then
		PlayerData.recordBasketball(blocker, { blocks = 1 })
		Basketball.announce(audience(court), "BIG BLOCK!")
	else
		Basketball.announce({ blocker }, "BIG BLOCK!")
	end
end)

Basketball.stolen.connect(function(ball, stealer, _victim)
	local court = courtOfModel(ball.gameCourt)
	if court and court.state == "Playing" then
		PlayerData.recordBasketball(stealer, { steals = 1 })
		Basketball.announce(audience(court), "STEAL!")
	end
end)

---------------------------------------------------------------------------
-- Setup
---------------------------------------------------------------------------
local function setupCourt(model: Model)
	local hoops = {}
	for _, side in { "North", "South" } do
		local hoopModel = model:FindFirstChild("Hoop" .. side)
		local marker = hoopModel and hoopModel:FindFirstChild("RimCenter", true)
		if marker and marker:IsA("Attachment") then
			local hoop: Basketball.Hoop = {
				model = hoopModel,
				rim = marker.WorldPosition,
				radius = hoopModel:GetAttribute("RimRadius") or 1.45,
				court = model,
				side = side,
			}
			hoops[side] = hoop
			Basketball.registerHoop(hoop)
		end
	end
	local homePad = model:FindFirstChild("HomePad")
	local awayPad = model:FindFirstChild("AwayPad")
	if not hoops.North or not hoops.South or not homePad or not awayPad then
		warn("[CityGrind] Court is missing hoops or pads:", model:GetFullName())
		return
	end
	local scoreboard = model:FindFirstChild("Scoreboard")
	local gui = scoreboard and scoreboard:FindFirstChildOfClass("SurfaceGui")

	local court: Court = {
		model = model,
		name = model:GetAttribute("DisplayName") or model.Name,
		center = model:GetAttribute("CourtCenter"),
		size = model:GetAttribute("CourtSize"),
		hoops = hoops,
		pads = { Home = homePad, Away = awayPad },
		scoreText = gui and gui:FindFirstChildOfClass("TextLabel"),
		state = "Idle",
		teams = { Home = {}, Away = {} },
		score = { Home = 0, Away = 0 },
		startedAt = 0,
		countdownEnds = 0,
		overtime = false,
		ball = nil,
		freeBalls = {},
		points = {},
		awaySince = {},
	}
	table.insert(courts, court)
	setScoreboard(court, "OPEN COURT")
	publish(court)

	local rack = model:FindFirstChild("BallRack")
	local prompt = rack and rack:FindFirstChild("GrabBall")
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Triggered:Connect(function(player)
			if playerGame[player] or court.state == "Playing" then
				PlayerData.onNotify:Fire(player, "GAME IN PROGRESS", "Free play balls come back when the game ends.")
				return
			end
			if Basketball.heldBall(player) then
				return
			end
			-- One practice ball per player, a few per court.
			for ball in court.freeBalls do
				if ball.owner == player then
					Basketball.destroy(ball)
					court.freeBalls[ball] = nil
				end
			end
			local count = 0
			for _ in court.freeBalls do
				count += 1
			end
			if count >= B.FREE_BALLS_PER_COURT then
				PlayerData.onNotify:Fire(player, "RACK IS EMPTY", "Grab a loose ball on the court instead.")
				return
			end
			local ball = Basketball.newBall((rack :: BasePart).Position + Vector3.new(0, 2.5, 0))
			ball.court = model
			ball.owner = player
			court.freeBalls[ball] = true
			Basketball.give(ball, player)
		end)
	end

	task.spawn(function()
		while model.Parent do
			if court.state == "Idle" or court.state == "Countdown" then
				updateIdle(court)
			elseif court.state == "Playing" then
				updatePlaying(court)
			end
			-- tidy up practice balls nobody has touched for a while
			for ball in court.freeBalls do
				if not Basketball.balls()[ball] then
					court.freeBalls[ball] = nil
				elseif not ball.holder and os.clock() - ball.lastActive > B.FREE_BALL_IDLE_SECONDS then
					Basketball.destroy(ball)
					court.freeBalls[ball] = nil
				end
			end
			task.wait(0.2)
		end
	end)
end

function CourtGames.start()
	for _, model in CollectionService:GetTagged("Court") do
		if model:IsA("Model") then
			setupCourt(model)
		end
	end
	Players.PlayerRemoving:Connect(leaveGame)
end

function CourtGames.gameOf(player: Player): string?
	local entry = playerGame[player]
	return entry and entry.court.name
end

return CourtGames
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX0000000B"><Properties><string name="Name">StarterPlayer</string><bool name="EnableMouseLockOption">false</bool></Properties>
    <Item class="StarterPlayerScripts" referent="RBX0000000C">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX0000000D">
        <Properties>
          <string name="Name">CityGrindClient</string>
          <ProtectedString name="Source"><![CDATA[-- CITY GRIND: client entry point (StarterPlayerScripts.CityGrindClient).

local Players = game:GetService("Players")

local Movement = require(script:WaitForChild("Movement"))
local HUD = require(script:WaitForChild("HUD"))
local Phone = require(script:WaitForChild("Phone"))
local Basketball = require(script:WaitForChild("Basketball"))

local player = Players.LocalPlayer

Movement.start()
HUD.start()
Phone.start()
Basketball.start()

-- Wait for the server to hand over this player's save before welcoming them.
if not player:GetAttribute("DataLoaded") then
	player:GetAttributeChangedSignal("DataLoaded"):Wait()
end
HUD.push("WELCOME TO THE NEIGHBORHOOD", "Press P for your phone. Run the route by your apartment to earn cash.")
]]></ProtectedString>
        </Properties>
        <Item class="ModuleScript" referent="RBX0000000E">
          <Properties>
            <string name="Name">UI</string>
            <ProtectedString name="Source"><![CDATA[-- CITY GRIND: tiny helpers for building UI in code.

local UI = {}

UI.FONT = Enum.Font.GothamMedium
UI.FONT_BOLD = Enum.Font.GothamBold
UI.FONT_BLACK = Enum.Font.GothamBlack

UI.colors = {
	panel = Color3.fromRGB(18, 18, 24),
	panelLight = Color3.fromRGB(34, 34, 44),
	text = Color3.fromRGB(240, 240, 245),
	subtext = Color3.fromRGB(160, 160, 175),
	cash = Color3.fromRGB(110, 230, 120),
	xp = Color3.fromRGB(90, 170, 255),
	stamina = Color3.fromRGB(255, 200, 60),
	danger = Color3.fromRGB(255, 90, 90),
	accent = Color3.fromRGB(255, 120, 60),
}

-- UI.new("Frame", { Size = ..., Parent = ... }, { children })
function UI.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
	end
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(inst :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(radius: number): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius) })
end

function UI.padding(px: number): UIPadding
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

function UI.stroke(color: Color3, thickness: number, transparency: number?): UIStroke
	return UI.new("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.label(props: { [string]: any }, children: { Instance }?): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.FONT,
		TextColor3 = UI.colors.text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in props do
		defaults[k] = v
	end
	return UI.new("TextLabel", defaults, children)
end

function UI.button(props: { [string]: any }, children: { Instance }?): TextButton
	local defaults = {
		BackgroundColor3 = UI.colors.panelLight,
		Font = UI.FONT_BOLD,
		TextColor3 = UI.colors.text,
		TextSize = 16,
		AutoButtonColor = true,
	}
	for k, v in props do
		defaults[k] = v
	end
	local b = UI.new("TextButton", defaults, children)
	UI.corner(10).Parent = b
	return b
end

-- A horizontal progress bar. Returns the outer frame and a setter.
function UI.bar(props: { [string]: any }, fillColor: Color3): (Frame, (number) -> ())
	local outer = UI.new("Frame", props)
	if not props.BackgroundColor3 then
		outer.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	end
	UI.corner(6).Parent = outer
	local fill = UI.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = fillColor,
		Size = UDim2.fromScale(0, 1),
		Parent = outer,
	}, { UI.corner(6) })
	return outer, function(fraction: number)
		fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
	end
end

function UI.formatCash(n: number): string
	local s = tostring(math.floor(math.abs(n)))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return (if n < 0 then "-$" else "$") .. formatted
end

function UI.formatClock(clockTime: number): string
	local hours = math.floor(clockTime)
	local minutes = math.floor((clockTime - hours) * 60)
	local suffix = if hours >= 12 then "PM" else "AM"
	local h12 = hours % 12
	if h12 == 0 then
		h12 = 12
	end
	return string.format("%d:%02d %s", h12, minutes, suffix)
end

function UI.timeAgo(timestamp: number): string
	local diff = math.max(0, os.time() - timestamp)
	if diff < 60 then
		return "just now"
	elseif diff < 3600 then
		return math.floor(diff / 60) .. "m ago"
	elseif diff < 86400 then
		return math.floor(diff / 3600) .. "h ago"
	end
	return math.floor(diff / 86400) .. "d ago"
end

return UI
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000F">
          <Properties>
            <string name="Name">Movement</string>
            <ProtectedString name="Source"><![CDATA[-- CITY GRIND: sprint, stamina, crouch and slide (section 12).
-- PC: Shift sprint, C crouch (C while sprinting = slide).
-- Mobile: on-screen Sprint (toggle) and Crouch buttons. Controller: L3 sprint, R3 crouch.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("CityGrind"):WaitForChild("Config"))
local remotes = ReplicatedStorage.CityGrind:WaitForChild("Remotes")

local player = Players.LocalPlayer

local Movement = {}

local stamina = 100
local exhausted = false
local wantSprint = false
local crouching = false
local slidingUntil = 0
local humanoid: Humanoid? = nil
local lastJumpState = false

local function statValue(name: string): number
	return player:GetAttribute(name) or 1
end

function Movement.maxStamina(): number
	return Config.maxStamina(statValue("Stamina"))
end

function Movement.getStamina(): (number, number, boolean)
	return stamina, Movement.maxStamina(), exhausted
end

function Movement.isSprinting(): boolean
	return humanoid ~= nil and humanoid.WalkSpeed >= Config.SPRINT_SPEED - 0.1
end

local function setCameraOffset(y: number)
	if humanoid then
		TweenService:Create(humanoid, TweenInfo.new(0.18), { CameraOffset = Vector3.new(0, y, 0) }):Play()
	end
end

local function setCrouch(on: boolean)
	if crouching == on then
		return
	end
	crouching = on
	setCameraOffset(if on then -1.6 else 0)
end

local function trySlide(): boolean
	if not humanoid or os.clock() < slidingUntil then
		return false
	end
	if humanoid.MoveDirection.Magnitude < 0.1 or humanoid.FloorMaterial == Enum.Material.Air then
		return false
	end
	if stamina < Config.SLIDE_COST then
		return false
	end
	stamina -= Config.SLIDE_COST
	slidingUntil = os.clock() + Config.SLIDE_SECONDS
	setCameraOffset(-2)
	task.delay(Config.SLIDE_SECONDS, function()
		setCameraOffset(if crouching then -1.6 else 0)
	end)
	return true
end

local function onSprint(_, state: Enum.UserInputState, input: InputObject)
	if input.UserInputType == Enum.UserInputType.Touch then
		if state == Enum.UserInputState.Begin then
			wantSprint = not wantSprint -- toggle on mobile
		end
	elseif state == Enum.UserInputState.Begin then
		wantSprint = true
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		wantSprint = false
	end
	return Enum.ContextActionResult.Pass
end

local function onCrouch(_, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end
	if Movement.isSprinting() and trySlide() then
		return Enum.ContextActionResult.Sink
	end
	setCrouch(not crouching)
	if crouching then
		wantSprint = false
	end
	return Enum.ContextActionResult.Sink
end

local function bindCharacter(character: Model)
	humanoid = character:WaitForChild("Humanoid") :: Humanoid
	crouching = false
	slidingUntil = 0
	stamina = Movement.maxStamina()
	exhausted = false
	local h = humanoid :: Humanoid
	h.WalkSpeed = Config.WALK_SPEED
	h.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping and not lastJumpState then
			stamina = math.max(0, stamina - 4)
		end
		lastJumpState = new == Enum.HumanoidStateType.Jumping
	end)
end

function Movement.start()
	ContextActionService:BindAction("CitySprint", onSprint, true, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL3)
	ContextActionService:SetTitle("CitySprint", "Sprint")
	ContextActionService:SetPosition("CitySprint", UDim2.new(1, -170, 1, -150))
	ContextActionService:BindAction("CityCrouch", onCrouch, true, Enum.KeyCode.C, Enum.KeyCode.ButtonR3)
	ContextActionService:SetTitle("CityCrouch", "Crouch")
	ContextActionService:SetPosition("CityCrouch", UDim2.new(1, -230, 1, -95))

	remotes:WaitForChild("StaminaRefill").OnClientEvent:Connect(function()
		stamina = Movement.maxStamina()
		exhausted = false
	end)

	if player.Character then
		task.spawn(bindCharacter, player.Character)
	end
	player.CharacterAdded:Connect(bindCharacter)

	RunService.Heartbeat:Connect(function(dt)
		local h = humanoid
		if not h or h.Health <= 0 then
			return
		end
		local maxS = Movement.maxStamina()
		local moving = h.MoveDirection.Magnitude > 0.1
		local sliding = os.clock() < slidingUntil
		local canSprint = wantSprint and moving and not crouching and not exhausted and not UserInputService:GetFocusedTextBox()

		local speed
		if sliding then
			speed = Config.SLIDE_SPEED
		elseif canSprint then
			speed = Config.SPRINT_SPEED
			-- Better Speed stat makes sprinting cheaper (movement efficiency).
			local efficiency = 1 - (statValue("Speed") - 1) / 200
			stamina -= Config.SPRINT_DRAIN_PER_SEC * efficiency * dt
			if stamina <= 0 then
				stamina = 0
				exhausted = true
			end
		elseif crouching then
			speed = Config.CROUCH_SPEED
		else
			speed = Config.WALK_SPEED
		end

		if not canSprint and not sliding then
			local regen = Config.staminaRegen(statValue("Stamina"))
			if not moving then
				regen *= 1.5
			end
			stamina = math.min(maxS, stamina + regen * dt)
			if exhausted and stamina >= Config.MIN_SPRINT_STAMINA * 2 then
				exhausted = false
			end
		end
		stamina = math.min(stamina, maxS)
		h.WalkSpeed = speed
	end)
end

return Movement
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000010">
          <Properties>
            <string name="Name">HUD</string>
            <ProtectedString name="Source"><![CDATA[-- CITY GRIND: on-screen HUD. Cash, level/XP, reputation rank, stamina,
-- run tracker and notification toasts. Every number shown here is read from
-- server-owned Player attributes; the client never decides them.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))
local Movement = require(script.Parent:WaitForChild("Movement"))
local remotes = ReplicatedStorage:WaitForChild("CityGrind"):WaitForChild("Remotes")

local player = Players.LocalPlayer
local colors = UI.colors

local HUD = {}

-- Notification store shared with the phone.
HUD.notifications = {} :: { { title: string, body: string, time: number } }
HUD.notificationAdded = Instance.new("BindableEvent")
HUD.unread = 0

local gui: ScreenGui
local toastHolder: Frame
local notifySound: Sound

local function toast(title: string, body: string)
	local card = UI.new("Frame", {
		BackgroundColor3 = colors.panel,
		BackgroundTransparency = 0.08,
		Size = UDim2.new(1, 0, 0, 58),
		Parent = toastHolder,
	}, {
		UI.corner(12),
		UI.stroke(colors.accent, 1.5, 0.3),
		UI.padding(10),
		UI.label({ Text = title, Font = UI.FONT_BLACK, TextSize = 15, TextColor3 = colors.accent, Size = UDim2.new(1, 0, 0, 16) }),
		UI.label({ Text = body, TextSize = 14, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 20), TextTruncate = Enum.TextTruncate.AtEnd }),
	})
	card.Position = UDim2.fromOffset(0, -10)
	task.delay(4, function()
		local fade = TweenService:Create(card, TweenInfo.new(0.35), { BackgroundTransparency = 1 })
		for _, d in card:GetDescendants() do
			if d:IsA("TextLabel") then
				TweenService:Create(d, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
			elseif d:IsA("UIStroke") then
				TweenService:Create(d, TweenInfo.new(0.35), { Transparency = 1 }):Play()
			end
		end
		fade:Play()
		fade.Completed:Wait()
		card:Destroy()
	end)
end

function HUD.push(title: string, body: string)
	table.insert(HUD.notifications, 1, { title = title, body = body, time = os.time() })
	if #HUD.notifications > 50 then
		table.remove(HUD.notifications)
	end
	HUD.unread += 1
	toast(title, body)
	if player:GetAttribute("NotificationSounds") ~= false then
		notifySound:Play()
	end
	HUD.notificationAdded:Fire()
end

function HUD.markRead()
	HUD.unread = 0
	HUD.notificationAdded:Fire()
end

function HUD.setVisible(visible: boolean)
	gui.Enabled = visible
end

local function buildStatsCard()
	local card = UI.new("Frame", {
		Name = "Stats",
		BackgroundColor3 = colors.panel,
		BackgroundTransparency = 0.15,
		-- top-right, clear of Roblox's chat window in the top-left
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(230, 92),
		Parent = gui,
	}, { UI.corner(14), UI.padding(10) })

	local cash = UI.label({ Text = "$0", Font = UI.FONT_BLACK, TextSize = 24, TextColor3 = colors.cash, Size = UDim2.new(1, -60, 0, 26), Parent = card })
	local level = UI.new("TextLabel", {
		BackgroundColor3 = colors.xp,
		Text = "LV 1",
		Font = UI.FONT_BLACK,
		TextSize = 14,
		TextColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 2),
		Size = UDim2.fromOffset(54, 22),
		Parent = card,
	}, { UI.corner(11) })
	local _, setXP = UI.bar({ Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 8), Parent = card }, colors.xp)
	local xpText = UI.label({ Text = "0 / 100 XP", TextSize = 12, TextColor3 = colors.subtext, Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 14), Parent = card })
	local rank = UI.label({ Text = "Nobody", Font = UI.FONT_BOLD, TextSize = 14, Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 16), Parent = card })

	local shownCash: number? = nil
	local function refresh()
		local newCash = player:GetAttribute("Cash") or 0
		if not player:GetAttribute("DataLoaded") then
			return
		end
		if newCash ~= shownCash then
			if shownCash then
				local diff = newCash - shownCash
				local pop = UI.label({
					Text = (if diff > 0 then "+" else "") .. UI.formatCash(diff),
					Font = UI.FONT_BLACK,
					TextSize = 18,
					TextColor3 = if diff > 0 then colors.cash else colors.danger,
					Position = UDim2.new(1, -130, 0, 108),
					Size = UDim2.fromOffset(120, 24),
					Parent = gui,
				})
				TweenService:Create(pop, TweenInfo.new(1.2), { Position = UDim2.new(1, -130, 0, 130), TextTransparency = 1 }):Play()
				task.delay(1.3, pop.Destroy, pop)
			end
			shownCash = newCash
		end
		cash.Text = UI.formatCash(newCash)
		local lv = player:GetAttribute("Level") or 1
		level.Text = "LV " .. lv
		local xp = player:GetAttribute("XP") or 0
		local toNext = player:GetAttribute("XPToNext") or 100
		setXP(if lv >= 100 then 1 else xp / toNext)
		xpText.Text = if lv >= 100 then "MAX LEVEL" else string.format("%d / %d XP", xp, toNext)
		rank.Text = string.format("%s  ·  %d rep", player:GetAttribute("Rank") or "Nobody", player:GetAttribute("Reputation") or 0)
	end
	for _, attr in { "Cash", "Level", "XP", "XPToNext", "Rank", "Reputation", "DataLoaded" } do
		player:GetAttributeChangedSignal(attr):Connect(refresh)
	end
	refresh()
end

local function buildStaminaBar()
	local holder = UI.new("Frame", {
		Name = "Stamina",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(260, 22),
		Parent = gui,
	})
	UI.label({ Text = "STAMINA", Font = UI.FONT_BLACK, TextSize = 11, TextColor3 = colors.subtext, Size = UDim2.new(1, 0, 0, 12), Parent = holder })
	local bar, setFill = UI.bar({ Position = UDim2.fromOffset(0, 13), Size = UDim2.new(1, 0, 0, 9), Parent = holder }, colors.stamina)
	local fill = bar:FindFirstChild("Fill") :: Frame
	RunService.RenderStepped:Connect(function()
		local s, maxS, exhausted = Movement.getStamina()
		setFill(s / maxS)
		fill.BackgroundColor3 = if exhausted then colors.danger else colors.stamina
		holder.Visible = s < maxS - 0.5 or Movement.isSprinting()
	end)
end

-- Shows the run timer and highlights the next checkpoint arch.
local function buildRunTracker()
	local panel = UI.new("Frame", {
		Name = "RunTracker",
		BackgroundColor3 = colors.panel,
		BackgroundTransparency = 0.15,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(220, 54),
		Visible = false,
		Parent = gui,
	}, { UI.corner(12), UI.padding(8) })
	local timer = UI.label({ Text = "0.0s", Font = UI.FONT_BLACK, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 22), Parent = panel })
	local nextLabel = UI.label({ Text = "", TextSize = 13, TextColor3 = colors.stamina, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 14), Parent = panel })

	local highlight = Instance.new("Highlight")
	highlight.FillColor = colors.stamina
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.4
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = gui

	local function refresh()
		local nextIndex = player:GetAttribute("RunNext") or 0
		panel.Visible = nextIndex > 0
		local route = workspace:FindFirstChild("City") and workspace.City:FindFirstChild("RunRoute")
		if nextIndex == 0 or not route then
			highlight.Adornee = nil
			return
		end
		local count = #route:GetChildren()
		local target = if nextIndex > count then 1 else nextIndex
		highlight.Adornee = route:FindFirstChild("Checkpoint" .. target)
		nextLabel.Text = if target == 1 then "Head back to the FINISH" else "Next: Checkpoint " .. (target - 1)
	end
	player:GetAttributeChangedSignal("RunNext"):Connect(refresh)
	refresh()

	RunService.RenderStepped:Connect(function()
		if panel.Visible then
			local started = player:GetAttribute("RunStartedAt") or 0
			timer.Text = string.format("%.1fs", workspace:GetServerTimeNow() - started)
		end
	end)
end

local function buildControlsHint()
	if not UserInputService.KeyboardEnabled then
		return
	end
	UI.label({
		Text = "P Phone · Shift Sprint · C Crouch/Slide · E Interact · Click Shoot · Q Pass · F Steal",
		TextSize = 13,
		TextColor3 = colors.subtext,
		TextStrokeTransparency = 0.6,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -10),
		Size = UDim2.fromOffset(640, 16),
		Parent = gui,
	})
end

function HUD.start()
	gui = UI.new("ScreenGui", {
		Name = "CityGrindHUD",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	notifySound = UI.new("Sound", { SoundId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5, Parent = SoundService })

	toastHolder = UI.new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 76),
		Size = UDim2.fromOffset(320, 300),
		Parent = gui,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	buildStatsCard()
	buildStaminaBar()
	buildRunTracker()
	buildControlsHint()

	remotes:WaitForChild("Notify").OnClientEvent:Connect(function(title: string, body: string)
		if type(title) == "string" and type(body) == "string" then
			HUD.push(title, body)
		end
	end)
end

return HUD
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000011">
          <Properties>
            <string name="Name">Phone</string>
            <ProtectedString name="Source"><![CDATA[-- CITY GRIND: the phone (sections 15, 16). P / DPad-Up / on-screen button.
-- Taking it out tells the server, which puts a phone in your character's hand.
--
-- Phase 1 ships the apps that fully work today: Profile, Bank, Map (with GPS),
-- Alerts and Settings. Messages, Calls, Camera, CityTok, CityGram and the rest
-- are added to the home screen as each one is built for real (section 118).

local ContextActionService = game:GetService("ContextActionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local UI = require(script.Parent:WaitForChild("UI"))
local HUD = require(script.Parent:WaitForChild("HUD"))
local shared = ReplicatedStorage:WaitForChild("CityGrind")
local Config = require(shared:WaitForChild("Config"))
local remotes = shared:WaitForChild("Remotes")

local player = Players.LocalPlayer
local colors = UI.colors

local Phone = {}

local PHONE_W, PHONE_H = 300, 620
local SCREEN_INSET = 10
local PHONE_TOP_GAP = 120 -- keeps the phone below the HUD card

local gui: ScreenGui
local phoneFrame: Frame
local uiScale: UIScale
local screen: Frame
local wallpaperGradient: UIGradient
local pages: { [string]: { frame: Frame, open: (() -> ())? } } = {}
local currentPage = "Home"
local isOpen = false
local battery = 100
local badge: TextLabel

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function applyWallpaper()
	local index = player:GetAttribute("Wallpaper") or 1
	local wp = Config.WALLPAPERS[index] or Config.WALLPAPERS[1]
	wallpaperGradient.Color = ColorSequence.new(wp.top, wp.bottom)
end

local function applyScale()
	local camera = Workspace.CurrentCamera
	local viewportH = if camera then camera.ViewportSize.Y else 800
	local fit = math.min(1, (viewportH - 2 * PHONE_TOP_GAP) / (PHONE_H + 20))
	uiScale.Scale = fit * (player:GetAttribute("UIScale") or 1)
end

local function showPage(name: string)
	for pageName, page in pages do
		page.frame.Visible = pageName == name
	end
	currentPage = name
	local page = pages[name]
	if page and page.open then
		task.spawn(page.open)
	end
end

-- Builds an app page with a header and scrolling content list.
local function appPage(name: string, title: string): (Frame, ScrollingFrame)
	local frame = UI.new("Frame", {
		Name = name,
		BackgroundColor3 = Color3.fromRGB(14, 14, 20),
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = screen,
	})
	local header = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 0, 40),
		Parent = frame,
	})
	local back = UI.button({
		Text = "‹ Home",
		TextSize = 15,
		BackgroundTransparency = 1,
		TextColor3 = colors.xp,
		Position = UDim2.fromOffset(8, 4),
		Size = UDim2.fromOffset(70, 32),
		Parent = header,
	})
	back.Activated:Connect(function()
		showPage("Home")
	end)
	UI.label({
		Text = title,
		Font = UI.FONT_BLACK,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = header,
	})
	local content = UI.new("ScrollingFrame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 76),
		Size = UDim2.new(1, 0, 1, -104),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = frame,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
		UI.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 12) }),
	})
	pages[name] = { frame = frame }
	return frame, content
end

local function clear(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local function card(parent: Instance, height: number, order: number): Frame
	return UI.new("Frame", {
		BackgroundColor3 = colors.panelLight,
		Size = UDim2.new(1, -20, 0, height),
		LayoutOrder = order,
		Parent = parent,
	}, { UI.corner(14), UI.padding(12) })
end

local function fetchProfile()
	local ok, result = pcall(function()
		return remotes.GetProfile:InvokeServer()
	end)
	return if ok then result else nil
end

---------------------------------------------------------------------------
-- Profile app
---------------------------------------------------------------------------
local function buildProfile()
	local _, content = appPage("Profile", "Profile")
	pages.Profile.open = function()
		clear(content)
		local data = fetchProfile()
		if not data then
			UI.label({ Text = "Profile is still loading...", TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 30), Parent = content })
			return
		end
		local top = card(content, 120, 1)
		local avatar = UI.new("ImageLabel", { BackgroundColor3 = colors.panel, Size = UDim2.fromOffset(72, 72), Parent = top }, { UI.corner(36) })
		task.spawn(function()
			local ok, image = pcall(function()
				return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
			end)
			if ok then
				avatar.Image = image
			end
		end)
		UI.label({ Text = player.DisplayName:upper(), Font = UI.FONT_BLACK, TextSize = 20, Position = UDim2.fromOffset(84, 2), Size = UDim2.new(1, -84, 0, 22), TextTruncate = Enum.TextTruncate.AtEnd, Parent = top })
		UI.label({ Text = "LEVEL " .. data.level, Font = UI.FONT_BOLD, TextSize = 14, TextColor3 = colors.xp, Position = UDim2.fromOffset(84, 26), Size = UDim2.new(1, -84, 0, 16), Parent = top })
		UI.label({ Text = data.rank:upper(), Font = UI.FONT_BOLD, TextSize = 14, TextColor3 = colors.accent, Position = UDim2.fromOffset(84, 44), Size = UDim2.new(1, -84, 0, 16), Parent = top })
		local _, setXP = UI.bar({ Position = UDim2.fromOffset(0, 82), Size = UDim2.new(1, 0, 0, 8), Parent = top }, colors.xp)
		setXP(data.xp / data.xpToNext)
		UI.label({ Text = string.format("%d / %d XP to level %d", data.xp, data.xpToNext, data.level + 1), TextSize = 12, TextColor3 = colors.subtext, Position = UDim2.fromOffset(0, 92), Size = UDim2.new(1, 0, 0, 14), Parent = top })

		local numbers = card(content, 66, 2)
		local entries = {
			{ "Reputation", tostring(data.reputation) },
			{ "Fame", tostring(data.fame) },
			{ "Runs", tostring(data.runsCompleted) },
			{ "Best Run", if data.bestRunSeconds > 0 then string.format("%.1fs", data.bestRunSeconds) else "—" },
		}
		for i, entry in entries do
			local x = (i - 1) / #entries
			UI.label({ Text = entry[2], Font = UI.FONT_BLACK, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromScale(x, 0), Size = UDim2.new(1 / #entries, 0, 0, 22), Parent = numbers })
			UI.label({ Text = entry[1], TextSize = 11, TextColor3 = colors.subtext, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(x, 0, 0, 24), Size = UDim2.new(1 / #entries, 0, 0, 14), Parent = numbers })
		end

		local bb = data.basketball or {}
		local hoops = card(content, 66, 3)
		local bbEntries = {
			{ "W - L", string.format("%d-%d", bb.wins or 0, bb.losses or 0) },
			{ "Points", tostring(bb.points or 0) },
			{ "3PT", tostring(bb.threes or 0) },
			{ "Dunks", tostring(bb.dunks or 0) },
		}
		for i, entry in bbEntries do
			local x = (i - 1) / #bbEntries
			UI.label({ Text = entry[2], Font = UI.FONT_BLACK, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromScale(x, 0), Size = UDim2.new(1 / #bbEntries, 0, 0, 22), Parent = hoops })
			UI.label({ Text = entry[1], TextSize = 11, TextColor3 = colors.subtext, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(x, 0, 0, 24), Size = UDim2.new(1 / #bbEntries, 0, 0, 14), Parent = hoops })
		end

		local stats = card(content, 30 + #Config.STATS * 24, 4)
		UI.label({ Text = "ATTRIBUTES", Font = UI.FONT_BLACK, TextSize = 13, TextColor3 = colors.subtext, Size = UDim2.new(1, 0, 0, 16), Parent = stats })
		for i, stat in Config.STATS do
			local y = 22 + (i - 1) * 24
			local value = data.stats[stat] or 1
			UI.label({ Text = stat:gsub("(%l)(%u)", "%1 %2"), TextSize = 13, Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(100, 18), Parent = stats })
			local _, setStat = UI.bar({ Position = UDim2.fromOffset(104, y + 5), Size = UDim2.new(1, -140, 0, 8), Parent = stats }, colors.accent)
			setStat(value / 99)
			UI.label({ Text = tostring(value), Font = UI.FONT_BOLD, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, y), Size = UDim2.fromOffset(30, 18), Parent = stats })
		end
	end
end

---------------------------------------------------------------------------
-- Bank app
---------------------------------------------------------------------------
local function buildBank()
	local _, content = appPage("Bank", "City Bank")
	pages.Bank.open = function()
		clear(content)
		local data = fetchProfile()
		if not data then
			return
		end
		local balance = card(content, 86, 1)
		balance.BackgroundColor3 = Color3.fromRGB(20, 70, 50)
		UI.label({ Text = "BALANCE", Font = UI.FONT_BLACK, TextSize = 12, TextColor3 = Color3.fromRGB(170, 230, 190), Size = UDim2.new(1, 0, 0, 14), Parent = balance })
		UI.label({ Text = UI.formatCash(data.cash), Font = UI.FONT_BLACK, TextSize = 32, TextColor3 = colors.cash, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 36), Parent = balance })

		local income, expenses = 0, 0
		for _, t in data.transactions do
			if t.amount > 0 then
				income += t.amount
			else
				expenses -= t.amount
			end
		end
		local summary = card(content, 54, 2)
		UI.label({ Text = "Income", TextSize = 12, TextColor3 = colors.subtext, Size = UDim2.new(0.5, 0, 0, 14), Parent = summary })
		UI.label({ Text = UI.formatCash(income), Font = UI.FONT_BOLD, TextSize = 16, TextColor3 = colors.cash, Position = UDim2.fromOffset(0, 14), Size = UDim2.new(0.5, 0, 0, 18), Parent = summary })
		UI.label({ Text = "Expenses", TextSize = 12, TextColor3 = colors.subtext, Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0.5, 0, 0, 14), Parent = summary })
		UI.label({ Text = UI.formatCash(expenses), Font = UI.FONT_BOLD, TextSize = 16, TextColor3 = colors.danger, Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.new(0.5, 0, 0, 18), Parent = summary })

		UI.label({ Text = "RECENT TRANSACTIONS", Font = UI.FONT_BLACK, TextSize = 12, TextColor3 = colors.subtext, Size = UDim2.new(1, -20, 0, 16), LayoutOrder = 3, Parent = content })
		for i, t in data.transactions do
			local row = card(content, 46, 3 + i)
			UI.label({ Text = t.label, Font = UI.FONT_BOLD, TextSize = 14, Size = UDim2.new(1, -80, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
			UI.label({ Text = UI.timeAgo(t.t), TextSize = 11, TextColor3 = colors.subtext, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, -80, 0, 14), Parent = row })
			UI.label({
				Text = (if t.amount > 0 then "+" else "") .. UI.formatCash(t.amount),
				Font = UI.FONT_BOLD,
				TextSize = 15,
				TextColor3 = if t.amount > 0 then colors.cash else colors.danger,
				TextXAlignment = Enum.TextXAlignment.Right,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 4),
				Size = UDim2.fromOffset(80, 18),
				Parent = row,
			})
		end
	end
end

---------------------------------------------------------------------------
-- Map app with GPS (section 38)
---------------------------------------------------------------------------
local gps: { target: Vector3, name: string, beam: Beam, a0: Attachment, a1: Attachment, marker: BasePart }? = nil

local function clearGPS()
	if gps then
		gps.beam:Destroy()
		gps.a0:Destroy()
		gps.marker:Destroy()
		gps = nil
	end
end

local function setGPS(name: string, target: Vector3)
	clearGPS()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local marker = UI.new("Part", {
		Name = "GPSMarker",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.one,
		Position = target + Vector3.new(0, 2, 0),
		Parent = Workspace,
	})
	local a1 = UI.new("Attachment", { Parent = marker })
	local a0 = UI.new("Attachment", { Position = Vector3.new(0, -2.5, 0), Parent = root })
	local beam = UI.new("Beam", {
		Attachment0 = a0,
		Attachment1 = a1,
		Color = ColorSequence.new(Color3.fromRGB(80, 200, 255)),
		Transparency = NumberSequence.new(0.2),
		Width0 = 1.2,
		Width1 = 1.2,
		FaceCamera = true,
		LightEmission = 1,
		Segments = 1,
		Parent = marker,
	})
	local billboard = UI.new("BillboardGui", { Size = UDim2.fromOffset(200, 50), StudsOffset = Vector3.new(0, 8, 0), AlwaysOnTop = true, LightInfluence = 0, Parent = marker })
	local label = UI.label({ Name = "Text", Text = name, Font = UI.FONT_BLACK, TextSize = 18, TextStrokeTransparency = 0.3, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = billboard })
	gps = { target = target, name = name, beam = beam, a0 = a0, a1 = a1, marker = marker }
	HUD.push("GPS SET", "Follow the blue line to " .. name .. ".")

	task.spawn(function()
		local myGps = gps
		while gps == myGps do
			local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r then
				if a0.Parent ~= r then
					a0.Parent = r -- respawned
				end
				local dist = (Vector3.new(r.Position.X, 0, r.Position.Z) - Vector3.new(target.X, 0, target.Z)).Magnitude
				label.Text = string.format("%s  ·  %dm", name, math.floor(dist / 3.57)) -- ~3.57 studs per metre
				if dist < 14 then
					clearGPS()
					HUD.push("ARRIVED", "You made it to " .. name .. ".")
					return
				end
			end
			task.wait(0.2)
		end
	end)
end

local function buildMap()
	local _, content = appPage("Map", "Map")
	local MAP_W = PHONE_W - 2 * SCREEN_INSET - 20
	local WORLD_X, WORLD_Z = 600, 460
	local scale = MAP_W / WORLD_X
	local MAP_H = math.floor(WORLD_Z * scale)

	local canvas = UI.new("Frame", {
		Name = "Canvas",
		BackgroundColor3 = Color3.fromRGB(70, 120, 60),
		ClipsDescendants = true,
		Size = UDim2.fromOffset(MAP_W, MAP_H),
		LayoutOrder = 1,
		Parent = content,
	}, { UI.corner(12) })

	local function toMap(pos: Vector3): UDim2
		return UDim2.fromOffset((pos.X + WORLD_X / 2) * scale, (pos.Z + WORLD_Z / 2) * scale)
	end

	local function rect(cf: CFrame, size: Vector3, color: Color3, z: number)
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = color,
			Position = toMap(cf.Position),
			Size = UDim2.fromOffset(math.max(2, size.X * scale), math.max(2, size.Z * scale)),
			ZIndex = z,
			Parent = canvas,
		})
	end

	local arrow = UI.label({
		Text = "▲",
		Font = UI.FONT_BLACK,
		TextSize = 14,
		TextColor3 = Color3.fromRGB(80, 200, 255),
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		ZIndex = 10,
		Parent = canvas,
	})

	local drawn = false
	local function drawCity()
		local city = Workspace:FindFirstChild("City")
		if drawn or not city then
			return
		end
		drawn = true
		for _, d in city:GetDescendants() do
			if d:IsA("BasePart") then
				if d.Name == "MainRoad" or d.Name == "CrossRoad" then
					rect(d.CFrame, d.Size, Color3.fromRGB(50, 50, 55), 2)
				elseif d.Name == "Sidewalk" then
					rect(d.CFrame, d.Size, Color3.fromRGB(170, 170, 165), 2)
				elseif d.Name == "Body" and d.Parent and d.Parent.Parent and d.Parent.Parent.Name == "Buildings" then
					rect(d.CFrame, d.Size, Color3.fromRGB(200, 190, 175), 3)
				elseif d.Name == "CourtFloor" then
					rect(d.CFrame, d.Size, Color3.fromRGB(40, 90, 150), 3)
				elseif d.Name == "Lot" then
					rect(d.CFrame, d.Size, Color3.fromRGB(60, 60, 66), 2)
				end
			end
		end
	end

	local listStart = 2
	pages.Map.open = function()
		drawCity()
		for _, child in content:GetChildren() do
			if child:IsA("GuiObject") and child ~= canvas then
				child:Destroy()
			end
		end
		for _, child in canvas:GetChildren() do
			if child.Name == "Dot" then
				child:Destroy()
			end
		end
		local city = Workspace:FindFirstChild("City")
		local points = city and city:FindFirstChild("MapPoints")
		if gps then
			local clearRow = UI.button({ Text = "Clear GPS to " .. gps.name, TextSize = 13, BackgroundColor3 = colors.danger, Size = UDim2.new(1, -20, 0, 34), LayoutOrder = listStart, Parent = content })
			clearRow.Activated:Connect(function()
				clearGPS()
				showPage("Map")
			end)
		end
		if not points then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local list = points:GetChildren()
		table.sort(list, function(a, b)
			if not root then
				return a.Name < b.Name
			end
			return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude
		end)
		for i, point in list do
			local row = card(content, 44, listStart + i)
			UI.label({ Text = point.Name, Font = UI.FONT_BOLD, TextSize = 14, Size = UDim2.new(1, -70, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
			local dist = if root then math.floor((point.Position - root.Position).Magnitude / 3.57) .. "m" else ""
			UI.label({ Text = (point:GetAttribute("Category") or "Place") .. "  ·  " .. dist, TextSize = 11, TextColor3 = colors.subtext, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, -70, 0, 14), Parent = row })
			local go = UI.button({ Text = "GPS", TextSize = 13, BackgroundColor3 = Color3.fromRGB(40, 120, 220), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(56, 28), Parent = row })
			go.Activated:Connect(function()
				setGPS(point.Name, point.Position)
				showPage("Map")
			end)
			-- dot on the map
			UI.new("Frame", {
				Name = "Dot",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = colors.accent,
				Position = toMap(point.Position),
				Size = UDim2.fromOffset(6, 6),
				ZIndex = 6,
				Parent = canvas,
			}, { UI.corner(3) })
		end
	end

	RunService.RenderStepped:Connect(function()
		if not isOpen or currentPage ~= "Map" then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			arrow.Position = toMap(root.Position)
			local look = root.CFrame.LookVector
			arrow.Rotation = math.deg(math.atan2(look.X, -look.Z))
		end
	end)
end

---------------------------------------------------------------------------
-- Alerts app (section 36)
---------------------------------------------------------------------------
local function buildAlerts()
	local _, content = appPage("Alerts", "Notifications")
	pages.Alerts.open = function()
		HUD.markRead()
		clear(content)
		if #HUD.notifications == 0 then
			UI.label({ Text = "No notifications yet.", TextColor3 = colors.subtext, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 40), Parent = content })
			return
		end
		local clearAll = UI.button({ Text = "Clear all", TextSize = 13, Size = UDim2.new(1, -20, 0, 30), LayoutOrder = 0, Parent = content })
		clearAll.Activated:Connect(function()
			table.clear(HUD.notifications)
			showPage("Alerts")
		end)
		for i, n in HUD.notifications do
			local row = card(content, 58, i)
			UI.label({ Text = n.title, Font = UI.FONT_BLACK, TextSize = 13, TextColor3 = colors.accent, Size = UDim2.new(1, -60, 0, 14), Parent = row })
			UI.label({ Text = UI.timeAgo(n.time), TextSize = 11, TextColor3 = colors.subtext, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(60, 14), Parent = row })
			UI.label({ Text = n.body, TextSize = 13, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 18), Parent = row })
		end
	end
end

---------------------------------------------------------------------------
-- Settings app (section 43)
---------------------------------------------------------------------------
local function setSetting(key: string, value: any)
	local ok, accepted = pcall(function()
		return remotes.SetSetting:InvokeServer(key, value)
	end)
	if not ok or not accepted then
		HUD.push("SETTINGS", "That change didn't save. Try again in a moment.")
	end
end

local function buildSettings()
	local _, content = appPage("Settings", "Settings")
	pages.Settings.open = function()
		clear(content)

		local wp = card(content, 92, 1)
		UI.label({ Text = "WALLPAPER", Font = UI.FONT_BLACK, TextSize = 12, TextColor3 = colors.subtext, Size = UDim2.new(1, 0, 0, 14), Parent = wp })
		local current = player:GetAttribute("Wallpaper") or 1
		for i, paper in Config.WALLPAPERS do
			local swatch = UI.new("TextButton", {
				Text = "",
				BackgroundColor3 = Color3.new(1, 1, 1),
				Position = UDim2.fromOffset((i - 1) * 48, 22),
				Size = UDim2.fromOffset(40, 44),
				Parent = wp,
			}, {
				UI.corner(10),
				UI.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(paper.top, paper.bottom) }),
			})
			if i == current then
				UI.stroke(Color3.new(1, 1, 1), 2).Parent = swatch
			end
			swatch.Activated:Connect(function()
				setSetting("wallpaper", i)
				task.wait(0.2)
				showPage("Settings")
			end)
		end

		local scaleCard = card(content, 70, 2)
		UI.label({ Text = "PHONE SIZE", Font = UI.FONT_BLACK, TextSize = 12, TextColor3 = colors.subtext, Size = UDim2.new(1, 0, 0, 14), Parent = scaleCard })
		local currentScale = player:GetAttribute("UIScale") or 1
		for i, s in Config.UI_SCALES do
			local b = UI.button({
				Text = math.floor(s * 100) .. "%",
				TextSize = 12,
				BackgroundColor3 = if s == currentScale then colors.xp else colors.panel,
				Position = UDim2.fromOffset((i - 1) * 50, 22),
				Size = UDim2.fromOffset(46, 28),
				Parent = scaleCard,
			})
			b.Activated:Connect(function()
				setSetting("uiScale", s)
				task.wait(0.2)
				showPage("Settings")
			end)
		end

		local soundCard = card(content, 50, 3)
		UI.label({ Text = "Notification sounds", Font = UI.FONT_BOLD, TextSize = 14, Size = UDim2.new(1, -70, 1, 0), Parent = soundCard })
		local soundsOn = player:GetAttribute("NotificationSounds") ~= false
		local toggle = UI.button({
			Text = if soundsOn then "ON" else "OFF",
			TextSize = 13,
			BackgroundColor3 = if soundsOn then Color3.fromRGB(50, 170, 90) else colors.panel,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(56, 28),
			Parent = soundCard,
		})
		toggle.Activated:Connect(function()
			setSetting("notificationSounds", not soundsOn)
			task.wait(0.2)
			showPage("Settings")
		end)

		local about = card(content, 50, 4)
		UI.label({ Text = "CityPhone · " .. player.Name, TextSize = 12, TextColor3 = colors.subtext, Size = UDim2.new(1, 0, 0, 14), Parent = about })
		UI.label({ Text = "Settings are saved to your account.", TextSize = 12, TextColor3 = colors.subtext, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 14), Parent = about })
	end
end

---------------------------------------------------------------------------
-- Home screen (section 16)
---------------------------------------------------------------------------
local APPS = {
	{ id = "Profile", label = "Profile", icon = "👤", color = Color3.fromRGB(90, 110, 240) },
	{ id = "Bank", label = "Bank", icon = "💵", color = Color3.fromRGB(40, 160, 90) },
	{ id = "Map", label = "Map", icon = "🗺️", color = Color3.fromRGB(240, 150, 40) },
	{ id = "Alerts", label = "Alerts", icon = "🔔", color = Color3.fromRGB(230, 70, 80) },
	{ id = "Settings", label = "Settings", icon = "⚙️", color = Color3.fromRGB(55, 55, 68) },
}

local function buildHome()
	local home = UI.new("Frame", { Name = "Home", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = screen })
	pages.Home = { frame = home }

	local bigClock = UI.label({ Text = "9:00", Font = UI.FONT_BLACK, TextSize = 56, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 60), Parent = home })
	local subtitle = UI.label({ Text = "The Neighborhood", Font = UI.FONT_BOLD, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 120), Size = UDim2.new(1, 0, 0, 18), Parent = home })

	local grid = UI.new("Frame", { Name = "Apps", BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 170), Size = UDim2.new(1, -28, 1, -210), Parent = home }, {
		UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(60, 80), CellPadding = UDim2.fromOffset(6, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, app in APPS do
		local cell = UI.new("Frame", { Name = app.id, BackgroundTransparency = 1, LayoutOrder = i, Parent = grid })
		local icon = UI.new("TextButton", {
			Name = "Icon",
			Text = app.icon,
			TextSize = 28,
			Font = UI.FONT,
			BackgroundColor3 = app.color,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0),
			Size = UDim2.fromOffset(56, 56),
			AutoButtonColor = true,
			Parent = cell,
		}, { UI.corner(14) })
		UI.label({ Text = app.label, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.6, Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 14), Parent = cell })
		icon.Activated:Connect(function()
			showPage(app.id)
		end)
		if app.id == "Alerts" then
			badge = UI.new("TextLabel", {
				Text = "0",
				Font = UI.FONT_BLACK,
				TextSize = 12,
				TextColor3 = Color3.new(1, 1, 1),
				BackgroundColor3 = Color3.fromRGB(255, 50, 50),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -2, 0, 2),
				Size = UDim2.fromOffset(20, 20),
				Visible = false,
				ZIndex = 3,
				Parent = icon,
			}, { UI.corner(10) })
		end
	end

	RunService.Heartbeat:Connect(function()
		if isOpen and currentPage == "Home" then
			bigClock.Text = UI.formatClock(Lighting.ClockTime):gsub(" [AP]M", "")
			subtitle.Text = "The Neighborhood  ·  " .. (if Lighting.ClockTime >= 6 and Lighting.ClockTime < 18 then "Day" else "Night")
		end
	end)
end

local function buildStatusBar()
	local bar = UI.new("Frame", { Name = "StatusBar", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), ZIndex = 20, Parent = screen }, { UI.padding(8) })
	local clock = UI.label({ Text = "9:00 AM", Font = UI.FONT_BOLD, TextSize = 13, Size = UDim2.new(0.4, 0, 1, 0), ZIndex = 20, Parent = bar })
	local right = UI.label({ Text = "", Font = UI.FONT_BOLD, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0.6, 0, 1, 0), ZIndex = 20, Parent = bar })
	local bell = UI.label({ Text = "", Font = UI.FONT_BOLD, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0.4, 0), Size = UDim2.new(0.2, 0, 1, 0), ZIndex = 20, Parent = bar })

	local function refreshBadge()
		local unread = HUD.unread
		if badge then
			badge.Visible = unread > 0
			badge.Text = if unread > 9 then "9+" else tostring(unread)
		end
		bell.Text = if unread > 0 then "🔔" .. unread else ""
	end
	HUD.notificationAdded.Event:Connect(refreshBadge)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		-- The battery drains while the phone is out and charges while it's away.
		accumulator += dt
		if accumulator >= 1 then
			accumulator -= 1
			battery = if isOpen then math.max(5, battery - 0.08) else math.min(100, battery + 0.5)
		end
		if isOpen then
			clock.Text = UI.formatClock(Lighting.ClockTime)
			right.Text = string.format("▂▄▆█  %d%%", math.floor(battery))
		end
	end)
	refreshBadge()
end

---------------------------------------------------------------------------
-- Open / close
---------------------------------------------------------------------------
function Phone.setOpen(open: boolean)
	if open == isOpen then
		return
	end
	isOpen = open
	applyScale()
	phoneFrame.Visible = true
	local target = if open then UDim2.new(1, -24, 0.5, PHONE_TOP_GAP / 2) else UDim2.new(1, PHONE_W + 40, 0.5, PHONE_TOP_GAP / 2)
	local tween = TweenService:Create(phoneFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = target })
	tween:Play()
	if open then
		showPage(currentPage)
	else
		tween.Completed:Once(function()
			if not isOpen then
				phoneFrame.Visible = false
			end
		end)
	end
	remotes.PhoneState:FireServer(open)
end

function Phone.toggle()
	Phone.setOpen(not isOpen)
end

function Phone.start()
	gui = UI.new("ScreenGui", {
		Name = "CityGrindPhone",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
		Parent = player:WaitForChild("PlayerGui"),
	})
	phoneFrame = UI.new("Frame", {
		Name = "Phone",
		BackgroundColor3 = Color3.fromRGB(10, 10, 12),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, PHONE_W + 40, 0.5, PHONE_TOP_GAP / 2),
		Size = UDim2.fromOffset(PHONE_W, PHONE_H),
		Visible = false,
		Parent = gui,
	}, { UI.corner(42), UI.stroke(Color3.fromRGB(70, 70, 80), 2) })
	uiScale = UI.new("UIScale", { Parent = phoneFrame })

	screen = UI.new("Frame", {
		Name = "Screen",
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Position = UDim2.fromOffset(SCREEN_INSET, SCREEN_INSET),
		Size = UDim2.new(1, -2 * SCREEN_INSET, 1, -2 * SCREEN_INSET),
		Parent = phoneFrame,
	}, { UI.corner(34) })
	wallpaperGradient = UI.new("UIGradient", { Rotation = 90, Parent = screen })

	-- notch
	UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(10, 10, 12), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(90, 22), ZIndex = 30, Parent = screen }, { UI.corner(11) })

	buildStatusBar()
	buildHome()
	buildProfile()
	buildBank()
	buildMap()
	buildAlerts()
	buildSettings()
	showPage("Home")

	-- Home indicator: tap to go home, tap again on Home to put the phone away.
	local homeBar = UI.new("TextButton", {
		Name = "HomeBar",
		Text = "",
		BackgroundColor3 = Color3.fromRGB(230, 230, 235),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.fromOffset(110, 6),
		ZIndex = 30,
		Parent = screen,
	}, { UI.corner(3) })
	local hitArea = UI.new("TextButton", { Text = "", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.fromOffset(160, 26), ZIndex = 31, Parent = screen })
	local function onHome()
		if currentPage == "Home" then
			Phone.setOpen(false)
		else
			showPage("Home")
		end
	end
	homeBar.Activated:Connect(onHome)
	hitArea.Activated:Connect(onHome)

	applyWallpaper()
	player:GetAttributeChangedSignal("Wallpaper"):Connect(applyWallpaper)
	player:GetAttributeChangedSignal("UIScale"):Connect(applyScale)
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
	end
	applyScale()

	ContextActionService:BindAction("CityPhone", function(_, state)
		if state == Enum.UserInputState.Begin then
			Phone.toggle()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.P, Enum.KeyCode.DPadUp)
	ContextActionService:SetTitle("CityPhone", "Phone")
	ContextActionService:SetPosition("CityPhone", UDim2.new(1, -110, 1, -200))

	player.CharacterAdded:Connect(function()
		-- the server removed the phone prop with the old character
		if isOpen then
			task.wait(0.5)
			remotes.PhoneState:FireServer(true)
		end
	end)
end

return Phone
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000012">
          <Properties>
            <string name="Name">Basketball</string>
            <ProtectedString name="Source"><![CDATA[-- CITY GRIND: basketball controls and on-screen feedback.
-- With the ball: hold Click / R2 / Shoot to raise the shot meter and let go in
-- the green zone; Q / X / Pass passes. Without it: F / X / Steal near a ball handler.
-- The server decides whether anything goes in; this only sends button presses.

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))
local shared = ReplicatedStorage:WaitForChild("CityGrind")
local Config = require(shared:WaitForChild("Config"))
local remotes = shared:WaitForChild("Remotes")
local BallAction = remotes:WaitForChild("BallAction")
local BallFx = remotes:WaitForChild("BallFx")

local player = Players.LocalPlayer
local colors = UI.colors
local B = Config.Ball

local Basketball = {}

local gui: ScreenGui
local meter: Frame
local meterFill: Frame
local meterLabel: TextLabel
local callout: TextLabel
local scoreboard: Frame
local scoreText: TextLabel
local subText: TextLabel

local charging = false
local chargeStart = 0
local METER_FULL = B.PERFECT_RELEASE * 2 -- the green zone sits in the middle

---------------------------------------------------------------------------
-- Shot meter
---------------------------------------------------------------------------
local function buildMeter()
	meter = UI.new("Frame", {
		Name = "ShotMeter",
		BackgroundColor3 = colors.panel,
		BackgroundTransparency = 0.2,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -64),
		Size = UDim2.fromOffset(240, 18),
		Visible = false,
		Parent = gui,
	}, { UI.corner(9), UI.stroke(Color3.new(1, 1, 1), 1.5, 0.4) })
	local zoneWidth = B.PERFECT_TOLERANCE * 2 / METER_FULL
	local goodWidth = B.RELEASE_WINDOW * 0.6 / METER_FULL
	UI.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(80, 160, 80),
		BackgroundTransparency = 0.4,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(goodWidth * 2, 1),
		Parent = meter,
	})
	UI.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(90, 255, 120),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(zoneWidth, 1),
		ZIndex = 2,
		Parent = meter,
	})
	meterFill = UI.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(0, 4, 1, 8),
		ZIndex = 3,
		Parent = meter,
	}, { UI.corner(2) })
	meterLabel = UI.label({
		Text = "",
		Font = UI.FONT_BLACK,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.4,
		Position = UDim2.fromOffset(0, -24),
		Size = UDim2.new(1, 0, 0, 20),
		Parent = meter,
	})
end

local function releaseFeedback(held: number)
	local off = math.abs(held - B.PERFECT_RELEASE)
	if off <= B.PERFECT_TOLERANCE then
		meterLabel.Text = "PERFECT"
		meterLabel.TextColor3 = Color3.fromRGB(90, 255, 120)
	elseif off <= B.RELEASE_WINDOW * 0.6 then
		meterLabel.Text = if held < B.PERFECT_RELEASE then "SLIGHTLY EARLY" else "SLIGHTLY LATE"
		meterLabel.TextColor3 = colors.stamina
	else
		meterLabel.Text = if held < B.PERFECT_RELEASE then "EARLY" else "LATE"
		meterLabel.TextColor3 = colors.danger
	end
	task.delay(0.9, function()
		if not charging then
			meter.Visible = false
			meterLabel.Text = ""
		end
	end)
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------
local function onShoot(_, state: Enum.UserInputState)
	if state == Enum.UserInputState.Begin then
		charging = true
		chargeStart = os.clock()
		meter.Visible = true
		meterLabel.Text = ""
		BallAction:FireServer("ShootStart")
	elseif (state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel) and charging then
		charging = false
		releaseFeedback(os.clock() - chargeStart)
		BallAction:FireServer("ShootRelease")
	end
	return Enum.ContextActionResult.Sink
end

local function onPass(_, state: Enum.UserInputState)
	if state == Enum.UserInputState.Begin then
		BallAction:FireServer("Pass")
	end
	return Enum.ContextActionResult.Sink
end

local function onSteal(_, state: Enum.UserInputState)
	if state == Enum.UserInputState.Begin then
		BallAction:FireServer("Steal")
	end
	return Enum.ContextActionResult.Sink
end

local stealBound = false
local function refreshBindings()
	if player:GetAttribute("HasBall") then
		ContextActionService:BindAction("CityShoot", onShoot, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
		ContextActionService:SetTitle("CityShoot", "Shoot")
		ContextActionService:SetPosition("CityShoot", UDim2.new(1, -95, 1, -95))
		ContextActionService:BindAction("CityPass", onPass, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
		ContextActionService:SetTitle("CityPass", "Pass")
		ContextActionService:SetPosition("CityPass", UDim2.new(1, -170, 1, -60))
	else
		ContextActionService:UnbindAction("CityShoot")
		ContextActionService:UnbindAction("CityPass")
		if charging then
			charging = false
			meter.Visible = false
		end
	end
end

-- The steal button only appears near someone dribbling.
local function updateStealBinding()
	local want = false
	if not player:GetAttribute("HasBall") then
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			for _, other in Players:GetPlayers() do
				if other ~= player and other:GetAttribute("HasBall") then
					local r = other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
					if r and (r.Position - root.Position).Magnitude < 14 then
						want = true
						break
					end
				end
			end
		end
	end
	if want and not stealBound then
		ContextActionService:BindAction("CitySteal", onSteal, true, Enum.KeyCode.F, Enum.KeyCode.ButtonX)
		ContextActionService:SetTitle("CitySteal", "Steal")
		ContextActionService:SetPosition("CitySteal", UDim2.new(1, -170, 1, -60))
		stealBound = true
	elseif not want and stealBound then
		ContextActionService:UnbindAction("CitySteal")
		stealBound = false
	end
end

---------------------------------------------------------------------------
-- Callouts and scoreboard
---------------------------------------------------------------------------
local function showCallout(text: string)
	callout.Text = text
	callout.TextTransparency = 0
	callout.TextStrokeTransparency = 0.2
	local scale = callout:FindFirstChildOfClass("UIScale") :: UIScale
	scale.Scale = 0.6
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local token = os.clock()
	callout:SetAttribute("Token", token)
	task.delay(1.6, function()
		if callout:GetAttribute("Token") == token then
			TweenService:Create(callout, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

local function buildScoreboard()
	scoreboard = UI.new("Frame", {
		Name = "Scoreboard",
		BackgroundColor3 = colors.panel,
		BackgroundTransparency = 0.15,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(260, 56),
		Visible = false,
		Parent = gui,
	}, { UI.corner(12), UI.padding(6) })
	scoreText = UI.label({ Text = "", Font = UI.FONT_BLACK, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 26), Parent = scoreboard })
	subText = UI.label({ Text = "", TextSize = 13, TextColor3 = colors.subtext, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 16), Parent = scoreboard })
end

local function nearestActiveCourt(): Model?
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local best, bestDist = nil, 90
	for _, court in CollectionService:GetTagged("Court") do
		local state = court:GetAttribute("State")
		local center = court:GetAttribute("CourtCenter")
		if center and (state == "Playing" or state == "Countdown" or state == "Ended") then
			local d = (center - root.Position).Magnitude
			local mine = player:GetAttribute("InGame") == court:GetAttribute("DisplayName")
			if mine then
				return court
			elseif d < bestDist then
				best, bestDist = court, d
			end
		end
	end
	return best
end

local function updateScoreboard()
	local court = nearestActiveCourt()
	scoreboard.Visible = court ~= nil
	if not court then
		return
	end
	local state = court:GetAttribute("State")
	local home, away = court:GetAttribute("HomeScore") or 0, court:GetAttribute("AwayScore") or 0
	scoreText.Text = string.format("HOME  %d  –  %d  AWAY", home, away)
	if state == "Countdown" then
		subText.Text = string.format("%s starts in %d", court:GetAttribute("Mode") or "", court:GetAttribute("Countdown") or 0)
	elseif state == "Ended" then
		subText.Text = "Final"
	elseif court:GetAttribute("Overtime") then
		subText.Text = "Next bucket wins"
	else
		local t = court:GetAttribute("TimeLeft") or 0
		local team = player:GetAttribute("Team")
		subText.Text = string.format("%d:%02d%s", t // 60, t % 60, if team then "   ·   You: " .. string.upper(team) else "")
	end
end

---------------------------------------------------------------------------
-- Dunk: the server says jump, the client (which owns its character) jumps.
---------------------------------------------------------------------------
local function dunkJump(rim: Vector3)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return
	end
	local toRim = Vector3.new(rim.X - root.Position.X, 0, rim.Z - root.Position.Z)
	local stopShort = if toRim.Magnitude > 1.5 then toRim - toRim.Unit * 1.2 else Vector3.zero
	local rise = math.max(4, rim.Y - root.Position.Y - 1)
	local up = math.sqrt(2 * workspace.Gravity * rise)
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	root.AssemblyLinearVelocity = stopShort / (up / workspace.Gravity) + Vector3.new(0, up, 0)
end

function Basketball.start()
	gui = UI.new("ScreenGui", {
		Name = "CityGrindBasketball",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 3,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildMeter()
	buildScoreboard()
	callout = UI.label({
		Name = "Callout",
		Text = "",
		Font = UI.FONT_BLACK,
		TextSize = 54,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		TextStrokeColor3 = Color3.fromRGB(60, 20, 0),
		TextStrokeTransparency = 1,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.new(1, 0, 0, 70),
		Parent = gui,
	}, { UI.new("UIScale", {}) })

	player:GetAttributeChangedSignal("HasBall"):Connect(refreshBindings)
	refreshBindings()

	BallFx.OnClientEvent:Connect(function(kind: string, arg: any)
		if kind == "Callout" and type(arg) == "string" then
			showCallout(arg)
		elseif kind == "Dunk" and typeof(arg) == "Vector3" then
			dunkJump(arg)
		end
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		if charging then
			local t = (os.clock() - chargeStart) / METER_FULL
			meterFill.Position = UDim2.fromScale(math.clamp(t, 0, 1), 0.5)
		end
		accumulator += dt
		if accumulator >= 0.25 then
			accumulator = 0
			updateStealBinding()
			updateScoreboard()
		end
	end)
end

return Basketball
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>
